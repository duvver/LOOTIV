<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Turk Pokeri - LOOTIV</title>
  <link rel="stylesheet" href="/css/style.css?v=6" />
  <link rel="stylesheet" href="/css/okey101.css?v=4" />
</head>
<body class="app-body" data-user-id="<%= user.id %>">
  <header class="topbar">
    <div class="topbar-left">
      <a href="/" class="brand-logo"><img src="/images/lootivlogo.png" alt="LOOTIV" /></a>
    </div>
    <div class="topbar-right">
      <nav class="topbar-nav">
        <a href="/">Ana Sayfa</a>
      </nav>
      <div class="user-chip">
        <span class="user-name"><%= user.rumuz %></span>
        <span class="user-points"><span class="coin">&#9679;</span> <%= user.lt_balance %> LT</span>
      </div>
      <a href="/" class="btn btn-ghost btn-sm">Ana Sayfaya Don</a>
    </div>
  </header>

  <main class="poker-layout">
    <section class="poker-table">
      <div class="table-felt" id="table-felt">
        <div class="table-title">Turk Pokeri <span id="spectator-count" style="display: none; font-size: 12px; margin-left: 8px; background: rgba(59, 130, 246, 0.1); color: #1d4ed8; padding: 2px 6px; border-radius: 4px; font-weight: bold;"><span class="material-symbols-outlined" style="font-size: 12px; vertical-align: middle;">visibility</span> <span id="spectator-count-val">0</span></span></div>
        <div class="table-status" id="table-status"></div>
        <div class="table-pot" id="table-pot"></div>
        <div class="table-community" id="table-community"></div>
        <div class="table-seats" id="table-seats"></div>
        <div class="table-banner" id="table-banner"></div>
      </div>
      <div class="action-bar" id="action-bar"></div>
    </section>

    <aside class="players-panel">
      <h3 class="panel-title">Canli Oynayanlar <span id="player-count" class="panel-count">0</span></h3>
      <button type="button" class="btn btn-sm btn-outline-primary w-full mb-3" onclick="openInviteModal()">+ Davet Et</button>
      <ul id="player-list" class="player-list"></ul>
    </aside>

  </main>

  <!-- Invite Modal -->
  <div id="invite-modal" class="glass-panel" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2000; width: 400px; padding: 20px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.1);">
    <h3 style="margin-bottom: 15px; color: #fff; font-size: 1.25rem;">Oyuncu Davet Et</h3>
    <div style="max-height: 300px; overflow-y: auto;" id="invite-user-list">
      Yükleniyor...
    </div>
    <div style="text-align: right; margin-top: 15px;">
      <button class="btn btn-secondary btn-sm" onclick="document.getElementById('invite-modal').style.display='none'">Kapat</button>
    </div>
  </div>

  <script>
  window.openInviteModal = function() {
    document.getElementById('invite-modal').style.display = 'block';
    document.getElementById('invite-user-list').innerHTML = 'Yükleniyor...';
    fetch('/api/users/online')
      .then(r => r.json())
      .then(data => {
        let html = '<ul style="list-style: none; padding: 0; margin: 0;">';
        if (!data.users || data.users.length === 0) {
           html = '<p>Aktif oyuncu yok.</p>';
        } else {
          data.users.forEach(u => {
            html += `
              <li style="display:flex; justify-content:space-between; margin-bottom: 10px; background: rgba(255,255,255,0.05); padding: 8px; border-radius: 6px;">
                <span>${u.username}</span>
                <button class="btn btn-primary btn-sm" onclick="sendInvite(${u.id})">Davet Et</button>
              </li>
            `;
          });
          html += '</ul>';
        }
        document.getElementById('invite-user-list').innerHTML = html;
      })
      .catch(err => {
        document.getElementById('invite-user-list').innerHTML = 'Hata oluştu.';
      });
  };
  window.sendInvite = function(targetUserId) {
    if (typeof socket !== 'undefined' && socket) {
      socket.emit('room:invite', { targetUserId: targetUserId });
      alert('Davet gönderildi!');
    }
  };
  </script>



  <!-- ===== Sohbet paneli (surekli acik) ===== -->
  <aside class="ok1-chatpanel" id="ok1-chatpanel">
    <div class="chat-tabs">
      <button class="chat-tab active" data-channel="oyun">Oyun Lobisi <span class="badge"></span></button>
      <button class="chat-tab" data-channel="masa">Masa <span class="badge"></span></button>
      <button class="chat-tab" data-channel="sistem">Sistem Mesaji <span class="badge"></span></button>
    </div>
    <div class="chat-body">
      <div class="chat-messages" id="chat-messages" data-channel="oyun"></div>
    </div>
    <form class="chat-input-row" id="chat-form">
      <button type="button" class="btn btn-sm" onclick="document.getElementById('emote-picker').classList.remove('hidden')" style="padding: 0 8px; font-size: 1.2rem; background: transparent; border: none; cursor: pointer;">😀</button>
      <input type="text" id="chat-input" class="chat-input" placeholder="Mesajini yaz..." maxlength="500" autocomplete="off" />
      <button type="submit" class="btn btn-primary btn-sm">Gonder</button>
    </form>
  </aside>

  <!-- ===== Emote Picker Modal ===== -->
  <div id="emote-picker" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="bg-surface-container rounded-2xl p-4 shadow-xl border border-outline-variant/30 max-w-sm w-full flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <h3 class="text-primary font-bold text-lg">Emoji Gönder</h3>
        <button type="button" onclick="closeEmotePicker()" class="text-outline hover:text-on-surface">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div class="grid grid-cols-4 gap-2 mt-2">
        <button type="button" class="text-3xl hover:scale-110 transition-transform p-2 bg-surface-container-high rounded-xl" onclick="sendEmote('😀')">😀</button>
        <button type="button" class="text-3xl hover:scale-110 transition-transform p-2 bg-surface-container-high rounded-xl" onclick="sendEmote('😂')">😂</button>
        <button type="button" class="text-3xl hover:scale-110 transition-transform p-2 bg-surface-container-high rounded-xl" onclick="sendEmote('😍')">😍</button>
        <button type="button" class="text-3xl hover:scale-110 transition-transform p-2 bg-surface-container-high rounded-xl" onclick="sendEmote('😎')">😎</button>
        <button type="button" class="text-3xl hover:scale-110 transition-transform p-2 bg-surface-container-high rounded-xl" onclick="sendEmote('😭')">😭</button>
        <button type="button" class="text-3xl hover:scale-110 transition-transform p-2 bg-surface-container-high rounded-xl" onclick="sendEmote('😡')">😡</button>
        <button type="button" class="text-3xl hover:scale-110 transition-transform p-2 bg-surface-container-high rounded-xl" onclick="sendEmote('👍')">👍</button>
        <button type="button" class="text-3xl hover:scale-110 transition-transform p-2 bg-surface-container-high rounded-xl" onclick="sendEmote('👏')">👏</button>
        <button type="button" class="text-3xl hover:scale-110 transition-transform p-2 bg-surface-container-high rounded-xl" onclick="sendEmote('🎉')">🎉</button>
        <button type="button" class="text-3xl hover:scale-110 transition-transform p-2 bg-surface-container-high rounded-xl" onclick="sendEmote('💩')">💩</button>
        <button type="button" class="text-3xl hover:scale-110 transition-transform p-2 bg-surface-container-high rounded-xl" onclick="sendEmote('🔥')">🔥</button>
        <button type="button" class="text-3xl hover:scale-110 transition-transform p-2 bg-surface-container-high rounded-xl" onclick="sendEmote('💔')">💔</button>
      </div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/soundEngine.js"></script>
  <script src="/js/poker.js?v=2"></script>
  <script src="/js/notify.js?v=1"></script>
</body>
</html>
