<!DOCTYPE html>
<html class="light" lang="tr">
<head>
  <%- include('partials/theme-head', { pageTitle: 'İlan Oluştur — LOOTIV' }) %>
  <style>
    .rarity-common-bg { background: #BDC3C7; }
    .rarity-rare-bg { background: #3498DB; }
    .rarity-epic-bg { background: #9B59B6; }
    .rarity-legendary-bg { background: #EB930C; }
    .rarity-common-badge { background: rgba(189,195,199,.18); color: #7F8C8D; }
    .rarity-rare-badge { background: rgba(52,152,219,.15); color: #3498DB; }
    .rarity-epic-badge { background: rgba(155,89,182,.15); color: #9B59B6; }
    .rarity-legendary-badge { background: rgba(235,147,12,.15); color: #EB930C; }
    .rarity-common-ring { border-color: #BDC3C7; }
    .rarity-rare-ring { border-color: #3498DB; }
    .rarity-epic-ring { border-color: #9B59B6; }
    .rarity-legendary-ring { border-color: #EB930C; }
    .thumb { transition: all .2s; }
    .thumb.sel { border-color: #EB930C !important; box-shadow: 0 0 0 3px rgba(235,147,12,.25); }
    .thumb.sel .thumb-check { display: flex !important; }
    input::-webkit-outer-spin-button, input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  </style>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col">

  <%- include('partials/theme-nav', { active: 'pazar', user: user, unreadCount: typeof unreadCount !== 'undefined' ? unreadCount : 0 }) %>

  <main class="flex-grow max-w-container-max mx-auto w-full px-margin-mobile md:px-margin-desktop py-8">

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-3 bg-error-container text-on-error-container rounded-lg font-body-sm"><%= error %></div>
    <% } %>

    <% if (!items || items.length === 0) { %>
      <div class="max-w-xl mx-auto bg-white rounded-xl border border-outline-variant/30 p-12 text-center">
        <span class="material-symbols-outlined text-6xl text-outline">inventory_2</span>
        <h1 class="mt-3 font-headline-md text-headline-md text-primary">Satışa koyacak eşyan yok</h1>
        <p class="text-body-sm text-outline mt-1">Envanterin boş ya da tüm eşyaların zaten satışta. Yeni eşyalar admin panelinden (Pazar Yönetimi) verilir.</p>
        <a href="/envanter" class="inline-block mt-5 px-5 py-2.5 bg-primary text-white rounded-lg font-label-md text-label-md">Envanterime Git</a>
      </div>
    <% } else { %>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- ===== Sol: Form ===== -->
      <div class="bg-white rounded-xl border border-outline-variant/30 shadow-sm p-6 md:p-8">
        <h1 class="font-headline-lg text-headline-lg text-primary">İlan Oluştur</h1>
        <p class="text-outline font-body-md mb-6">Envanterindeki eşyayı seç, fiyatını belirle ve pazarda satışa çıkar.</p>

        <form method="POST" action="/pazar/ilan" id="ilan-form">
          <input type="hidden" name="invId" id="sel-invId" />

          <!-- EŞYA SEÇİMİ -->
          <label class="block font-label-md text-label-md text-primary uppercase tracking-wider mb-3">Eşya Seçimi</label>
          <div class="grid grid-cols-4 sm:grid-cols-5 gap-3 mb-8">
            <% items.forEach(function(item, idx){ var rl = item.rarity.toLowerCase(); %>
              <button type="button"
                      class="thumb relative aspect-square bg-surface-container-low border-2 rarity-<%= rl %>-ring rounded-lg overflow-hidden cursor-pointer"
                      data-json="<%= encodeURIComponent(JSON.stringify(item.toJSON())) %>"
                      onclick="selectThumb(this)">
                <% if (item.imageUrl) { %>
                  <div class="w-full h-full bg-cover bg-center" style="background-image:url('<%= item.imageUrl %>')"></div>
                <% } else { %>
                  <div class="w-full h-full flex items-center justify-center text-outline">
                    <span class="material-symbols-outlined text-3xl">
                      <% if (item.category === 'silah') { %>swords<% } else if (item.category === 'zirh') { %>shield<% } else if (item.category === 'belt' || item.category === 'kemer') { %>checkroom<% } else { %>inventory_2<% } %>
                    </span>
                  </div>
                <% } %>
                <span class="thumb-check absolute top-1 right-1 w-5 h-5 rounded-full bg-secondary text-white items-center justify-center hidden">
                  <span class="material-symbols-outlined text-[14px]">check</span>
                </span>
              </button>
            <% }); %>
          </div>

          <!-- SATIŞ FİYATI -->
          <label class="block font-label-md text-label-md text-primary uppercase tracking-wider mb-2" for="price-input">Satış Fiyatı (LT)</label>
          <div class="relative mb-8">
            <input name="price" id="price-input" oninput="recalc()" required min="1" step="1" type="number"
                   class="w-full bg-white border border-silver-light rounded-lg py-3.5 px-5 text-headline-md focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all"
                   placeholder="0"/>
            <span class="absolute right-5 top-1/2 -translate-y-1/2 text-secondary font-bold pointer-events-none">LT</span>
          </div>

          <!-- İLAN SÜRESİ -->
          <label class="block font-label-md text-label-md text-primary uppercase tracking-wider mb-2">İlan Süresi</label>
          <div class="grid grid-cols-3 gap-3 mb-8">
            <% var durs = [ {v:'24', l:'24 Saat'}, {v:'48', l:'48 Saat'}, {v:'168', l:'7 Gün'} ]; %>
            <% durs.forEach(function(d){ %>
              <label class="cursor-pointer">
                <input type="radio" name="duration" value="<%= d.v %>" class="peer sr-only" <%= d.v === '48' ? 'checked' : '' %> />
                <div class="text-center py-3 rounded-lg border border-silver-light font-label-md text-label-md text-primary peer-checked:bg-primary peer-checked:text-white peer-checked:border-primary transition-all"><%= d.l %></div>
              </label>
            <% }); %>
          </div>

          <button type="submit" class="w-full bg-secondary hover:opacity-90 text-white py-4 rounded-lg font-headline-md text-headline-md transition-all active:scale-95 shadow-lg flex items-center justify-center gap-2">
            <span class="material-symbols-outlined">publish</span> İlanı Yayınla
          </button>
        </form>
      </div>

      <!-- ===== Sağ: Önizleme ===== -->
      <div class="space-y-4">
        <div class="bg-white rounded-xl border border-outline-variant/30 shadow-sm overflow-hidden">
          <!-- Görsel + nadirlik rozeti -->
          <div id="pv-imgwrap" class="relative h-56 rarity-legendary-bg flex items-center justify-center">
            <span id="pv-rarity" class="absolute top-4 left-4 px-3 py-1 rounded-full bg-white font-label-sm text-label-sm uppercase tracking-wider">—</span>
            <img id="pv-img" class="max-h-full max-w-full object-contain hidden" />
            <span id="pv-icon" class="material-symbols-outlined text-white text-7xl">inventory_2</span>
          </div>
          <div class="p-6">
            <div class="flex justify-between items-start gap-3 mb-1">
              <h2 id="pv-name" class="font-headline-md text-headline-md text-primary">Eşya seç</h2>
              <span id="pv-price" class="font-headline-md text-headline-md text-secondary whitespace-nowrap">0 LT</span>
            </div>
            <p id="pv-cat" class="text-outline font-body-sm mb-4">—</p>

            <div id="pv-attrs" class="flex gap-6 mb-4"></div>

            <div class="bg-surface-container-low rounded-lg p-4 space-y-3">
              <div class="flex justify-between items-center">
                <span class="text-outline font-body-md">Satış Fiyatı</span>
                <span id="pv-listing" class="font-label-md text-label-md">0 LT</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-outline font-body-md">Sistem Komisyonu (%<%= commission %>)</span>
                <span id="pv-fee" class="font-label-md text-label-md text-error">-0 LT</span>
              </div>
              <div class="flex justify-between items-center pt-3 border-t border-outline-variant/30">
                <span class="font-headline-md text-headline-md text-primary">Net Kazanç</span>
                <span id="pv-net" class="font-headline-md text-headline-md text-success-green">0 LT</span>
              </div>
            </div>
          </div>
        </div>

        <div class="flex gap-3 p-4 bg-surface-container rounded-lg">
          <span class="material-symbols-outlined text-primary scale-90">info</span>
          <p class="text-[12px] leading-tight text-outline">
            İlan yayınlandıktan sonra eşyan satılana ya da süresi dolana kadar envanterinden geçici olarak kaldırılır. İstediğinde ilanı iptal edip geri alabilirsin.
          </p>
        </div>
      </div>
    </div>

    <% } %>
  </main>

  <%- include('partials/theme-foot', { user: user }) %>

  <script>
    var comPercent = <%= typeof commission !== 'undefined' ? commission : 1 %>;
    var rarityMap = { common:'Yaygın', rare:'Nadir', epic:'Epik', legendary:'Efsanevi' };
    var catMap = { silah:'Silah', zirh:'Zırh', koleksiyon:'Koleksiyon', karakter:'Karakter', diger:'Diğer' };
    var current = null;

    function fmt(n){ return (Number(n)||0).toLocaleString('tr-TR'); }

    function selectThumb(el) {
      document.querySelectorAll('.thumb').forEach(function(t){ t.classList.remove('sel'); });
      el.classList.add('sel');
      current = JSON.parse(decodeURIComponent(el.getAttribute('data-json')));
      document.getElementById('sel-invId').value = current.inventoryId;

      var rl = (current.rarity || 'common').toLowerCase();

      // Gorsel alani + nadirlik arkaplani
      var wrap = document.getElementById('pv-imgwrap');
      wrap.className = 'relative h-56 rarity-' + rl + '-bg flex items-center justify-center';
      var img = document.getElementById('pv-img');
      var icon = document.getElementById('pv-icon');
      if (current.imageUrl) {
        img.src = current.imageUrl; img.classList.remove('hidden'); icon.classList.add('hidden');
      } else {
        img.classList.add('hidden'); icon.classList.remove('hidden');
        if (current.category === 'silah') icon.textContent = 'swords';
        else if (current.category === 'zirh') icon.textContent = 'shield';
        else if (current.category === 'belt' || current.category === 'kemer') icon.textContent = 'checkroom';
        else icon.textContent = 'inventory_2';
      }

      var rarityEl = document.getElementById('pv-rarity');
      rarityEl.textContent = rarityMap[rl] || current.rarity;
      rarityEl.className = 'absolute top-4 left-4 px-3 py-1 rounded-full font-label-sm text-label-sm uppercase tracking-wider bg-white rarity-' + rl + '-badge';

      document.getElementById('pv-name').textContent = current.displayName;
      document.getElementById('pv-cat').textContent = catMap[current.category] || current.category;

      // Nitelikler
      var attrsEl = document.getElementById('pv-attrs');
      attrsEl.innerHTML = '';
      var attrs = current.attributes || {};
      if (Object.keys(attrs).length === 0) {
        attrsEl.innerHTML = '<span class="text-body-sm text-outline">Özel bir niteliği yok.</span>';
      } else {
        for (var key in attrs) {
          attrsEl.innerHTML += '<div><p class="text-[10px] uppercase tracking-wider text-outline">' + key.replace('_',' ') + '</p><p class="font-headline-md text-headline-md text-primary">' + attrs[key] + '</p></div>';
        }
      }
      recalc();
    }

    function recalc() {
      var price = Math.trunc(Number(document.getElementById('price-input').value)) || 0;
      var fee = Math.ceil(price * (comPercent / 100));
      var net = Math.max(0, price - fee);
      document.getElementById('pv-price').textContent = fmt(price) + ' LT';
      document.getElementById('pv-listing').textContent = fmt(price) + ' LT';
      document.getElementById('pv-fee').textContent = '-' + fmt(fee) + ' LT';
      document.getElementById('pv-net').textContent = fmt(net) + ' LT';
    }

    // Ilk esyayi otomatik sec
    (function(){
      var first = document.querySelector('.thumb');
      if (first) selectThumb(first);
    })();
  </script>
</body>
</html>
