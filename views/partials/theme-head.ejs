<style>
  body { font-family: 'Source Sans 3', sans-serif; background-color: #f7fafb; }
  .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
  .game-card-hover { transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s ease; }
  .game-card-hover:hover { transform: translateY(-8px); box-shadow: 0px 12px 24px rgba(52,73,94,0.12); }
  .category-card { transition: all 0.3s cubic-bezier(0.4,0,0.2,1); }
  .bento-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 16px; }

  /* ---- Duyuru bildirim toast'i (notify.js icin, acik tema) ---- */
  .announce-toast-wrap { position: fixed; top: 80px; right: 18px; z-index: 1000; display: flex; flex-direction: column; gap: 10px; max-width: 340px; }
  .announce-toast { background: #ffffff; border: 1px solid #c3c7cd; border-left: 4px solid #EB930C; border-radius: 12px; padding: 14px 16px; box-shadow: 0 12px 34px rgba(52,73,94,0.18); cursor: pointer; opacity: 0; transform: translateX(20px); transition: opacity .28s ease, transform .28s ease; }
  .announce-toast.visible { opacity: 1; transform: translateX(0); }
  .announce-toast-title { font-family: 'Hanken Grotesk'; font-size: 14px; font-weight: 800; color: #1d3246; margin-bottom: 4px; }
  .announce-toast-body { font-size: 13px; color: #43474c; line-height: 1.5; margin-bottom: 8px; }
  .announce-toast-link { font-size: 12.5px; font-weight: 700; color: #EB930C; }
  .announce-toast-link:hover { text-decoration: underline; }
  @media (max-width: 560px) { .announce-toast-wrap { left: 12px; right: 12px; max-width: none; } }

  /* ---- Tema sohbet baloncuklari ---- */
  .theme-chat-msg { font-size: 14px; line-height: 1.5; }
  .theme-chat-msg .who { font-weight: 700; color: #1d3246; }
  .theme-chat-msg.sys .txt { color: #74777d; font-style: italic; }
</style>
