    </div>

    <!-- ========== SAYFA: Günün Sorusu ========== -->
    <div class="adm-page" id="page-dailyq">
      <!-- Mevcut soru önizlemesi -->
      <div class="adm-section">
        <div class="adm-section-head" onclick="toggleSection(this)">
          <span class="adm-section-head-icon">&#128065;</span>
          <div class="adm-section-head-text">
            <div class="adm-section-head-title">Mevcut Soru</div>
            <div class="adm-section-head-sub">Simdi aktif olan soru</div>
          </div>
          <span class="adm-section-badge <%= dailyQuestion.active ? '' : 'red' %>"><%= dailyQuestion.active ? 'Aktif' : 'Pasif' %></span>
          <span class="adm-chevron">&#9660;</span>
        </div>
        <div class="adm-section-body">
          <div style="padding:16px 20px;">
            <% if (dailyQuestion.question_text) { %>
              <p style="font-size:15px;color:#e6edf3;margin-bottom:12px;font-weight:600;"><%= dailyQuestion.question_text %></p>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <% ['A','B','C','D'].forEach(function(opt){ var txt = dailyQuestion['option_' + opt.toLowerCase()]; if(txt){ %>
                  <div style="background:#0d1117;border:1px solid <%- dailyQuestion.correct_option === opt ? 'var(--green-bright)' : '#30363d' %>;border-radius:8px;padding:10px 14px;font-size:13px;color:<%- dailyQuestion.correct_option === opt ? 'var(--green-bright)' : '#c9d1d9' %>;">
                    <strong><%= opt %>.</strong> <%= txt %>
                  </div>
                <% } }); %>
              </div>
              <p style="margin-top:10px;font-size:12px;color:#8b949e;">Odul: <strong style="color:#e3b341;"><%= dailyQuestion.reward_lt %> LT</strong> &nbsp;|&nbsp; Versiyon: <strong>#<%= dailyQuestion.version %></strong></p>
            <% } else { %>
              <p style="color:#8b949e;font-size:13px;">Henuz soru eklenmemis.</p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Soru düzenleme -->
      <div class="adm-section open">
        <div class="adm-section-head" onclick="toggleSection(this)">
          <span class="adm-section-head-icon">&#9998;</span>
          <div class="adm-section-head-text">
            <div class="adm-section-head-title">Soruyu Duzenle / Yeni Soru Ekle</div>
            <div class="adm-section-head-sub">Kaydedilince versiyon artar, herkes tekrar cevaplayabilir</div>
          </div>
          <span class="adm-chevron">&#9660;</span>
        </div>
        <div class="adm-section-body">
          <form method="POST" action="/admin/gunun-sorusu" class="adm-form">
            <div class="adm-field">
              <label>Soru Metni</label>
              <input type="text" name="questionText" value="<%= dailyQuestion.question_text || '' %>" required placeholder="Soru metnini gir..." />
            </div>
            <div class="adm-form-row adm-form-row-2">
              <div class="adm-field">
                <label>A Secenegi</label>
                <input type="text" name="optionA" value="<%= dailyQuestion.option_a || '' %>" placeholder="A secenegi" />
              </div>
              <div class="adm-field">
                <label>B Secenegi</label>
                <input type="text" name="optionB" value="<%= dailyQuestion.option_b || '' %>" placeholder="B secenegi" />
              </div>
              <div class="adm-field">
                <label>C Secenegi</label>
                <input type="text" name="optionC" value="<%= dailyQuestion.option_c || '' %>" placeholder="C secenegi" />
              </div>
              <div class="adm-field">
                <label>D Secenegi</label>
                <input type="text" name="optionD" value="<%= dailyQuestion.option_d || '' %>" placeholder="D secenegi" />
              </div>
            </div>
            <div class="adm-form-row adm-form-row-3">
              <div class="adm-field">
                <label>Dogru Secenek</label>
                <select name="correctOption">
                  <% ['A','B','C','D'].forEach(function(opt) { %>
                    <option value="<%= opt %>" <%= dailyQuestion.correct_option === opt ? 'selected' : '' %>><%= opt %></option>
                  <% }); %>
                </select>
              </div>
              <div class="adm-field">
                <label>Odul (LT)</label>
                <input type="number" name="rewardLt" value="<%= dailyQuestion.reward_lt %>" min="0" />
              </div>
              <div class="adm-field">
                <label>&nbsp;</label>
                <label class="adm-checkbox-row">
                  <input type="checkbox" name="active" <%= dailyQuestion.active ? 'checked' : '' %> />
                  <span>Aktif (lobide goster)</span>
                </label>
              </div>
            </div>
            <div class="adm-form-footer">
              <button type="submit" class="adm-save-btn">&#10003; Kaydet</button>
              <span class="adm-note">Yeni versiyon olusturulur — onceki cevaplar etkilenmez.</span>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ========== SAYFA: Kazı Kazan ========== -->
    <div class="adm-page" id="page-scratch">
      <div class="adm-section open">
        <div class="adm-section-head" onclick="toggleSection(this)">
          <span class="adm-section-head-icon">&#127920;</span>
          <div class="adm-section-head-text">
            <div class="adm-section-head-title">Kazi Kazan Ayarlari</div>
            <div class="adm-section-head-sub">Odul havuzu ve aktiflik durumu</div>
          </div>
          <span class="adm-section-badge <%= scratchConfig.active ? '' : 'red' %>"><%= scratchConfig.active ? 'Aktif' : 'Pasif' %></span>
          <span class="adm-chevron">&#9660;</span>
        </div>
        <div class="adm-section-body">
          <form method="POST" action="/admin/kazikazan" class="adm-form">
            <div class="adm-field">
              <label>Ödül Havuzu</label>
              <input type="text" name="prizes" value="<%= scratchConfig.prizes %>" placeholder="0,50,100,250,500" />
              <span style="font-size:12px;color:#8b949e;margin-top:4px;">Virgülle ayrılmış LT miktarları. 0 = boş çıktı anlamına gelir. Havuzdan rastgele biri seçilir.</span>
            </div>
            <div class="adm-field" style="margin-top:1rem;">
              <label>Giriş Ücreti (LT)</label>
              <input type="number" name="entry_fee" value="<%= scratchConfig.entry_fee || 50 %>" min="0" />
            </div>
            <div class="adm-field" style="margin-top:1rem;">
              <label>Günlük Oynama Limiti</label>
              <input type="number" name="daily_limit" value="<%= scratchConfig.daily_limit || 1 %>" min="1" />
            </div>
            <div style="margin-top:1rem;">
              <label class="adm-checkbox-row">
                <input type="checkbox" name="active" <%= scratchConfig.active ? 'checked' : '' %> />
                <span>Aktif (lobide göster)</span>
              </label>
            </div>
            <div class="adm-form-footer">
              <button type="submit" class="adm-save-btn">&#10003; Kaydet</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ========== SAYFA: Günlük Görevler ========== -->
    <div class="adm-page" id="page-dailytasks">
      <div class="adm-section open">
        <div class="adm-section-head" onclick="toggleSection(this)">
          <span class="adm-section-head-icon">&#128221;</span>
          <div class="adm-section-head-text">
            <div class="adm-section-head-title">Günlük Görevler</div>
            <div class="adm-section-head-sub">Görev ekle, düzenle veya sil</div>
          </div>
          <span class="adm-chevron">&#9660;</span>
        </div>
        <div class="adm-section-body">
          <form method="POST" action="/admin/daily_tasks" class="adm-form" style="margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--adm-border);">
            <input type="hidden" name="action_type" value="add" />
            <h3 style="margin-bottom: 1rem; color: var(--adm-text);">Yeni Görev Ekle</h3>
            <div class="adm-field">
              <label>Görev Başlığı</label>
              <input type="text" name="title" placeholder="Örn: Okey'de 5 el kazan" required />
            </div>
            <div class="adm-field" style="margin-top: 1rem;">
              <label>Görev Tipi</label>
              <select name="task_type" class="adm-select" required>
                <option value="play_okey_hands">Okey El Oyna</option>
                <option value="win_okey_hands">Okey El Kazan</option>
                <option value="play_poker_hands">Poker El Oyna</option>
                <option value="win_poker_hands">Poker El Kazan</option>
                <option value="spend_lt">LT Harca</option>
                <option value="play_scratchcard">Kazı Kazan Oyna</option>
                <option value="daily_login">Günlük Giriş Yap</option>
              </select>
            </div>
            <div class="adm-field" style="margin-top: 1rem;">
              <label>Hedef Miktar</label>
              <input type="number" name="target_count" value="1" min="1" required />
            </div>
            <div class="adm-field" style="margin-top: 1rem;">
              <label>Ödül (LT)</label>
              <input type="number" name="reward_lt" value="100" min="0" required />
            </div>
            <div style="margin-top: 1rem; display: flex; gap: 2rem;">
              <label class="adm-checkbox-row">
                <input type="checkbox" name="is_fixed" />
                <span>Sabit (Her gün yenilenir, silinmez)</span>
              </label>
              <label class="adm-checkbox-row">
                <input type="checkbox" name="active" checked />
                <span>Aktif</span>
              </label>
            </div>
            <div class="adm-form-footer">
              <button type="submit" class="adm-save-btn">&#10133; Görev Ekle</button>
            </div>
          </form>

          <table class="adm-table">
            <thead>
              <tr>
                <th>Başlık</th>
                <th>Tip / Hedef</th>
                <th>Ödül</th>
                <th>Durum</th>
                <th>İşlem</th>
              </tr>
            </thead>
            <tbody>
              <% if (dailyTasks && dailyTasks.length > 0) { %>
                <% dailyTasks.forEach(t => { %>
                  <tr>
                    <td><%= t.title %></td>
                    <td><%= t.task_type %> (<%= t.target_count %>)</td>
                    <td><%= t.reward_lt %> LT</td>
                    <td>
                      <% if (t.is_fixed) { %><span class="adm-tag adm-tag-blue">Sabit</span><% } %>
                      <% if (t.active) { %><span class="adm-tag adm-tag-green">Aktif</span><% } else { %><span class="adm-tag adm-tag-red">Pasif</span><% } %>
                    </td>
                    <td>
                      <form method="POST" action="/admin/daily_tasks" style="display:inline-block;" onsubmit="return confirm('Bu görevi silmek istediğinize emin misiniz?');">
                        <input type="hidden" name="action_type" value="delete" />
                        <input type="hidden" name="task_id" value="<%= t.id %>" />
                        <button type="submit" class="adm-btn red sm">Sil</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" style="text-align: center; color: #8b949e;">Henüz günlük görev eklenmemiş.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ========== SAYFA: VIP Yönetimi ========== -->
    <div class="adm-page" id="page-vip">
      <div class="adm-section open">
        <div class="adm-section-head" onclick="toggleSection(this)">
          <span class="adm-section-head-icon">&#128081;</span>
          <div class="adm-section-head-text">
            <div class="adm-section-head-title">VIP Uye Yonetimi</div>
            <div class="adm-section-head-sub">Uyelere VIP atama ve kaldir</div>
          </div>
          <span class="adm-section-badge adm-section-badge amber"><%= stats.vip_users %> VIP uye</span>
          <span class="adm-chevron">&#9660;</span>
        </div>
        <div class="adm-section-body">
          <div class="adm-table-scroll">
            <table class="adm-table">
              <thead>
                <tr>
                  <th>Rumuz</th>
                  <th>Mevcut VIP</th>
                  <th>Bitis Tarihi</th>
                  <th>VIP Degistir</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(function(u) { %>
                  <tr>
                    <td><strong style="color:#e6edf3;"><%= u.rumuz %></strong></td>
                    <td>
                      <% if (u.vip_tier > 0) { %>
                        <span class="adm-tag adm-tag-purple">VIP <%= u.vip_tier %></span>
                      <% } else { %>
                        <span class="adm-tag adm-tag-gray">Yok</span>
                      <% } %>
                    </td>
                    <td style="color:#8b949e;font-size:12px;">
                      <%= u.vip_expires_at ? new Date(u.vip_expires_at).toLocaleDateString('tr-TR') : '—' %>
                    </td>
                    <td>
                      <form method="POST" action="/admin/users/<%= u.id %>/vip" style="display:inline-flex;align-items:center;gap:6px;">
                        <select name="tier" class="adm-select">
                          <option value="0" <%= u.vip_tier == 0 ? 'selected' : '' %>>VIP Yok</option>
                          <% Object.keys(vipPlans).forEach(function(tier) { %>
                            <option value="<%= tier %>" <%= u.vip_tier == tier ? 'selected' : '' %>><%= vipPlans[tier].label %></option>
                          <% }); %>
                        </select>
                        <button type="submit" class="adm-btn green">Uygula</button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- VIP plan bilgileri -->
      <div class="adm-section">
        <div class="adm-section-head" onclick="toggleSection(this)">
          <span class="adm-section-head-icon">&#128196;</span>
          <div class="adm-section-head-text">
            <div class="adm-section-head-title">VIP Plan Detaylari</div>
            <div class="adm-section-head-sub">Anlık ve haftalık LT bonuslari</div>
          </div>
          <span class="adm-chevron">&#9660;</span>
        </div>
        <div class="adm-section-body">
          <div class="adm-table-scroll">
            <table class="adm-table">
              <thead>
                <tr><th>Plan</th><th>Sure</th><th>Anlik LT</th><th>Haftalik LT</th></tr>
              </thead>
              <tbody>
                <% Object.keys(vipPlans).forEach(function(tier){ var p = vipPlans[tier]; %>
                  <tr>
                    <td><span class="adm-tag adm-tag-purple">VIP <%= tier %></span></td>
                    <td><%= p.months %> ay</td>
                    <td class="adm-pos">+<%= p.instant.toLocaleString('tr-TR') %> LT</td>
                    <td class="adm-pos">+<%= p.weekly.toLocaleString('tr-TR') %> LT / hafta</td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== SAYFA: Pazar Yonetimi ========== -->
    <div class="adm-page" id="page-market">
      <%
        var mCatLabels = { silah:'Silahlar', zirh:'Zirlar', koleksiyon:'Koleksiyonluklar', karakter:'Karakterler', diger:'Diger' };
        var mRarLabels = { common:'Siradan', rare:'Nadir', epic:'Epik', legendary:'Efsanevi' };
      %>

      <!-- Komisyon ayari -->
      <div class="adm-section open">
        <div class="adm-section-head" onclick="toggleSection(this)">
          <span class="adm-section-head-icon">&#128181;</span>
          <div class="adm-section-head-text">
            <div class="adm-section-head-title">Komisyon Orani</div>
            <div class="adm-section-head-sub">Her satistan kesilen yuzde</div>
          </div>
          <span class="adm-section-badge amber">%<%= marketConfig.commission_percent %></span>
          <span class="adm-chevron">&#9660;</span>
        </div>
        <div class="adm-section-body">
          <form method="POST" action="/admin/market/commission" class="adm-form">
            <div class="adm-form-row adm-form-row-3">
              <div class="adm-field">
                <label>Komisyon (%)</label>
                <input type="number" name="commission" min="0" max="100" value="<%= marketConfig.commission_percent %>" required />
              </div>
              <div class="adm-field"></div>
              <div class="adm-field">
                <label>&nbsp;</label>
                <button type="submit" class="adm-save-btn">&#10003; Kaydet</button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Yeni esya (katalog) olustur -->
      <div class="adm-section open">
        <div class="adm-section-head" onclick="toggleSection(this)">
          <span class="adm-section-head-icon">&#10133;</span>
          <div class="adm-section-head-text">
            <div class="adm-section-head-title">Yeni Esya Olustur</div>
            <div class="adm-section-head-sub">Katalogda esya tanimla (kategori, nadirlik, gorsel)</div>
          </div>
          <span class="adm-chevron">&#9660;</span>
        </div>
        <div class="adm-section-body">
          <form method="POST" action="/admin/market/item" class="adm-form">
            <div class="adm-form-row adm-form-row-2">
              <div class="adm-field">
                <label>Esya Adi</label>
                <input type="text" name="name" maxlength="120" required placeholder="Orn: Efsanevi Kilic" />
              </div>
              <div class="adm-field">
                <label>Gorsel URL (istege bagli)</label>
                <input type="text" name="image_url" placeholder="https://..." />
              </div>
              <div class="adm-field">
                <label>Kategori</label>
                <select name="category">
                  <% categories.forEach(function(c){ %>
                    <option value="<%= c %>"><%= mCatLabels[c] || c %></option>
                  <% }); %>
                </select>
              </div>
              <div class="adm-field">
                <label>Nadirlik</label>
                <select name="rarity">
                  <% rarities.forEach(function(r){ %>
                    <option value="<%= r %>"><%= mRarLabels[r] || r %></option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="adm-form-footer">
              <button type="submit" class="adm-save-btn">&#10133; Esya Ekle</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Katalog listesi -->
      <div class="adm-section open">
        <div class="adm-section-head" onclick="toggleSection(this)">
          <span class="adm-section-head-icon">&#128230;</span>
          <div class="adm-section-head-text">
            <div class="adm-section-head-title">Esya Katalogu</div>
            <div class="adm-section-head-sub">Tanimli esyalar</div>
          </div>
          <span class="adm-section-badge"><%= catalogItems.length %> esya</span>
          <span class="adm-chevron">&#9660;</span>
        </div>
        <div class="adm-section-body">
          <div class="adm-table-scroll">
            <table class="adm-table">
              <thead>
                <tr><th>Ad</th><th>Kategori</th><th>Nadirlik</th><th>Islem</th></tr>
              </thead>
              <tbody>
                <% if (!catalogItems.length) { %>
                  <tr><td colspan="4" class="adm-empty">Henuz esya tanimlanmamis.</td></tr>
                <% } %>
                <% catalogItems.forEach(function(it){ %>
                  <tr>
                    <td><strong style="color:#e6edf3;"><%= it.name %></strong></td>
                    <td><%= mCatLabels[it.category] || it.category %></td>
                    <td><span class="adm-tag adm-tag-purple"><%= mRarLabels[it.rarity] || it.rarity %></span></td>
                    <td>
                      <form method="POST" action="/admin/market/item/<%= it.id %>/sil" onsubmit="return confirm('Bu esya katalogdan silinsin mi?');">
                        <button type="submit" class="adm-btn red">&#128465; Sil</button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Kullaniciya esya ver -->
      <div class="adm-section open">
        <div class="adm-section-head" onclick="toggleSection(this)">
          <span class="adm-section-head-icon">&#127873;</span>
          <div class="adm-section-head-text">
            <div class="adm-section-head-title">Kullaniciya Esya Ver</div>
            <div class="adm-section-head-sub">Secilen esya kullanicinin envanterine eklenir</div>
          </div>
          <span class="adm-chevron">&#9660;</span>
        </div>
        <div class="adm-section-body">
          <form method="POST" action="/admin/market/grant" class="adm-form">
            <div class="adm-form-row adm-form-row-3">
              <div class="adm-field">
                <label>Kullanici Rumuzu</label>
                <input type="text" name="rumuz" required placeholder="Rumuz" />
              </div>
              <div class="adm-field">
                <label>Esya</label>
                <select name="catalog_id" required>
                  <% if (!catalogItems.length) { %>
                    <option value="">Once esya olustur</option>
                  <% } %>
                  <% catalogItems.forEach(function(it){ %>
                    <option value="<%= it.id %>"><%= it.name %> (<%= mRarLabels[it.rarity] || it.rarity %>)</option>
                  <% }); %>
                </select>
              </div>
              <div class="adm-field">
                <label>&nbsp;</label>
                <button type="submit" class="adm-save-btn">&#127873; Ver</button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Aktif ilanlar -->
      <div class="adm-section open">
        <div class="adm-section-head" onclick="toggleSection(this)">
          <span class="adm-section-head-icon">&#127991;</span>
          <div class="adm-section-head-text">
            <div class="adm-section-head-title">Aktif Ilanlar</div>
            <div class="adm-section-head-sub">Pazardaki tum aktif ilanlar - kaldirabilirsin</div>
          </div>
          <span class="adm-section-badge"><%= activeListings.length %> ilan</span>
          <span class="adm-chevron">&#9660;</span>
        </div>
        <div class="adm-section-body">
          <div class="adm-table-scroll">
            <table class="adm-table">
              <thead>
                <tr><th>Baslik</th><th>Satici</th><th>Kategori</th><th>Fiyat</th><th>Islem</th></tr>
              </thead>
              <tbody>
                <% if (!activeListings.length) { %>
                  <tr><td colspan="5" class="adm-empty">Aktif ilan yok.</td></tr>
                <% } %>
                <% activeListings.forEach(function(l){ %>
                  <tr>
                    <td><strong style="color:#e6edf3;"><%= l.title %></strong></td>
                    <td style="color:#8b949e;"><%= l.seller_rumuz %></td>
                    <td><%= mCatLabels[l.category] || l.category %></td>
                    <td><strong style="color:#e3b341;"><%= l.price_lt.toLocaleString('tr-TR') %> LT</strong></td>
                    <td>
                      <form method="POST" action="/admin/market/listing/<%= l.id %>/sil" onsubmit="return confirm('Ilan kaldirilsin mi? Esya saticinin envanterine geri doner.');">
                        <button type="submit" class="adm-btn red">&#128465; Kaldir</button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /adm-content -->

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/notify.js?v=1"></script>
  <script>
    /* ======= Sayfa geçiş sistemi ======= */
    var PAGE_LABELS = {
      dashboard:     'Genel Bakış',
      users:         'Üyeler',
      gamelogs:      'Oyun Logları',
      announcements: 'Duyurular',
      dailytasks:    'Günlük Görevler',
      dailyq:        'Günün Sorusu',
      scratch:       'Kazı Kazan',
      vip:           'VIP Yönetimi',
      market:        'Pazar Yönetimi'
    };

    function showPage(id, linkEl) {
      document.querySelectorAll('.adm-page').forEach(function(p){ p.classList.remove('visible'); });
      var target = document.getElementById('page-' + id);
      if (target) target.classList.add('visible');
      document.querySelectorAll('.adm-nav-link').forEach(function(l){ l.classList.remove('active'); });
      if (linkEl) linkEl.classList.add('active');
      var lbl = document.getElementById('adm-page-label');
      if (lbl) lbl.textContent = PAGE_LABELS[id] || id;
      // URL hash güncelle (sayfa yenilenince konumu koru)
      history.replaceState(null, '', '#' + id);
      // Mobilde menüyü kapat
      document.getElementById('adm-sidebar').classList.remove('open');
    }

    /* Hash'ten başlangıç sayfasını belirle */
    (function(){
      var hash = location.hash.replace('#','');
      if (hash && document.getElementById('page-' + hash)) {
        var link = document.querySelector('[data-page=' + hash + ']');
        showPage(hash, link);
      }
    })();

    /* ======= Accordion aç/kapat ======= */
    function toggleSection(headEl) {
      var section = headEl.closest('.adm-section');
      section.classList.toggle('open');
    }

    /* ======= Mobil sidebar ======= */
    function toggleSidebar() {
      document.getElementById('adm-sidebar').classList.toggle('open');
    }

    // Sidebar dışına tıklayınca kapat
    document.addEventListener('click', function(e) {
      var sb = document.getElementById('adm-sidebar');
      var hm = document.getElementById('adm-hamburger');
      if (sb && !sb.contains(e.target) && hm && !hm.contains(e.target)) {
        sb.classList.remove('open');
      }
    });

    /* ======= Üye arama / filtreleme ======= */
    function filterUsers() {
      var q = document.getElementById('user-search').value.toLowerCase();
      var rows = document.querySelectorAll('.user-row');
      var visible = 0;
      rows.forEach(function(r) {
        var match = r.dataset.rumuz.includes(q) || r.dataset.email.includes(q);
        r.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      var c = document.getElementById('user-count');
      if (c) c.textContent = visible + ' / ' + rows.length;
    }

    /* ======= Log arama ======= */
    function filterLogs() {
      var q = document.getElementById('log-search').value.toLowerCase();
      var rows = document.querySelectorAll('.log-row');
      var visible = 0;
      rows.forEach(function(r) {
        var match = r.dataset.rumuz.includes(q);
        r.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      var c = document.getElementById('log-count');
      if (c) c.textContent = visible + ' / ' + rows.length;
    }
  </script>
</body>
</html>
