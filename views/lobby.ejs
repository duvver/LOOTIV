<!DOCTYPE html>
<html class="light" lang="tr">
<head>
  <%- include('partials/theme-head', { pageTitle: 'LOOTIV — Oyun Merkezi' }) %>
</head>
<body class="bg-background text-on-surface">

  <%- include('partials/theme-nav', { active: 'home', user: user, unreadCount: typeof unreadCount !== 'undefined' ? unreadCount : 0 }) %>

  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-8">

    <!-- ===== Misafir karsilama (sadece giris yapmamis) ===== -->
    <% if (!user) { %>
      <section class="mb-10 bg-gradient-to-r from-primary to-primary-container rounded-2xl p-8 md:p-10 text-white flex flex-col md:flex-row md:items-center justify-between gap-6 shadow-md">
        <div>
          <h1 class="font-display-lg text-headline-lg md:text-display-lg mb-2">Türk oyunlarının yeni adresi.</h1>
        </div>
        <div class="flex gap-3 shrink-0">
          <a href="/register" class="px-6 py-3 bg-secondary text-white rounded-lg font-label-md text-label-md hover:opacity-90 transition-all whitespace-nowrap">Hemen Üye Ol</a>
          <a href="/giris" class="px-6 py-3 bg-white/10 border border-white/30 text-white rounded-lg font-label-md text-label-md hover:bg-white/20 transition-all whitespace-nowrap">Giriş Yap</a>
        </div>
      </section>
    <% } %>

    <!-- ===== Kompakt kategori + gorevler ===== -->
    <section class="grid grid-cols-12 gap-6 mb-12">
      <div class="col-span-12 <%= user ? 'md:col-span-8' : '' %> flex flex-col gap-6">
        <div class="bg-white rounded-xl shadow-sm border border-outline-variant p-4 pb-8 relative flex items-center justify-around">
            
        <a class="flex flex-col items-center gap-2 group hover:text-primary transition-colors" href="/karakter-sec">
          <div class="w-12 h-12 bg-primary-fixed-dim text-primary rounded-lg flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-all">
            <span class="material-symbols-outlined text-2xl">account_circle</span>
          </div>
          <span class="font-label-md text-label-md">Karakter</span>
        </a>
        <div class="w-px h-12 bg-outline-variant"></div>
        <a class="flex flex-col items-center gap-2 group hover:text-primary transition-colors" href="/envanter">
          <div class="w-12 h-12 bg-primary-fixed-dim text-primary rounded-lg flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-all">
            <span class="material-symbols-outlined text-2xl">inventory_2</span>
          </div>
          <span class="font-label-md text-label-md">Envanter</span>
        </a>
        <div class="w-px h-12 bg-outline-variant"></div>
        <a class="flex flex-col items-center gap-2 group hover:text-primary transition-colors" href="/pazar">
          <div class="w-12 h-12 bg-primary-fixed-dim text-primary rounded-lg flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-all">
            <span class="material-symbols-outlined text-2xl">storefront</span>
          </div>
          <span class="font-label-md text-label-md">Pazar</span>
        </a>
        <div class="w-px h-12 bg-outline-variant"></div>
        <button onclick="openVipModal()" class="flex flex-col items-center gap-2 group hover:text-yellow-600 transition-colors focus:outline-none">
          <div class="w-12 h-12 bg-yellow-100 text-yellow-600 rounded-lg flex items-center justify-center group-hover:bg-yellow-500 group-hover:text-white transition-all shadow-sm border border-yellow-200">
            <span class="material-symbols-outlined text-2xl">workspace_premium</span>
          </div>
          <span class="font-label-md text-label-md font-bold text-yellow-600 group-hover:text-yellow-700">VIP Satın Al</span>
        </button>
      
          <% if (user) { %>
            <div class="absolute bottom-2 left-4 flex items-center gap-1.5 text-[11px] text-outline font-medium bg-transparent">
              <span class="w-1.5 h-1.5 bg-success-green rounded-full animate-pulse"></span>
              Sitede <span class="global-online-count font-bold text-primary">...</span> aktif oyuncu var
            </div>
          <% } %>
        </div>

        <section id="oyunlar">
      <div class="flex justify-between items-end mb-8">
        <div>
          <h2 class="font-headline-lg text-headline-lg text-primary">Popüler Oyunlar</h2>
          <p class="font-body-md text-body-md text-outline">Masaya otur, sohbet et, LT kazan.</p>
        </div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
        <!-- 101 Okey (aktif) -->
        <a href="/oyun/okey101" class="game-card-hover bg-white rounded-xl overflow-hidden shadow-sm flex flex-col">
          <div class="relative h-48 group/img bg-primary-container">
            <img class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD3IRAWvK-mmHFBucdVV8OGEhScS0BOJ99qSDXdr_Nzm_waM-8xPrE9CP1fDpZZjyZFWb6Cjzg2nwYCs2V4xgC9EOIFxcxDe-UEkoOORCcb9BF54_p_yZ2gUivWPNynr7znJLFfT3eKdGsN8H11v6xKTMSpAV2WqnuB3K8bsmFd-YhJCjLC-nJhaYbsEzuXAc7ArGlf149Ac3U6TS6XePsaSfD5DYE0ScGf-S2gQAMsjM4gJc1tE4W7" alt="101 Okey" />
            <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center justify-center">
              <span class="px-6 py-2 bg-secondary text-white rounded-full font-label-md text-label-md">Oyna</span>
            </div>
          </div>
          <div class="p-4">
            <h3 class="font-headline-md text-headline-md text-primary mb-1">101 Okey</h3>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-success-green"></span>
              <span class="font-label-sm text-label-sm text-outline"><span class="game-online-count-okey101">...</span> Oyuncu Aktif</span>
            </div>
          </div>
        </a>

        <!-- Canak Okey (aktif) -->
        <a href="/oyun/okey" class="game-card-hover bg-white rounded-xl overflow-hidden shadow-sm flex flex-col">
          <div class="relative h-48 group/img bg-primary-container">
            <img class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCUibdf8xrKOQOY4NOcs-qteEgQzDt0b5p4HNLPQUl1hc270TKSdKM_qN6zsGyd-vJv4Imn50YwfFw5glfM4kcjPeK7UApFaCqa0hd5JWZU0lZ_JPJWJ6Or_pD5xXR4keo1bgVdhqqc0m7wDXMC17x69SzZhqou9VQcd8krUKCpp3Bc57Czn1Mi8w97DrELGAKJD9qwH5_x_I9vKUKM4Tws1GSQGA7HOwsY0LAG6NQy3oGo2_hk_7Ny" alt="Canak Okey" />
            <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center justify-center">
              <span class="px-6 py-2 bg-secondary text-white rounded-full font-label-md text-label-md">Oyna</span>
            </div>
          </div>
          <div class="p-4">
            <h3 class="font-headline-md text-headline-md text-primary mb-1">Çanak Okey</h3>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-success-green"></span>
              <span class="font-label-sm text-label-sm text-outline"><span class="game-online-count-okey">...</span> Oyuncu Aktif</span>
            </div>
          </div>
        </a>

        <!-- Turk Pokeri (aktif) -->
        <a href="/oyun/poker" class="game-card-hover bg-white rounded-xl overflow-hidden shadow-sm flex flex-col">
          <div class="relative h-48 group/img bg-primary-container">
            <img class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBvi8X7sIDnTAIHHxVuCDVevoAY51kJdmnWtYtuiRkT8yOSjr8RP9dDHm9JM9szJJosFjk0QZFgfS909RSgmh4EQqKhGM8MHEkqwXmda4Ivxi5Dzi44EDjlkwHlra4HWsP6WYfy-S0pkMSvwZ4fvSbwBrCmRtpsgNQdcEEP6kwHEQug3BdeewVVfJzhvqCXsRnjWnprXKvrN7d4tAtwUC_oI3ut2zWN2RmsFr-zaQ7xczc3ZIdxL_0z" alt="Turk Pokeri" />
            <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center justify-center">
              <span class="px-6 py-2 bg-secondary text-white rounded-full font-label-md text-label-md">Oyna</span>
            </div>
          </div>
          <div class="p-4">
            <h3 class="font-headline-md text-headline-md text-primary mb-1">Türk Pokeri</h3>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-success-green"></span>
              <span class="font-label-sm text-label-sm text-outline"><span class="game-online-count-poker">...</span> Oyuncu Aktif</span>
            </div>
          </div>
        </a>

        <!-- Tavla (yakinda) -->
        <div class="bg-white rounded-xl overflow-hidden shadow-sm flex flex-col opacity-70">
          <div class="relative h-48 grayscale">
            <img class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAktesiC0-SshV64nmg72I7_7v0Z0wwnnvV0iwwMSLVN2JfF_AoojbkGH7cdPpTo3eo3vmhlJWHMwIMuIa1cnBPgrOQeFo7Z7ondxf_ycb7nJLIKJt8DCi9IIDjqnWSwRSw-Fera3qKd_fzP9DrNMIbg0pmdlYvMQsLExi36jOTADBDglAppDn6gljHc77dQIahCGR5ZY9UhVAivHDc_t9wLjE3p2lBMcX7t5K51XTlQmuJpGJe9M8X" alt="Tavla" />
            <div class="absolute inset-0 flex items-center justify-center"><span class="px-4 py-1 bg-slate-dark/80 text-white rounded-full font-label-sm text-label-sm">Yakında</span></div>
          </div>
          <div class="p-4">
            <h3 class="font-headline-md text-headline-md text-primary mb-1">Tavla</h3>
            <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-outline"></span><span class="font-label-sm text-label-sm text-outline">Yakında</span></div>
          </div>
        </div>

        <!-- King (yakinda) -->
        <div class="bg-white rounded-xl overflow-hidden shadow-sm flex flex-col opacity-70">
          <div class="relative h-48 grayscale">
            <img class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCy4ehnAgPBuk5MvtZMDzrEvvFRUtjMbS4WbBQwLx3t2mxKnCjkWO5kYeFlxmhI1viUt8o1hpT28NE2o7ysGQIzgy5iJOZBs1KQsEmGMw9aU2HVX807ua3M5Z89HB21kqq28B3pLuEf9EhflCEhgh0VLa--vkKRwUMzWP7AqtGiyNXGTEg34U0L-IIqxTWw2qLUZf7R6HfMqyfdxXtMG7T6-GnZVONwwefVMwcwIRGS0defvvKlVyof" alt="King" />
            <div class="absolute inset-0 flex items-center justify-center"><span class="px-4 py-1 bg-slate-dark/80 text-white rounded-full font-label-sm text-label-sm">Yakında</span></div>
          </div>
          <div class="p-4">
            <h3 class="font-headline-md text-headline-md text-primary mb-1">King</h3>
            <div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-outline"></span><span class="font-label-sm text-label-sm text-outline">Yakında</span></div>
          </div>
        </div>
      </div>
    </section>
      
        <!-- Duyurular -->
        <div class="bg-white rounded-xl p-5 shadow-sm flex flex-col justify-between w-full mt-2 border border-outline-variant">
          <div>
          <h2 class="font-headline-md text-headline-sm text-primary mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-xl text-secondary">campaign</span> Duyurular
          </h2>
          <div class="space-y-3">
            <% if (!announcements || !announcements.length) { %>
              <p class="font-body-sm text-outline">Henüz duyuru yok.</p>
            <% } else { %>
              <% announcements.forEach(function(a) { %>
                <div class="flex items-start gap-3 p-3 bg-surface-container-low rounded-lg border border-primary/5">
                  <div>
                    <div class="flex items-center gap-2 mb-0.5">
                      <span class="font-label-sm text-primary font-semibold"><%= a.title %></span>
                      <span class="text-[10px] text-outline"><%= new Date(a.created_at).toLocaleString('tr-TR') %></span>
                    </div>
                    <p class="font-body-sm text-on-surface leading-snug"><%= a.content.length > 120 ? a.content.slice(0,120) + '...' : a.content %></p>
                  </div>
                </div>
              <% }); %>
            <% } %>
          </div>
        </div>
        <a href="/duyurular" class="mt-4 text-center py-2 bg-surface-container text-primary font-label-md text-label-sm rounded-lg hover:bg-primary hover:text-white transition-colors">Tüm Duyuruları Gör</a>
        </div>
        
      </div>
      <!-- Gorevler<!-- Gorevler / Gunluk oduller (sadece giris yapmis) -->
      <% if (user) { %>
        <div class="col-span-12 md:col-span-4 flex flex-col gap-4">
          
          <div class="bg-white rounded-xl shadow-sm border border-outline-variant p-4 flex flex-col justify-between w-full h-auto" >
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-headline-md text-label-md text-primary flex items-center gap-2">
                <span class="material-symbols-outlined text-xl">task_alt</span> Günlük Görevler
              </h3>
            </div>
            
            <div class="flex flex-col gap-3 w-full pr-1">
              <% if (dailyTasks && dailyTasks.length > 0) { %>
                <% dailyTasks.forEach(task => { %>
                  <% 
                    let progress = task.progress || 0;
                    let isCompleted = task.is_completed || false;
                    let percent = Math.min(100, (progress / task.target_count) * 100);
                  %>
                  <div class="border border-outline-variant rounded-lg p-2 flex flex-col gap-1 <%= isCompleted ? 'bg-success-green/10' : '' %>">
                    <div class="flex justify-between items-center">
                      <span class="text-label-sm font-medium text-primary line-clamp-1" title="<%= task.title %>"><%= task.title %></span>
                      <span class="text-label-sm font-bold text-secondary"><%= task.reward_lt %> LT</span>
                    </div>
                    <div class="flex items-center justify-between text-xs text-outline">
                      <span><%= progress %> / <%= task.target_count %></span>
                      <% if (isCompleted) { %>
                        <span class="text-success-green material-symbols-outlined text-sm">check_circle</span>
                      <% } %>
                    </div>
                    <% if (!isCompleted) { %>
                      <div class="w-full bg-surface-container rounded-full h-1 mt-1">
                        <div class="bg-primary h-1 rounded-full" style="width: <%= percent %>%"></div>
                      </div>
                    <% } %>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="text-center text-outline text-sm my-4">Şu an aktif görev yok.</div>
              <% } %>
            </div>
          </div>

          <!-- Bloglar -->
          <div class="bg-white rounded-xl shadow-sm border border-outline-variant p-4 flex flex-col justify-between w-full h-auto mt-2">
            <h3 class="font-headline-md text-label-md text-primary flex items-center gap-2 mb-3">
              <span class="material-symbols-outlined text-xl">article</span> Son Blog Yazıları
            </h3>
            <div class="flex flex-col gap-3 w-full pr-1">
              <% if (typeof blogs !== 'undefined' && blogs && blogs.length > 0) { %>
                <% blogs.slice(0, 3).forEach(b => { %>
                  <a href="/bloglar/<%= b.id %>" class="block border border-outline-variant rounded-lg p-4 hover:bg-surface-container-low transition-colors">
                    <div class="font-label-md text-[#0ea5e9] font-bold line-clamp-1 mb-2 text-[16px]"><%= b.title %></div>
                    <div class="text-[13px] mb-3">
                      <span class="font-bold text-on-surface"><%= b.rumuz %></span> 
                      <span class="text-outline">( <%= new Date(b.created_at).toLocaleDateString('tr-TR', { day: '2-digit', month: 'long' }) %> )</span>
                    </div>
                    <div class="text-[13px] text-outline line-clamp-2 leading-relaxed mb-2">
                      <%= b.content.replace(/<[^>]*>?/gm, '').length > 80 ? b.content.replace(/<[^>]*>?/gm, '').slice(0, 80) + '...' : b.content.replace(/<[^>]*>?/gm, '') %>
                    </div>
                    <div class="text-[13px] text-[#f59e0b] font-bold mb-4">
                      Devamını oku >
                    </div>
                    <div class="flex justify-end gap-4 text-outline font-bold text-[13px]">
                      <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">visibility</span>
                        <span><%= b.view_count || 0 %></span>
                      </div>
                      <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">chat_bubble</span>
                        <span><%= b.comment_count || 0 %></span>
                      </div>
                    </div>
                  </a>
                <% }) %>
              <% } else { %>
                <div class="text-center text-outline text-sm my-4">Henüz blog yok.</div>
              <% } %>
            </div>
          </div>

        </div>
      <% } %>
    </section>

    <!-- ===== Populer Oyunlar (herkes gorur) ===== -->
    

    

    <% if (user) { %>

      <!-- Şans Oyunları: Günün Sorusu + Kazı Kazan -->
      <section id="sans-oyunlari" class="mt-16">
        <h2 class="font-headline-lg text-headline-lg text-primary mb-6">Şans Oyunları</h2>
        <div class="grid grid-cols-12 gap-6">
          <!-- Gunun Sorusu -->
          <% if (dailyQuestion && dailyQuestion.active) { %>
            <div class="col-span-12 md:col-span-8 bg-white rounded-xl shadow-sm border border-outline-variant p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-headline-md text-headline-md text-primary flex items-center gap-2"><span class="material-symbols-outlined text-secondary">quiz</span> Günün Sorusu</h3>
                <span class="px-3 py-1 bg-secondary-container/40 text-on-secondary-container rounded-full font-label-md text-label-sm">+<%= dailyQuestion.reward_lt %> LT</span>
              </div>
              <p class="font-body-lg text-body-md text-on-surface mb-4"><%= dailyQuestion.question_text %></p>
              <% if (dailyAnswer) { %>
                <div class="p-4 rounded-lg <%= dailyAnswer.is_correct ? 'bg-success-green/10 text-success-green' : 'bg-error-container text-on-error-container' %> font-body-sm">
                  Cevabın: <strong><%= dailyAnswer.selected_option %></strong> — <%= dailyAnswer.is_correct ? 'Doğru! LT hesabına eklendi.' : 'Yanlış, yarın tekrar dene.' %>
                </div>
              <% } else { %>
                <form method="POST" action="/gunun-sorusu/cevapla" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <% ['A','B','C','D'].forEach(function(opt) { var t = dailyQuestion['option_' + opt.toLowerCase()]; if (t) { %>
                    <button type="submit" name="option" value="<%= opt %>" class="flex items-center gap-3 p-3 border border-silver-light rounded-lg hover:border-primary hover:bg-surface-container-low transition-all text-left">
                      <span class="w-7 h-7 flex items-center justify-center bg-primary-fixed-dim text-primary rounded-full font-label-md text-label-sm"><%= opt %></span>
                      <span class="font-body-md"><%= t %></span>
                    </button>
                  <% } }); %>
                </form>
              <% } %>
            </div>
          <% } %>

          <!-- Kazı Kazan -->
          <% if (scratchConfig && scratchConfig.active) { %>
            <div class="col-span-12 <%= (dailyQuestion && dailyQuestion.active) ? 'md:col-span-4' : 'md:col-span-6' %> bg-white rounded-xl shadow-sm border border-outline-variant p-6 flex flex-col">
              <h3 class="font-headline-md text-headline-md text-primary flex items-center gap-2 mb-4"><span class="material-symbols-outlined text-tertiary">redeem</span> Kazı Kazan</h3>
              <div class="mb-2 font-body-sm text-outline flex justify-between">
                <span>Giriş Ücreti: <%= scratchConfig.entry_fee || 0 %> LT</span>
                <span>Limit: <%= scratchCountToday %> / <%= scratchConfig.daily_limit || 1 %></span>
              </div>
              <% if (scratchCountToday >= (scratchConfig.daily_limit || 1)) { %>
                <div class="flex-1 flex flex-col items-center justify-center bg-surface-container-low rounded-lg p-6 text-center">
                  <span class="font-headline-md text-headline-md text-primary">Günlük limite ulaştın</span>
                  <p class="font-body-sm text-outline mt-2">Yarın tekrar gel.</p>
                </div>
              <% } else if (user.lt < (scratchConfig.entry_fee || 0)) { %>
                <div class="flex-1 flex flex-col items-center justify-center bg-error-container/20 rounded-lg p-6 text-center">
                  <span class="font-headline-md text-headline-md text-error">Yetersiz LT</span>
                  <p class="font-body-sm text-outline mt-2">Oynamak için <%= scratchConfig.entry_fee %> LT gerekli.</p>
                </div>
              <% } else { %>
                <div class="flex-1 flex">
                  <a href="/kazikazan" class="flex-1 flex flex-col items-center justify-center bg-gradient-to-br from-primary to-primary-container text-white rounded-lg p-6 hover:opacity-90 transition-all text-center">
                    <span class="material-symbols-outlined text-4xl mb-2">touch_app</span>
                    <span class="font-label-md text-label-md">Oynamak için tıkla</span>
                  </a>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>
      </section>
    <% } %>

  </main>

  <%- include('partials/theme-foot', { user: user }) %>
  <% if (user) { %>
  
  <!-- Özel Mesaj (PM) Modal -->
  <div id="pm-modal" class="fixed bottom-4 right-4 z-[110] hidden flex-col w-[320px] bg-surface rounded-t-xl rounded-b-md shadow-2xl border border-outline-variant overflow-hidden animate-fade-in">
    <!-- Header -->
    <div class="bg-primary p-3 flex justify-between items-center text-white cursor-pointer" onclick="togglePmModal()">
      <div class="flex items-center gap-2">
        <span class="relative flex-shrink-0">
          <span class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center font-bold overflow-hidden" id="pm-avatar">?</span>
          <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-success-green border-2 border-primary rounded-full"></span>
        </span>
        <div class="flex flex-col">
          <span class="font-label-md leading-tight" id="pm-username">Oyuncu</span>
          <span class="text-[10px] opacity-80" id="pm-status">Çevrimiçi</span>
        </div>
      </div>
      <button onclick="closePmModal(event)" class="text-white/80 hover:text-white transition-colors focus:outline-none p-1">
        <span class="material-symbols-outlined text-sm">close</span>
      </button>
    </div>
    
    <!-- Body (Chat messages) -->
    <div id="pm-messages" class="p-3 h-[250px] overflow-y-auto bg-surface flex flex-col gap-2 text-body-sm relative">
       <!-- Not VIP overlay -->
       <div id="pm-vip-overlay" class="absolute inset-0 bg-surface/90 backdrop-blur-sm hidden flex-col items-center justify-center p-4 text-center z-10">
          <span class="material-symbols-outlined text-4xl text-yellow-500 mb-2">workspace_premium</span>
          <p class="font-headline-sm text-primary mb-2">VIP Özel Mesaj</p>
          <p class="text-body-sm text-outline mb-4">Özel mesaj göndermek için VIP olmalısınız.</p>
          <button onclick="closePmModal(event); openVipModal();" class="bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded-lg font-label-md transition-colors shadow-sm w-full">VIP Satın Al</button>
       </div>
    </div>
    
    <!-- Input -->
    <form id="pm-form" class="border-t border-outline-variant p-2 flex gap-2 bg-surface-container-low" onsubmit="sendPm(event)">
      <input type="text" id="pm-input" placeholder="Bir mesaj yazın..." class="flex-1 bg-white border border-outline-variant rounded-full px-4 py-1.5 focus:border-primary focus:outline-none text-body-sm" autocomplete="off">
      <button type="submit" id="pm-submit" class="w-8 h-8 flex items-center justify-center bg-primary text-white rounded-full hover:bg-primary-hover transition-colors flex-shrink-0">
        <span class="material-symbols-outlined text-sm">send</span>
      </button>
    </form>
  </div>
  
  <!-- VIP Satin Al / E-Pin Modal -->
  <div id="vip-modal" class="fixed inset-0 bg-black/60 z-[100] hidden flex items-center justify-center p-4">
    <div class="bg-surface rounded-2xl shadow-2xl border border-outline-variant w-full max-w-md overflow-hidden animate-fade-in relative">
      <!-- Gradient Header -->
      <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 p-5 flex justify-between items-center text-white">
        <h3 class="font-headline-sm flex items-center gap-2">
          <span class="material-symbols-outlined">workspace_premium</span>
          VIP Satın Al & Aktifleştir
        </h3>
        <button onclick="closeVipModal()" class="text-white hover:text-gray-200 transition-colors focus:outline-none">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      
      <!-- Body -->
      <div class="p-6">
        <p class="text-body-md text-outline mb-4">Aşağıdaki resmi satıcılarımızdan güvenle VIP E-Pin kodu satın alabilirsiniz:</p>
        
        <div class="grid grid-cols-2 gap-4 mb-6">
          <% if (typeof vipLinks !== 'undefined' && vipLinks.length > 0) { %>
            <% vipLinks.forEach(link => { %>
              <a href="<%= link.url %>" target="_blank" class="flex flex-col items-center justify-center p-4 border border-outline-variant rounded-xl hover:border-yellow-500 hover:bg-yellow-50 transition-colors">
                <span class="font-label-lg font-bold text-gray-700 mb-1"><%= link.name %></span>
                <span class="font-body-sm text-outline text-center">Hemen Al</span>
              </a>
            <% }) %>
          <% } else { %>
            <div class="col-span-2 text-center text-outline text-sm py-4">Şu an aktif bir VIP satış noktası bulunmuyor.</div>
          <% } %>
        </div>

        <hr class="border-outline-variant mb-6">
        
        <form action="/settings/profile/vip" method="POST" class="flex flex-col gap-3">
          <label class="font-label-md text-primary">E-Pin Kodunuzu Girin</label>
          <div class="flex flex-col sm:flex-row gap-2">
            <input type="text" name="vip_code" placeholder="XXXX-YYYY-ZZZZ" class="flex-1 bg-background border border-outline-variant rounded-lg px-4 py-2.5 focus:border-yellow-500 focus:outline-none uppercase font-mono text-center sm:text-left" required>
            <button type="submit" class="bg-yellow-500 hover:bg-yellow-600 text-white px-5 py-2.5 rounded-lg font-label-md transition-colors whitespace-nowrap shadow-sm">Aktifleştir</button>
          </div>
          <p class="text-[11px] text-outline mt-1 text-center sm:text-left">* VIP süreniz kodu girdiğiniz andan itibaren başlar.</p>
        </form>
      </div>
    </div>
  </div>

  <script>
    
    let currentPmUser = null;
    let isUserVip = <%= (user && user.vip > 0) ? 'true' : 'false' %>;

    function openPmModal(username, avatarInitial) {
      currentPmUser = username;
      document.getElementById('pm-username').textContent = username;
      document.getElementById('pm-avatar').innerHTML = avatarInitial || '?';
      document.getElementById('pm-modal').classList.remove('hidden');
      document.getElementById('pm-modal').classList.add('flex');
      
      const overlay = document.getElementById('pm-vip-overlay');
      const input = document.getElementById('pm-input');
      const submit = document.getElementById('pm-submit');
      
      if (!isUserVip) {
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        input.disabled = true;
        submit.disabled = true;
      } else {
        overlay.classList.remove('flex');
        overlay.classList.add('hidden');
        input.disabled = false;
        submit.disabled = false;
        input.focus();
        
        // Render history if we had any
        const msgContainer = document.getElementById('pm-messages');
        const overlayNode = document.getElementById('pm-vip-overlay');
        msgContainer.innerHTML = '';
        msgContainer.appendChild(overlayNode);
        msgContainer.innerHTML += '<div class="text-center text-[10px] text-outline my-2">Sohbet başlangıcı</div>';
      }
    }

    function closePmModal(e) {
      if (e) e.stopPropagation();
      document.getElementById('pm-modal').classList.remove('flex');
      document.getElementById('pm-modal').classList.add('hidden');
      currentPmUser = null;
    }

    function togglePmModal() {
      const msgs = document.getElementById('pm-messages');
      const form = document.getElementById('pm-form');
      if (msgs.style.display === 'none') {
        msgs.style.display = 'flex';
        form.style.display = 'flex';
      } else {
        msgs.style.display = 'none';
        form.style.display = 'none';
      }
    }

    function sendPm(e) {
      e.preventDefault();
      if (!isUserVip) return;
      
      const input = document.getElementById('pm-input');
      const text = input.value.trim();
      if (!text || !currentPmUser) return;
      
      const msgContainer = document.getElementById('pm-messages');
      const time = new Date().toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
      
      // Add my message
      msgContainer.innerHTML += `
        <div class="flex flex-col items-end w-full mt-1">
          <div class="bg-primary text-white rounded-2xl rounded-br-sm px-3 py-1.5 max-w-[85%] break-words relative group">
            ${text}
          </div>
          <span class="text-[9px] text-outline mt-0.5">${time}</span>
          </div>
        `;
      
      input.value = '';
      msgContainer.scrollTop = msgContainer.scrollHeight;
    }
    
    function openVipModal() {
      document.getElementById('vip-modal').classList.remove('hidden');
    }
    function closeVipModal() {
      document.getElementById('vip-modal').classList.add('hidden');
    }
    // Disariya tiklaninca modal kapansin
    document.getElementById('vip-modal').addEventListener('click', function(e) {
      if (e.target === this) {
        closeVipModal();
      }
    });
  </script>
  <% } %>
  <script src="/socket.io/socket.io.js"></script>
  <script>window.LOBBY_GAME_ID = 'lobby';</script>
  <script src="/js/lobby.js"></script>
</body>
</html>
