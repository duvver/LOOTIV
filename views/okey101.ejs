<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Okey 101 - LOOTIV</title>
<link rel="stylesheet" href="/css/style.css?v=6" />
<link rel="stylesheet" href="/css/okey101.css?v=1" />
</head>
<body class="okey101-page" data-user-id="<%= user.id %>">
  
<div class="game-scaler">
  <div class="okey101">
  <div class="game">

    <!-- ÜST BAR -->
    <div class="topbar">
      <span class="btn-masalar" role="button" tabindex="0" aria-label="Masalara Dön">MASALAR</span>
      <span class="table-badge" id="table-badge-id" role="button" tabindex="0" aria-label="Oyundan Çık">#--<span class="x" aria-hidden="true">✕</span></span>
      <span class="btn-play" role="button" tabindex="0" aria-label="Hemen Oyna">HEMEN OYNA! <span class="arrows" aria-hidden="true">▶▶</span></span>
      <span class="spacer"></span>
      <span class="user-pill"><%= user.rumuz %></span>
      <span class="avatar"><%= user.rumuz.substring(0, 2).toUpperCase() %></span>
      <span class="ic" role="button" tabindex="0" aria-label="Market">🛒</span>
      <span class="ic" role="button" tabindex="0" aria-label="Ayarlar">⚙</span>
      <span class="ic heart" role="button" tabindex="0" aria-label="Beğen">♥</span>
    </div>

    <!-- BİLGİ BARI -->
    <div class="infobar">
      <span class="mini-ic" role="button" tabindex="0" aria-label="Yenile">↺</span>
      <span class="mini-ic" role="button" tabindex="0" aria-label="Dondur">❄</span>
      <span class="mini-ic" role="button" tabindex="0" aria-label="Panoya Kopyala">📋</span>
      <span class="el-badge">EL</span>
      <span class="el-count" id="info-el-count">1 / 3</span>
      <span class="puan"><b id="info-puan">0</b> PUAN</span>
      <span class="yardim"><span class="dot"></span> <span id="info-help-text">Katlamalı Yardım 25+30sn Özelsiz</span></span>
      <span class="coins">
        <span class="coin silver"><span class="c"></span><%= (user.lt_balance || 0).toLocaleString('tr-TR') %></span>
        <span class="coin gold"><span class="c"></span><%= (user.lc_balance || 0).toLocaleString('tr-TR') %></span>
      </span>
    </div>

    <!-- TAHTA -->
    <div class="board-wrap">
      <div class="board">

        <!-- KÖŞELER (Atılan Taşlar) -->
        <div class="discard discard-pos-top" id="discard-top"></div>
        <div class="discard discard-pos-right" id="discard-right"></div>
        <div class="discard discard-pos-bottom" id="discard-bottom"></div>
        <div class="discard discard-pos-left" id="discard-left"></div>


        <!-- sag ust: 101 / 5 -->
        <div class="tags-wrap">
          <div class="tags"><span class="tag">101</span><span class="tag">5</span></div>
        </div>



        <!-- ORTA: 26 + 6 kare -->
        <div class="center-area" id="center-area">
          <div class="grid-main" id="grid-main" style="position:relative;">
            
            <!-- UST oyuncu -->
            <div class="seat seat-top" id="seat-top">
              <div class="seat-info">
                <div class="player-details">
                  <span class="score-pill" id="score-top">0</span>
                  <span class="name-lbl" id="name-top">Bekleniyor...</span>
                </div>
                <div class="disc cyan" id="avatar-top">--</div>
              </div>
            </div>

            <!-- ALT oyuncu iptal edildi -->

            <!-- SOL oyuncu -->
            <div class="seat seat-left" id="seat-left">
              <div class="seat-info">
                <div class="player-details">
                  <span class="score-pill" id="score-left">0</span>
                  <span class="name-lbl" id="name-left">Bekleniyor...</span>
                </div>
                <div class="disc green" id="avatar-left">--</div>
              </div>
            </div>

            <!-- SAG oyuncu -->
            <div class="seat seat-right" id="seat-right">
              <div class="seat-info">
                <div class="player-details">
                  <span class="score-pill" id="score-right">0</span>
                  <span class="name-lbl" id="name-right">Bekleniyor...</span>
                </div>
                <div class="disc cyan" id="avatar-right">--</div>
              </div>
            </div>
            <% for(let i=0; i<338; i++) { %><div class="cell"></div><% } %>
          </div>
          <div class="grid-side" id="grid-side">
            <% for(let i=0; i<78; i++) { %><div class="cell"></div><% } %>
          </div>
        </div>



      </div>
    </div>

    <!-- KONTROLLER -->
    <div class="controls">
      <div class="left-actions" style="display:flex; gap:10px;">
        <div class="diz-btn" id="btn-sort-pairs" role="button" tabindex="0" aria-label="Çift Diz">ÇİFT<br aria-hidden="true">DİZ</div>
        <div class="diz-btn" id="btn-sort-series" role="button" tabindex="0" aria-label="Seri Diz">SERİ<br aria-hidden="true">DİZ</div>
        <div class="diz-btn action-ac" id="btn-open-pairs" role="button" tabindex="0" aria-label="Çift Aç">ÇİFT<br aria-hidden="true">AÇ</div>
        <div class="diz-btn action-ac" id="btn-open-series" role="button" tabindex="0" aria-label="Seri Aç">SERİ<br aria-hidden="true">AÇ</div>
        <div class="diz-btn action-gosterge" id="btn-show-indicator" role="button" tabindex="0" aria-label="Gösterge" style="display:none; background:#3498db;">GÖSTERGE</div>
      </div>

      <div class="local-player-hud" id="seat-bottom">
        <span class="score-pill" id="score-bottom">0</span>
        <div class="disc gold" id="avatar-bottom" style="position:relative;">
          <%= user.rumuz.substring(0, 2).toUpperCase() %>
          <span class="badge-notif" id="turn-notif" style="display:none;"></span>
        </div>
        <span class="name-inline" id="name-bottom"><%= user.rumuz %></span>
      </div>

      <div class="draw-slot">
        <!-- Joker gostergesi / Cekme alani -->
        <div class="slot-tile n20" id="deck-count">20</div>
        <div class="slot-tile n12" id="indicator-tile">--</div>
        <div class="slot-tile empty"></div>
        <div class="gear-round" role="button" tabindex="0" aria-label="Oyun Ayarları">⚙</div>
      </div>
    </div>

    <!-- ISTAKA -->
    <div class="rack-area">
      <span class="score-51" id="hand-score">0</span>
      <div class="rack" id="player-rack">
        <div class="row" id="rack-row-1">
          <!-- Taslar buraya JS ile eklenecek -->
        </div>
        <div class="row" id="rack-row-2">
          <!-- Taslar buraya JS ile eklenecek -->
        </div>
      </div>
    </div>

    <!-- EN ALT BAR -->
    <div class="bottombar">
      <span class="chat-ic" role="button" tabindex="0" aria-label="Sohbeti Aç">💬</span>
      <span class="tbl-yellow" id="bottom-table-id">#--</span>
      <span class="bell" role="button" tabindex="0" aria-label="Bildirimler">🔔<span class="n" id="notif-count" aria-hidden="true">1</span></span>
    </div>

    <!-- MODALS -->
    <!-- Market Modal -->
    <div id="modal-market" class="game-modal" style="display: none;">
      <div class="modal-content">
        <span class="close-modal">&times;</span>
        <h2>Market</h2>
        <p>Market çok yakında aktif olacak!</p>
      </div>
    </div>

    <!-- Ayarlar Modal -->
    <div id="modal-settings" class="game-modal" style="display: none;">
      <div class="modal-content">
        <span class="close-modal">&times;</span>
        <h2>Oyun Ayarları</h2>
        <div class="settings-opts">
          <label><input type="checkbox" id="chk-sound" checked> Ses Efektleri</label><br>
          <label><input type="checkbox" id="chk-dark"> Karanlık Tema (Gelecekte)</label>
        </div>
      </div>
    </div>

    <!-- Bildirimler Dropdown/Modal -->
    <div id="modal-notifs" class="game-modal" style="display: none;">
      <div class="modal-content">
        <span class="close-modal">&times;</span>
        <h2>Bildirimler</h2>
        <p>Henüz yeni bildirim yok.</p>
      </div>
    </div>

    <!-- Sohbet Paneli -->
    <div id="panel-chat" class="chat-panel" style="display: none;">
      <div class="chat-header">
        Masa Sohbeti <span class="close-chat">&times;</span>
      </div>
      <div class="chat-body" id="chat-body">
        <div class="chat-msg system">Sohbet odasına katıldınız. Küfür etmek yasaktır.</div>
      </div>
      <div class="chat-input">
        <input type="text" id="chat-inp" placeholder="Mesaj yaz...">
        <button id="btn-send-chat">Gönder</button>
      </div>
    </div>

  </div>
  </div>
</div>

<script>
  // Resize logic for game-scaler
  function resizeGame() {
    const scaler = document.querySelector('.game-scaler');
    const game = document.querySelector('.okey101');
    if (!scaler || !game) return;
    
    // Original width is 755px. Let's scale if the screen is smaller than 800px.
    const screenWidth = window.innerWidth;
    let scale = 1;
    if (screenWidth < 800) {
      scale = screenWidth / 780; // a little padding
    }
    
    game.style.setProperty('--scale', scale);
  }

  window.addEventListener('resize', resizeGame);
  window.addEventListener('DOMContentLoaded', resizeGame);
</script>

<div id="toast-container"></div>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/okey101.js?v=3"></script>
</body>
</html>
