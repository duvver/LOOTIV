<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Canak Okey - LOOTIV</title>
  <link rel="stylesheet" href="/css/style.css?v=6" />
  <link rel="stylesheet" href="/css/okey101.css?v=4" />
</head>
<body class="app-body" data-user-id="<%= user.id %>">
  <header class="topbar">
    <div class="topbar-left">
      <a href="/" class="brand-logo"><img src="/images/lootivlogo.png" alt="LOOTIV" /></a>
    </div>
    <div class="topbar-right">
      <nav class="topbar-nav">
        <a href="/">Ana Sayfa</a>
      </nav>
      <div class="user-chip">
        <span class="user-name"><%= user.rumuz %></span>
        <span class="user-points"><span class="coin">&#9679;</span> <%= user.lt_balance %> LT</span>
      </div>
      <a href="/" class="btn btn-ghost btn-sm">Ana Sayfaya Don</a>
    </div>
  </header>

  <main class="okey-layout">
    <section class="okey-table">
      <div class="okey-felt" id="okey-felt">
        <div class="okey-title" id="okey-title">Canak Okey</div>
        <div class="okey-status" id="okey-status"></div>
        <div class="okey-seats" id="okey-seats"></div>
        <div class="okey-middle">
          <div class="okey-deck" id="okey-deck">
            <div class="okey-deck-pile" id="okey-deck-pile" title="Desteden cek"></div>
            <div class="okey-deck-count" id="okey-deck-count"></div>
          </div>
          <div class="okey-indicator" id="okey-indicator"></div>
        </div>
        <div class="okey-corner okey-corner-0" id="okey-corner-0"></div>
        <div class="okey-corner okey-corner-1" id="okey-corner-1"></div>
        <div class="okey-corner okey-corner-2" id="okey-corner-2"></div>
        <div class="okey-corner okey-corner-3" id="okey-corner-3"></div>
        <div class="okey-banner" id="okey-banner"></div>
      </div>
      <div class="okey-rack-wrap">
        <div class="okey-rack-area">
          <button type="button" class="okey-diz-btn" id="okey-cift-diz"><span>&#199;&#304;FT</span><span>D&#304;Z</span></button>
          <div class="okey-rack" id="okey-rack"></div>
          <button type="button" class="okey-diz-btn" id="okey-seri-diz"><span>SER&#304;</span><span>D&#304;Z</span></button>
        </div>
        <div class="okey-action-bar" id="okey-action-bar"></div>
      </div>
    </section>

    <aside class="players-panel">
      <h3 class="panel-title">Canli Oynayanlar <span id="player-count" class="panel-count">0</span></h3>
      <ul id="player-list" class="player-list"></ul>
    </aside>

  </main>

  <!-- ===== Sohbet paneli (surekli acik) ===== -->
  <aside class="ok1-chatpanel" id="ok1-chatpanel">
    <div class="chat-tabs">
      <button class="chat-tab active" data-channel="oyun">Oyun Lobisi <span class="badge"></span></button>
      <button class="chat-tab" data-channel="sistem">Sistem Mesaji <span class="badge"></span></button>
    </div>
    <div class="chat-body">
      <div class="chat-messages" id="chat-messages" data-channel="oyun"></div>
    </div>
    <form class="chat-input-row" id="chat-form" style="position: relative;">
      <button type="button" class="btn btn-sm" id="emote-toggle-btn" style="padding: 0 8px; font-size: 1.2rem; background: transparent; border: none;">😊</button>
      <div id="emote-picker" class="glass-panel" style="display: none; position: absolute; bottom: 100%; left: 0; padding: 5px; z-index: 1000; border-radius: 8px; flex-wrap: wrap; width: max-content;">
        <button type="button" class="emote-btn" data-emote="😊">😊</button>
        <button type="button" class="emote-btn" data-emote="😂">😂</button>
        <button type="button" class="emote-btn" data-emote="😎">😎</button>
        <button type="button" class="emote-btn" data-emote="😡">😡</button>
        <button type="button" class="emote-btn" data-emote="👍">👍</button>
        <button type="button" class="emote-btn" data-emote="👎">👎</button>
      </div>
      <input type="text" id="chat-input" class="chat-input" placeholder="Mesajını yaz..." maxlength="500" autocomplete="off" />
      <button type="submit" class="btn btn-primary btn-sm">Gönder</button>
    </form>
  </aside>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/soundEngine.js?v=1"></script>
  <script src="/js/okey.js?v=3"></script>
  <script src="/js/notify.js?v=1"></script>
</body>
</html>
