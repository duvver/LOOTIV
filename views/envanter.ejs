<!DOCTYPE html>
<html class="light" lang="tr">
<head>
  <%- include('partials/theme-head', { pageTitle: 'Envanter — LOOTIV' }) %>
  <style>
    .rarity-common-border { border-color: #BDC3C7; }
    .rarity-rare-border { border-color: #3498DB; }
    .rarity-epic-border { border-color: #9B59B6; }
    .rarity-legendary-border { border-color: #EB930C; }
    .rarity-common-text { color: #7F8C8D; }
    .rarity-rare-text { color: #3498DB; }
    .rarity-epic-text { color: #9B59B6; }
    .rarity-legendary-text { color: #EB930C; }
    .rarity-common-bg { background: #BDC3C7; }
    .rarity-rare-bg { background: #3498DB; }
    .rarity-epic-bg { background: #9B59B6; }
    .rarity-legendary-bg { background: #EB930C; }
    .rarity-common-badge { background: rgba(189,195,199,.18); color: #7F8C8D; }
    .rarity-rare-badge { background: rgba(52,152,219,.15); color: #3498DB; }
    .rarity-epic-badge { background: rgba(155,89,182,.15); color: #9B59B6; }
    .rarity-legendary-badge { background: rgba(235,147,12,.15); color: #EB930C; }
    .sticky-details { position: sticky; top: 5rem; }
    .item-selected { border-color: #1d3246 !important; transform: scale(0.95); box-shadow: 0 0 15px rgba(29,50,70,0.4); }
  </style>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col">

  <%- include('partials/theme-nav', { active: 'envanter', user: user, unreadCount: typeof unreadCount !== 'undefined' ? unreadCount : 0 }) %>

  <main class="flex-grow w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-8 grid grid-cols-1 lg:grid-cols-12 gap-gutter">

    <!-- Sol: Envanter grid -->
    <div class="lg:col-span-8 space-y-gutter">
      <div class="flex items-center justify-between mb-2">
        <div>
          <h1 class="font-headline-lg text-headline-lg text-primary">Karakter Envanteri</h1>
          <p class="font-body-md text-body-md text-outline">Bir eşya seç, yükselt ya da pazarda satışa koy.</p>
        </div>
      </div>

      <% if (typeof info !== 'undefined' && info) { %><div class="mb-4 p-3 bg-success-green/15 text-success-green rounded-lg font-body-sm"><%= info %></div><% } %>
      <% if (typeof error !== 'undefined' && error) { %><div class="mb-4 p-3 bg-error-container text-on-error-container rounded-lg font-body-sm"><%= error %></div><% } %>

      <div class="grid grid-cols-4 sm:grid-cols-5 md:grid-cols-6 gap-3">
        <% if (!items || items.length === 0) { %>
          <div class="col-span-full flex flex-col items-center justify-center py-20 text-outline bg-white rounded-xl border border-outline-variant/30">
            <span class="material-symbols-outlined text-6xl mb-2">inventory_2</span>
            <p class="font-headline-md text-primary">Envanterin şu an boş.</p>
            <p class="font-body-sm mt-1">Admin panelinden (Pazar Yönetimi) eşya tanımlanıp kullanıcılara verilir.</p>
          </div>
        <% } else { %>
          <% items.forEach(function(item){ var rl = item.rarity.toLowerCase(); %>
            <div class="item-slot inventory-item relative aspect-square bg-white border-2 rarity-<%= rl %>-border rounded-lg overflow-hidden cursor-pointer hover:shadow-lg transition-all group"
                 data-json="<%= encodeURIComponent(JSON.stringify(item.toJSON())) %>"
                 onclick="selectItem(this)">
              <% if (item.imageUrl) { %>
                <div class="w-full h-full bg-cover bg-center" style="background-image: url('<%= item.imageUrl %>')"></div>
              <% } else { %>
                <div class="w-full h-full flex flex-col items-center justify-center text-outline">
                  <span class="material-symbols-outlined text-4xl">
                    <% if (item.category === 'silah') { %>swords
                    <% } else if (item.category === 'zirh') { %>shield
                    <% } else if (item.category === 'belt' || item.category === 'kemer') { %>checkroom
                    <% } else { %>inventory_2<% } %>
                  </span>
                  <span class="text-[10px] font-bold text-center mt-1 truncate w-full px-1"><%= item.displayName %></span>
                </div>
              <% } %>
              <% if (item.upgradeLevel > 0) { %>
                <span class="absolute top-1 right-1 rarity-<%= rl %>-bg text-white font-label-sm text-[10px] px-1 rounded-sm">+<%= item.upgradeLevel %></span>
              <% } %>
              <% if (item.listed) { %>
                <div class="absolute inset-0 bg-black/60 flex items-center justify-center">
                  <span class="text-white font-label-sm tracking-widest text-[10px] font-bold">SATIŞTA</span>
                </div>
              <% } %>
              <div class="absolute inset-0 bg-primary/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- Sağ: Detay paneli -->
    <aside class="lg:col-span-4">
      <div class="sticky-details bg-white rounded-xl border border-outline-variant/30 shadow-sm p-gutter flex flex-col gap-gutter min-h-[500px]">
        <div id="no-selection" class="flex flex-col items-center justify-center text-center text-outline py-20 h-full">
          <span class="material-symbols-outlined text-5xl mb-2">touch_app</span>
          <p class="font-body-md">Detaylarını görmek için bir eşya seç.</p>
        </div>
        <div id="item-details" class="hidden flex-col h-full">
          <div class="w-full aspect-square bg-surface-container-low rounded-lg overflow-hidden border border-outline-variant/30 flex items-center justify-center mb-4">
            <div id="detail-image" class="w-full h-full bg-cover bg-center transition-all duration-300"></div>
            <span id="detail-icon" class="material-symbols-outlined text-6xl hidden text-outline">inventory_2</span>
          </div>
          <div class="space-y-2">
            <div class="flex justify-between items-start gap-2">
              <h2 class="font-headline-md text-headline-md" id="detail-name">Eşya Adı</h2>
              <span class="px-2 py-1 text-label-sm rounded uppercase tracking-wider whitespace-nowrap" id="detail-rarity">Nadirlik</span>
            </div>
            <p class="text-body-sm text-outline italic capitalize" id="detail-category"></p>
          </div>
          <hr class="border-outline-variant/30 my-4"/>
          <div class="space-y-3 flex-grow" id="detail-attributes"></div>
          <hr class="border-outline-variant/30 my-4"/>
          <div class="flex flex-col gap-3 mt-auto" id="detail-actions">
            <form id="upgrade-form" method="POST" action="">
              <button type="submit" class="w-full py-3 border-2 border-primary text-primary font-headline-md rounded-lg hover:bg-primary hover:text-white transition-all flex items-center justify-center gap-2">
                <span class="material-symbols-outlined">upgrade</span> + Bas (Yükselt)
              </button>
            </form>
            <a id="sell-btn" href="#" class="w-full py-3 bg-secondary text-white font-headline-md rounded-lg hover:opacity-90 transition-all shadow-md active:scale-95 flex items-center justify-center gap-2 text-center">
              <span class="material-symbols-outlined">shopping_cart</span> Pazarda Satış
            </a>
          </div>
          <div class="hidden text-center py-4 px-3 bg-primary/5 text-primary rounded-lg border border-primary/20 font-label-md mt-auto" id="sale-status">
            Bu eşya şu anda pazarda satışta.
          </div>
        </div>
      </div>
    </aside>
  </main>

  <%- include('partials/theme-foot', { user: user }) %>

  <script>
    function selectItem(element) {
      document.querySelectorAll('.inventory-item').forEach(function(el){ el.classList.remove('item-selected'); });
      element.classList.add('item-selected');
      var item = JSON.parse(decodeURIComponent(element.getAttribute('data-json')));
      var rl = (item.rarity || 'common').toLowerCase();

      document.getElementById('no-selection').classList.add('hidden');
      var panel = document.getElementById('item-details');
      panel.classList.remove('hidden');
      panel.classList.add('flex');

      var nameEl = document.getElementById('detail-name');
      nameEl.innerText = item.displayName;
      nameEl.className = 'font-headline-md text-headline-md rarity-' + rl + '-text';

      var rarityMap = { common:'Yaygın', rare:'Nadir', epic:'Epik', legendary:'Efsanevi' };
      var rarityEl = document.getElementById('detail-rarity');
      rarityEl.innerText = rarityMap[rl] || item.rarity;
      rarityEl.className = 'px-2 py-1 text-label-sm rounded uppercase tracking-wider whitespace-nowrap rarity-' + rl + '-badge';

      var catMap = { silah:'Silah', zirh:'Zırh', koleksiyon:'Koleksiyon', karakter:'Karakter', diger:'Diğer' };
      document.getElementById('detail-category').innerText = catMap[item.category] || item.category;

      var imgEl = document.getElementById('detail-image');
      var iconEl = document.getElementById('detail-icon');
      if (item.imageUrl) {
        imgEl.style.backgroundImage = "url('" + item.imageUrl + "')";
        imgEl.classList.remove('hidden');
        iconEl.classList.add('hidden');
      } else {
        imgEl.classList.add('hidden');
        iconEl.classList.remove('hidden');
        iconEl.className = 'material-symbols-outlined text-6xl rarity-' + rl + '-text';
        if (item.category === 'silah') iconEl.textContent = 'swords';
        else if (item.category === 'zirh') iconEl.textContent = 'shield';
        else if (item.category === 'belt' || item.category === 'kemer') iconEl.textContent = 'checkroom';
        else iconEl.textContent = 'inventory_2';
      }

      var attrContainer = document.getElementById('detail-attributes');
      attrContainer.innerHTML = '';
      var attrs = item.attributes || {};
      if (Object.keys(attrs).length === 0) {
        attrContainer.innerHTML = '<p class="text-body-sm text-outline">Özel bir niteliği yok.</p>';
      } else {
        for (var key in attrs) {
          var valStr = String(attrs[key]);
          var colorClass = 'text-primary font-bold';
          if (valStr.charAt(0) === '+') colorClass = 'text-success-green font-bold';
          else if (valStr.charAt(0) === '-') colorClass = 'text-error font-bold';
          attrContainer.innerHTML += '<div class="flex justify-between items-center text-body-md"><span class="text-outline capitalize">' + key.replace('_', ' ') + '</span><span class="' + colorClass + '">' + valStr + '</span></div>';
        }
      }

      var actionsEl = document.getElementById('detail-actions');
      var statusEl = document.getElementById('sale-status');
      if (item.listed) {
        actionsEl.classList.add('hidden');
        statusEl.classList.remove('hidden');
      } else {
        actionsEl.classList.remove('hidden');
        statusEl.classList.add('hidden');
        document.getElementById('upgrade-form').action = '/envanter/upgrade/' + item.inventoryId;
        document.getElementById('sell-btn').href = '/pazar/sat/' + item.inventoryId;
      }
    }
  </script>
</body>
</html>
