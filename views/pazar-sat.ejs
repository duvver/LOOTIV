<!DOCTYPE html>
<html class="light" lang="tr">
<head>
  <%- include('partials/theme-head', { pageTitle: 'İlan Oluştur — LOOTIV' }) %>
  <style>
    .rarity-common-bg { background: #BDC3C7; }
    .rarity-rare-bg { background: #3498DB; }
    .rarity-epic-bg { background: #9B59B6; }
    .rarity-legendary-bg { background: #EB930C; }
    input::-webkit-outer-spin-button, input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  </style>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col">

  <%- include('partials/theme-nav', { active: 'envanter', user: user, unreadCount: typeof unreadCount !== 'undefined' ? unreadCount : 0 }) %>

  <main class="flex-grow py-10 px-margin-mobile md:px-margin-desktop">
    <div class="max-w-4xl mx-auto">
      <div class="mb-8">
        <a class="inline-flex items-center gap-2 text-primary hover:gap-3 transition-all" href="/envanter">
          <span class="material-symbols-outlined">arrow_back</span>
          <span class="font-label-md text-label-md">Envantere Geri Dön</span>
        </a>
        <h1 class="font-headline-lg text-headline-lg text-primary mt-4">Yeni İlan Oluştur</h1>
        <p class="text-outline font-body-md">Eşyanı pazarda satışa çıkar. Kategori, nadirlik ve görsel eşyadan otomatik alınır.</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %><div class="mb-4 p-3 bg-error-container text-on-error-container rounded-lg font-body-sm"><%= error %></div><% } %>

      <%
        var rl = (item.rarity || 'common').toLowerCase();
        var rarityMap = { common:'Yaygın', rare:'Nadir', epic:'Epik', legendary:'Efsanevi' };
        var rarityTr = rarityMap[rl] || item.rarity;
        var catMap = { silah:'Silah', zirh:'Zırh', koleksiyon:'Koleksiyon', karakter:'Karakter', diger:'Diğer' };
      %>

      <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-outline-variant/30 grid grid-cols-1 md:grid-cols-2">
        <!-- Sol: Eşya önizleme -->
        <div class="bg-surface-container-low p-8 flex flex-col items-center justify-center border-b md:border-b-0 md:border-r border-outline-variant">
          <div class="relative">
            <div class="w-48 h-48 rounded-lg bg-white p-4 shadow-sm flex items-center justify-center mb-6 border border-outline-variant/30">
              <% if (item.imageUrl) { %>
                <img class="w-full h-full object-contain" src="<%= item.imageUrl %>"/>
              <% } else { %>
                <span class="material-symbols-outlined text-6xl text-outline">
                  <% if (item.category === 'silah') { %>swords
                  <% } else if (item.category === 'zirh') { %>shield
                  <% } else if (item.category === 'belt' || item.category === 'kemer') { %>checkroom
                  <% } else { %>inventory_2<% } %>
                </span>
              <% } %>
            </div>
            <div class="absolute -top-2 -right-2 rarity-<%= rl %>-bg text-white px-3 py-1 rounded-full font-label-sm text-label-sm shadow-md"><%= rarityTr %></div>
          </div>
          <div class="text-center w-full">
            <h2 class="font-headline-md text-headline-md text-primary mb-1"><%= item.displayName %></h2>
            <p class="text-outline font-body-sm mb-6"><%= catMap[item.category] || item.category %></p>
            <div class="grid grid-cols-2 gap-3 w-full">
              <% var attrs = item.attributes || {}; var keys = Object.keys(attrs); %>
              <% if (keys.length === 0) { %>
                <div class="col-span-2 bg-white p-3 rounded-lg border border-outline-variant/30 text-center">
                  <p class="text-outline font-label-sm">Özel bir niteliği yok.</p>
                </div>
              <% } else { %>
                <% keys.forEach(function(key){ var val = String(attrs[key]); var colorClass = 'text-primary'; if (val.charAt(0) === '+') colorClass = 'text-success-green'; else if (val.charAt(0) === '-') colorClass = 'text-error'; %>
                <div class="bg-white p-3 rounded-lg border border-outline-variant/30 text-left">
                  <p class="text-outline font-label-sm text-[10px] uppercase tracking-wider"><%= key.replace('_', ' ') %></p>
                  <p class="font-headline-md text-headline-md <%= colorClass %>"><%= val %></p>
                </div>
                <% }); %>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Sağ: Sadece fiyat -->
        <div class="p-8 flex flex-col justify-between">
          <form method="POST" action="/pazar/sat/<%= item.inventoryId %>" class="flex flex-col h-full">
            <div>
              <label class="block font-label-md text-label-md text-primary mb-2" for="price-input">Satış Fiyatı (LT)</label>
              <div class="relative mb-8">
                <input name="price" id="price-input" oninput="calculateFees(this.value)" required min="1" step="1" type="number"
                  class="w-full bg-white border border-silver-light rounded-lg py-4 px-6 text-headline-md focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all"
                  placeholder="0"/>
                <div class="absolute right-6 top-1/2 -translate-y-1/2 flex items-center gap-2 pointer-events-none">
                  <span class="text-secondary font-bold">LT</span>
                </div>
              </div>

              <div class="space-y-4 mb-8">
                <div class="flex justify-between items-center py-2 border-b border-outline-variant/30">
                  <span class="text-outline font-body-md">İlan Fiyatı</span>
                  <span class="font-label-md text-label-md" id="display-listing-price">0 LT</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-outline-variant/30">
                  <div class="flex items-center gap-1">
                    <span class="text-outline font-body-md">Sistem Komisyonu</span>
                    <span class="text-[10px] px-1.5 py-0.5 bg-surface-container-high rounded text-outline">%<%= commission %></span>
                  </div>
                  <span class="font-label-md text-label-md text-error" id="display-fee">-0 LT</span>
                </div>
                <div class="flex justify-between items-center py-4 bg-primary/5 px-4 rounded-lg">
                  <span class="font-headline-md text-headline-md text-primary">Net Kazanç</span>
                  <div class="text-right">
                    <span class="font-headline-md text-headline-md text-success-green" id="display-net">0 LT</span>
                    <p class="text-[10px] text-outline">Eline Geçecek Miktar</p>
                  </div>
                </div>
              </div>

              <div class="flex gap-3 p-4 bg-surface-container rounded-lg mb-8">
                <span class="material-symbols-outlined text-primary scale-90">info</span>
                <p class="text-[12px] leading-tight text-outline">
                  Eşyan satılana kadar envanterinden geçici olarak kaldırılır. İlan yayınlandıktan sonra iptal edip geri alabilirsin.
                </p>
              </div>
            </div>

            <button type="submit" class="w-full bg-secondary hover:opacity-90 text-white py-4 px-8 rounded-lg font-headline-md text-headline-md transition-all active:scale-95 shadow-lg mt-auto">
              İlanı Yayınla
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/theme-foot', { user: user }) %>

  <script>
    var comPercent = <%= commission %>;
    function calculateFees(value) {
      var price = Math.trunc(Number(value)) || 0;
      var fee = Math.ceil(price * (comPercent / 100));
      var net = Math.max(0, price - fee);
      document.getElementById('display-listing-price').textContent = price.toLocaleString('tr-TR') + ' LT';
      document.getElementById('display-fee').textContent = '-' + fee.toLocaleString('tr-TR') + ' LT';
      document.getElementById('display-net').textContent = net.toLocaleString('tr-TR') + ' LT';
    }
    calculateFees(0);
  </script>
</body>
</html>
