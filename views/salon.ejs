<!DOCTYPE html>
<html class="light" lang="tr">
<head>
  <%- include('partials/theme-head', { pageTitle: meta.name + ' — LOOTIV' }) %>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col">

  <%- include('partials/theme-nav', { active: 'oyunlar', user: user, unreadCount: typeof unreadCount !== 'undefined' ? unreadCount : 0 }) %>

  <main class="flex-grow max-w-container-max mx-auto w-full px-margin-mobile md:px-margin-desktop py-8">

    <a href="/" class="text-primary font-label-md hover:underline flex items-center gap-1 mb-4"><span class="material-symbols-outlined text-sm">arrow_back</span> Ana Sayfa</a>

    <!-- Oyun başlığı hero -->
    <section class="relative rounded-xl overflow-hidden bg-primary text-white mb-8 p-8 flex items-center gap-5" style="background-image: linear-gradient(120deg, #1d3246, <%= meta.accent %>);">
      <span class="w-16 h-16 rounded-xl bg-white/10 flex items-center justify-center text-4xl"><%- meta.icon %></span>
      <div>
        <h1 class="font-headline-lg text-headline-lg"><%= meta.name %></h1>
        <p class="font-body-md text-white/80"><%= meta.desc %></p>
      </div>
      <a href="<%= meta.playUrl %>" class="ml-auto hidden sm:flex items-center gap-2 bg-secondary-container text-white px-6 py-3 rounded-lg font-headline-md hover:brightness-110 transition-all">
        <span class="material-symbols-outlined">play_arrow</span> Hemen Oyna
      </a>
    </section>

    <!-- Liste başlığı + masa oluştur -->
    <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
      <h2 class="font-headline-lg text-headline-lg text-primary">Acik Masalar</h2>
      <button type="button" id="create-table-btn" class="px-5 py-2.5 bg-secondary-container text-white rounded-lg font-label-md text-label-md hover:opacity-90 transition-all flex items-center gap-2">
        <span class="material-symbols-outlined text-sm">add_circle</span> Masa Olustur
      </button>
    </div>

    <!-- Masa oluştur paneli (gizli) -->
    <div id="create-table-panel" hidden class="bg-white rounded-xl border border-outline-variant/30 shadow-sm p-6 mb-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-2">
          <label class="block font-label-md text-on-surface-variant uppercase tracking-wider">Minimum LT (giris ucreti)</label>
          <input type="number" id="create-min-lt" min="1" placeholder="Orn. 50" class="w-full px-4 py-2.5 border border-silver-light rounded-lg outline-none focus:ring-2 focus:ring-primary" />
        </div>
        <div class="space-y-2">
          <label class="block font-label-md text-on-surface-variant uppercase tracking-wider">Masa adi (istege bagli)</label>
          <input type="text" id="create-name" maxlength="24" placeholder="Orn. Keyifli Masa" class="w-full px-4 py-2.5 border border-silver-light rounded-lg outline-none focus:ring-2 focus:ring-primary" />
        </div>
      </div>
      <div class="flex gap-2 mt-4">
        <button type="button" id="create-confirm" class="px-5 py-2.5 bg-primary text-white rounded-lg font-label-md text-label-sm">Olustur ve Otur</button>
        <button type="button" id="create-cancel" class="px-5 py-2.5 border border-silver-light text-on-surface-variant rounded-lg font-label-md text-label-sm">Vazgec</button>
      </div>
      <p class="text-body-sm text-outline italic mt-3">Not: Masa olusturma sistemi yakinda aktif olacak. Su an dogrudan masaya oturarak oynayabilirsin.</p>
    </div>

    <!-- Masa kartları (temsili) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      <!-- Masa 1 -->
      <div class="bg-white rounded-xl border border-outline-variant/30 shadow-sm p-5 flex flex-col gap-4">
        <div class="flex items-center justify-between">
          <span class="font-headline-md text-primary">Masa #12</span>
          <span class="px-2 py-1 bg-secondary-container/20 text-on-secondary-container rounded font-label-md text-label-sm">20 LT</span>
        </div>
        <div class="flex gap-2">
          <span class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">A</span>
          <span class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">M</span>
          <span class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">K</span>
          <span class="w-9 h-9 rounded-full border-2 border-dashed border-outline-variant"></span>
        </div>
        <div class="flex items-center justify-between pt-3 border-t border-outline-variant/20">
          <span class="text-label-sm text-outline">3/4 oyuncu</span>
          <a href="<%= meta.playUrl %>" class="px-4 py-1.5 bg-primary text-white rounded-lg font-label-md text-label-sm hover:bg-secondary-container transition-colors">Otur</a>
        </div>
      </div>

      <!-- Masa 2 -->
      <div class="bg-white rounded-xl border border-outline-variant/30 shadow-sm p-5 flex flex-col gap-4">
        <div class="flex items-center justify-between">
          <span class="font-headline-md text-primary">Masa #13</span>
          <span class="px-2 py-1 bg-secondary-container/20 text-on-secondary-container rounded font-label-md text-label-sm">20 LT</span>
        </div>
        <div class="flex gap-2">
          <span class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">S</span>
          <span class="w-9 h-9 rounded-full border-2 border-dashed border-outline-variant"></span>
          <span class="w-9 h-9 rounded-full border-2 border-dashed border-outline-variant"></span>
          <span class="w-9 h-9 rounded-full border-2 border-dashed border-outline-variant"></span>
        </div>
        <div class="flex items-center justify-between pt-3 border-t border-outline-variant/20">
          <span class="text-label-sm text-outline">1/4 oyuncu</span>
          <a href="<%= meta.playUrl %>" class="px-4 py-1.5 bg-primary text-white rounded-lg font-label-md text-label-sm hover:bg-secondary-container transition-colors">Otur</a>
        </div>
      </div>

      <!-- Masa 3: dolu -->
      <div class="bg-white rounded-xl border border-outline-variant/30 shadow-sm p-5 flex flex-col gap-4 opacity-80">
        <div class="flex items-center justify-between">
          <span class="font-headline-md text-primary">Masa #14</span>
          <span class="px-2 py-1 bg-secondary-container text-white rounded font-label-md text-label-sm">100 LT</span>
        </div>
        <div class="flex gap-2">
          <span class="w-9 h-9 rounded-full bg-slate-dark text-white flex items-center justify-center font-bold text-sm">D</span>
          <span class="w-9 h-9 rounded-full bg-slate-dark text-white flex items-center justify-center font-bold text-sm">O</span>
          <span class="w-9 h-9 rounded-full bg-slate-dark text-white flex items-center justify-center font-bold text-sm">T</span>
          <span class="w-9 h-9 rounded-full bg-slate-dark text-white flex items-center justify-center font-bold text-sm">B</span>
        </div>
        <div class="flex items-center justify-between pt-3 border-t border-outline-variant/20">
          <span class="text-label-sm text-error">Dolu (4/4)</span>
          <a href="<%= meta.playUrl %>" class="px-4 py-1.5 border border-silver-light text-primary rounded-lg font-label-md text-label-sm hover:bg-surface-container-low transition-colors">Izle</a>
        </div>
      </div>

      <!-- Boş masa ipucu -->
      <div class="bg-surface-container-low rounded-xl border-2 border-dashed border-outline-variant/50 p-5 flex flex-col items-center justify-center text-center gap-2">
        <span class="material-symbols-outlined text-4xl text-primary">add_circle</span>
        <p class="text-body-sm text-outline">Bos masa mi ariyorsun?<br/>Kendi masani olustur.</p>
        <button type="button" id="create-table-btn-2" class="px-4 py-2 border border-silver-light text-primary rounded-lg font-label-md text-label-sm hover:bg-white transition-all">Masa Olustur</button>
      </div>
    </div>
  </main>

  <%- include('partials/theme-foot', { user: user }) %>
  <script>
    (function () {
      var panel = document.getElementById('create-table-panel');
      function open() { panel.hidden = false; panel.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
      function close() { panel.hidden = true; }
      document.getElementById('create-table-btn').addEventListener('click', open);
      var btn2 = document.getElementById('create-table-btn-2');
      if (btn2) btn2.addEventListener('click', open);
      document.getElementById('create-cancel').addEventListener('click', close);
      document.getElementById('create-confirm').addEventListener('click', function () {
        alert('Masa olusturma sistemi yakinda aktif olacak. Simdilik dogrudan masaya oturarak oynayabilirsin.');
      });
    })();
  </script>
</body>
</html>
