<!DOCTYPE html>
<html class="light" lang="tr">
<head>
  <%- include('partials/theme-head', { pageTitle: meta.name + ' — LOOTIV' }) %>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col">

  <%- include('partials/theme-nav', { active: 'oyunlar', user: user, unreadCount: typeof unreadCount !== 'undefined' ? unreadCount : 0 }) %>

  <main class="flex-grow max-w-container-max mx-auto w-full px-margin-mobile md:px-margin-desktop py-8 pb-[270px]">

    <a href="/" class="text-primary font-label-md hover:underline flex items-center gap-1 mb-4"><span class="material-symbols-outlined text-sm">arrow_back</span> Ana Sayfa</a>

    <!-- Oyun başlığı hero -->
    <section class="relative rounded-xl overflow-hidden bg-primary text-white mb-8 p-8 flex items-center gap-5" style="background-image: linear-gradient(120deg, #1d3246, <%= meta.accent %>);">
      <span class="w-16 h-16 rounded-xl bg-white/10 flex items-center justify-center text-4xl"><%- meta.icon %></span>
      <div>
        <h1 class="font-headline-lg text-headline-lg"><%= meta.name %></h1>
        <p class="font-body-md text-white/80"><%= meta.desc %></p>
      </div>
      <a href="<%= meta.playUrl %>" class="ml-auto hidden sm:flex items-center gap-2 bg-secondary-container text-white px-6 py-3 rounded-lg font-headline-md hover:brightness-110 transition-all">
        <span class="material-symbols-outlined">play_arrow</span> Hemen Oyna
      </a>
    </section>

    <!-- GÖRÜNÜM: MASALAR -->
    <div id="tables-view" class="flex flex-col lg:flex-row gap-6">
      
      <!-- Sol: Masalar -->
      <div class="flex-1">
        <!-- Liste başlığı + masa oluştur -->
        <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
          <h2 class="font-headline-lg text-headline-lg text-primary">Masalar</h2>
          <button type="button" id="create-table-btn" class="px-5 py-2.5 bg-secondary-container text-white rounded-lg font-label-md text-label-md hover:opacity-90 transition-all flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">add_circle</span> Masa Olustur
          </button>
        </div>

        <!-- Masa kartları -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4" id="table-list-container">
          <!-- Boş masa durumu -->
          <div class="col-span-full bg-surface-container-low rounded-2xl border-2 border-dashed border-outline-variant/50 p-10 flex flex-col items-center justify-center text-center gap-3">
            <span class="material-symbols-outlined text-5xl text-primary/60">meeting_room</span>
            <h3 class="font-headline-sm text-on-surface">Şu An Açık Masa Bulunmuyor</h3>
            <p class="text-body-sm text-outline max-w-sm">Dilediğiniz bahis ve kurallar ile yeni bir masa oluşturarak hemen oyuna başlayabilirsiniz.</p>
            <button type="button" onclick="openCreateModal()" class="mt-2 px-6 py-3 bg-primary text-white rounded-xl font-label-md hover:bg-primary/90 transition-all shadow-md flex items-center gap-2 cursor-pointer">
              <span class="material-symbols-outlined text-sm">add_circle</span> Masa Oluştur
            </button>
          </div>
        </div>
      </div> <!-- /Sol Kısım -->

      <!-- Sağ: Aktif Oyuncular -->
      <aside class="w-full lg:w-72 xl:w-80 shrink-0">
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm overflow-hidden sticky top-6 flex flex-col max-h-[600px]">
          <div class="bg-primary text-white p-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-lg">group</span>
              <h3 class="font-headline-sm">Aktif Oyuncular</h3>
            </div>
            <span class="bg-secondary px-2.5 py-0.5 rounded-full text-xs font-bold shadow-sm" id="lobby-online-count">0</span>
          </div>
          <div class="p-4 flex-1 overflow-y-auto">
            <ul id="lobby-online-list" class="flex flex-col gap-3">
              <li class="text-center text-outline text-sm italic py-4">
                Sistemde henüz aktif<br/>oyuncu bulunmuyor.
              </li>
            </ul>
          </div>
        </div>
      </aside> <!-- /Sağ Kısım -->

    </div> <!-- /GÖRÜNÜM: MASALAR -->

    <!-- GÖRÜNÜM: ODA OLUŞTURMA (Gizli) -->
    <div id="create-room-view" hidden class="bg-white rounded-xl border border-outline-variant/30 shadow-sm p-6 lg:p-10 mb-6">
      
      <div class="flex items-center justify-between border-b border-outline-variant/30 pb-4 mb-8">
        <h2 class="font-headline-lg text-headline-lg text-primary flex items-center gap-2">
          <span class="material-symbols-outlined text-3xl">add_circle</span>
          Oda Oluştur
        </h2>
        <button type="button" id="create-cancel" class="flex items-center gap-1 text-on-surface-variant hover:text-primary font-label-md px-3 py-1.5 rounded-lg border border-silver-light hover:border-primary/50 transition-colors">
          <span class="material-symbols-outlined text-sm">close</span> Vazgeç
        </button>
      </div>

      <form id="create-room-form" class="flex flex-col lg:flex-row gap-12">
        
        <!-- Sol Kısım: Ayarlar -->
        <div class="flex-1 flex flex-col gap-8">
          
          <!-- 1. Bahis Miktarı -->
          <section>
            <h3 class="font-headline-md text-on-surface mb-4">1. Bahis Miktarı</h3>
            <% if (meta.bets && meta.bets.length > 0) { %>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <% meta.bets.forEach((bet, idx) => { %>
                  <label class="cursor-pointer">
                    <input type="radio" name="bet" value="<%= bet.value %>" class="peer hidden" <%= idx === 0 ? 'checked' : '' %> />
                    <div class="bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl p-4 text-center peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-all">
                      <div class="font-label-lg text-primary mb-1"><%= bet.amount %></div>
                      <div class="text-label-sm text-outline uppercase tracking-wider"><%= bet.label %></div>
                    </div>
                  </label>
                <% }) %>
              </div>
            <% } else { %>
              <!-- Manual Bet Input -->
              <div class="relative w-full md:w-2/3">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-2xl">payments</span>
                <input type="number" name="manual_bet" min="1" placeholder="Ücreti girin (Örn: 500)" class="w-full pl-14 pr-4 py-4 border-2 border-outline-variant/30 rounded-xl outline-none focus:border-primary focus:bg-primary/5 font-headline-sm transition-all text-on-surface" required />
              </div>
            <% } %>
          </section>

          <!-- 2. Oyun Modu -->
          <section>
            <h3 class="font-headline-md text-on-surface mb-4">2. Oyun Modu</h3>
            <div class="grid grid-cols-2 gap-3">
              <% if (meta.modes && meta.modes.length > 0) { %>
                <% meta.modes.forEach(mode => { %>
                  <label class="cursor-pointer">
                    <input type="radio" name="mode" value="<%= mode.id %>" class="peer hidden" <%= mode.default ? 'checked' : '' %> />
                    <div class="bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl p-4 flex items-center gap-3 peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-all">
                      <span class="material-symbols-outlined text-primary peer-checked:fill-primary"><%= mode.id === 'esli' ? 'group' : 'person' %></span>
                      <span class="font-label-md text-on-surface"><%= mode.label %></span>
                    </div>
                  </label>
                <% }) %>
              <% } else { %>
                <div class="col-span-2 text-outline text-body-sm italic">Oyun modu seçenekleri bulunamadı.</div>
              <% } %>
            </div>
          </section>

          <!-- 3. Oyun Kuralları -->
          <section>
            <h3 class="font-headline-md text-on-surface mb-4">3. Oyun Kuralları</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <% if (meta.rules && meta.rules.length > 0) { %>
                <% meta.rules.forEach((rule, i) => { %>
                  <% if (rule.type === 'toggle') { %>
                    <label class="cursor-pointer flex items-center justify-between bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl p-4 hover:border-primary/50 transition-all">
                      <span class="font-label-md text-on-surface"><%= rule.label %></span>
                      <div class="relative inline-block w-12 h-6">
                        <input type="checkbox" name="rules[]" value="<%= rule.id %>" class="peer sr-only" <%= rule.default ? 'checked' : '' %> />
                        <div class="w-full h-full bg-outline-variant/50 peer-checked:bg-primary rounded-full transition-colors duration-300"></div>
                        <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform duration-300 peer-checked:translate-x-6 shadow-sm"></div>
                      </div>
                    </label>
                  <% } else if (rule.type === 'radio') { %>
                    <label class="cursor-pointer">
                      <input type="radio" name="rule_<%= rule.group %>" value="<%= rule.id %>" class="peer hidden" <%= rule.default ? 'checked' : '' %> />
                      <div class="bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl p-3 flex items-center justify-between peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-all">
                        <span class="font-label-md text-on-surface"><%= rule.label %></span>
                        <span class="material-symbols-outlined text-primary opacity-0 peer-checked:opacity-100 transition-opacity">check_circle</span>
                      </div>
                    </label>
                  <% } else { %>
                    <label class="cursor-pointer">
                      <input type="checkbox" name="rules[]" value="<%= rule.id %>" class="peer hidden" <%= rule.default ? 'checked' : '' %> />
                      <div class="bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl p-3 flex items-center justify-between peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-all">
                        <span class="font-label-md text-on-surface"><%= rule.label %></span>
                        <span class="material-symbols-outlined text-primary opacity-0 peer-checked:opacity-100 transition-opacity">check_box</span>
                      </div>
                    </label>
                  <% } %>
                <% }) %>
              <% } else { %>
                <div class="col-span-2 text-outline text-body-sm italic p-2">Kurallar tanımlanmamış.</div>
              <% } %>
            </div>
          </section>

          <!-- 4. Oda Gizliliği -->
          <section>
            <h3 class="font-headline-md text-on-surface mb-4">4. Oda Gizliliği</h3>
            <div class="bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl p-5 flex flex-col gap-4">
              <div class="grid grid-cols-2 gap-3">
                <label class="cursor-pointer">
                  <input type="radio" name="privacy" value="public" class="peer hidden" checked onchange="document.getElementById('password-wrapper').classList.add('hidden')" />
                  <div class="border-2 border-transparent rounded-lg p-3 text-center peer-checked:border-primary peer-checked:bg-primary/5 transition-all">
                    <span class="material-symbols-outlined mb-1 block text-primary">public</span>
                    <span class="font-label-sm text-on-surface block">Açık Oda</span>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="privacy" value="private" class="peer hidden" onchange="document.getElementById('password-wrapper').classList.remove('hidden')" />
                  <div class="border-2 border-transparent rounded-lg p-3 text-center peer-checked:border-primary peer-checked:bg-primary/5 transition-all">
                    <span class="material-symbols-outlined mb-1 block text-primary">lock</span>
                    <span class="font-label-sm text-on-surface block">Şifreli Oda</span>
                  </div>
                </label>
              </div>
              <div id="password-wrapper" class="hidden space-y-2 mt-2 pt-4 border-t border-outline-variant/30">
                <label class="block font-label-sm text-on-surface-variant">Oda Şifresi</label>
                <div class="relative">
                  <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">key</span>
                  <input type="text" name="password" placeholder="Şifre belirleyin" class="w-full pl-10 pr-4 py-2.5 border border-silver-light rounded-lg outline-none focus:ring-2 focus:ring-primary" />
                </div>
              </div>
            </div>
          </section>

          <!-- 5. Masa Adı (VIP Özel) -->
          <section>
            <h3 class="font-headline-md text-on-surface mb-4">5. Masa Adı</h3>
            <% if (user.vip_tier > 0) { %>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-energetic-purple text-xl">workspace_premium</span>
                <input type="text" name="title" placeholder="Özel Masa Adı Girin (Örn: Şampiyonlar Masası)" class="w-full pl-11 pr-4 py-3 bg-energetic-purple/5 border-2 border-energetic-purple/40 rounded-xl outline-none focus:border-energetic-purple font-label-md text-on-surface transition-all" />
              </div>
              <p class="text-xs text-energetic-purple font-semibold mt-1.5 flex items-center gap-1">
                <span>👑</span> VIP üye olduğunuz için özel masa adı belirleyebilirsiniz.
              </p>
            <% } else { %>
              <div class="relative opacity-70">
                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-xl">lock</span>
                <input type="text" disabled placeholder="Masa Adı Otomatik Belirlenir (Örn: Masa #1)" class="w-full pl-11 pr-4 py-3 bg-surface-container border border-outline-variant/30 rounded-xl text-outline font-label-md cursor-not-allowed" />
              </div>
              <p class="text-xs text-outline mt-1.5 flex items-center gap-1">
                <span class="material-symbols-outlined text-xs">info</span> Masa adı sıradaki numaraya göre otomatik verilir. Özel isim için VIP üye olun.
              </p>
            <% } %>
          </section>

          <!-- Oluştur Butonu -->
          <button type="button" id="create-confirm-btn" class="w-full py-4 bg-primary text-white rounded-xl font-headline-md text-title-md hover:bg-primary/90 transition-all shadow-md mt-4 flex items-center justify-center gap-2">
            <span class="material-symbols-outlined">play_arrow</span>
            Masayı Oluştur ve Otur
          </button>

        </div> <!-- /Sol Kısım -->

        <!-- Sağ Kısım: Nasıl Oynanır -->
        <div class="hidden lg:flex flex-col w-1/3">
          <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm overflow-hidden sticky top-24">
            <div class="bg-primary text-white p-4 flex items-center gap-2">
              <span class="material-symbols-outlined text-lg">info</span>
              <h3 class="font-headline-sm">Nasıl Oynanır?</h3>
            </div>
            <div class="p-4">
              <% if (meta.howToPlay && meta.howToPlay.length > 0) { %>
                <ul class="space-y-4">
                  <% meta.howToPlay.forEach((step, i) => { %>
                    <li class="flex gap-3 items-start">
                      <span class="w-6 h-6 shrink-0 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-sm"><%= i+1 %></span>
                      <p class="text-body-sm text-on-surface leading-snug pt-0.5"><%= step %></p>
                    </li>
                  <% }) %>
                </ul>
              <% } else { %>
                <p class="text-body-sm text-outline italic">Nasıl oynanır bilgisi bulunamadı.</p>
              <% } %>
            </div>
          </div>
        </div> <!-- /Sağ Kısım -->

      </form>
    </div> <!-- /GÖRÜNÜM: ODA OLUŞTURMA -->
  </main>
  <!-- ===== Lobby Chat Panel ===== -->
  <aside id="lobby-chatpanel" class="fixed bottom-0 left-0 right-0 w-full h-64 bg-surface flex flex-col shadow-[0_-4px_20px_rgba(0,0,0,0.05)] border-t border-outline-variant/30 z-50">
    <div class="flex border-b border-outline-variant/30 px-2 bg-surface-container-lowest">
      <button id="chat-tab-sistem" class="relative px-4 py-3 font-label-md text-on-surface-variant border-b-2 border-transparent hover:text-primary transition-colors">
        Sistem Mesajı
        <span class="chat-badge hidden absolute top-3 right-1 w-2 h-2 bg-error rounded-full"></span>
      </button>
      <button id="chat-tab-lobi" class="relative px-4 py-3 font-label-md text-primary border-b-2 border-primary transition-colors">
        Lobi Mesajı
        <span class="chat-badge hidden absolute top-3 right-1 w-2 h-2 bg-error rounded-full"></span>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto p-3 bg-surface-container-lowest flex flex-col gap-2" id="chat-messages">
      <!-- Mesajlar JS ile buraya eklenecek -->
    </div>
    <form id="chat-form" class="flex gap-2 p-3 bg-surface border-t border-outline-variant/30">
      <input type="text" id="chat-input" class="flex-1 bg-surface-container-lowest border border-outline-variant/30 rounded-lg px-3 py-2 text-on-surface outline-none focus:border-primary transition-colors text-body-sm" placeholder="Bir mesaj yazın..." autocomplete="off">
      <button type="submit" class="bg-primary text-on-primary px-4 py-2 rounded-lg font-label-md hover:bg-primary/90 transition-colors">Gönder</button>
    </form>
  </aside>

  <%- include('partials/theme-foot', { user: user }) %>
  <script>window.LOBBY_GAME_ID = 'salon_' + '<%= meta.slug %>';</script>
  <script src="/js/lobby.js"></script>
  
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (!window.lobbySocket) return;
      
      var gameId = window.LOBBY_GAME_ID || 'lobby';
      var socket = window.lobbySocket;
      
      var chatMessages = document.getElementById('chat-messages');
      var chatForm = document.getElementById('chat-form');
      var chatInput = document.getElementById('chat-input');
      
      var tabSistem = document.getElementById('chat-tab-sistem');
      var tabLobi = document.getElementById('chat-tab-lobi');
      
      var currentTab = 'lobi'; // 'lobi' or 'sistem'
      
      var messagesByTab = {
        sistem: [],
        lobi: []
      };
      
      function formatTime(isoLike) {
        try {
          var d = new Date(String(isoLike).replace(' ', 'T') + 'Z');
          if (isNaN(d.getTime())) return '';
          return d.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
        } catch (e) { return ''; }
      }
      
      function escapeHtml(str) {
        var div = document.createElement('div');
        div.textContent = str == null ? '' : String(str);
        return div.innerHTML;
      }
      
      function renderMessages() {
        if (!chatMessages) return;
        var msgs = messagesByTab[currentTab];
        chatMessages.innerHTML = msgs.map(function(m) {
          if (currentTab === 'sistem') {
            return '<div class="text-on-surface-variant italic text-body-sm bg-surface-container rounded p-2 border border-outline-variant/30">' + escapeHtml(m.content) + '</div>';
          } else {
            return '<div class="flex flex-col mb-1">' +
                     '<div class="flex items-center justify-between">' +
                       '<span class="font-label-sm text-primary">' + escapeHtml(m.username) + '</span>' +
                       '<span class="text-[10px] text-outline">' + formatTime(m.created_at) + '</span>' +
                     '</div>' +
                     '<div class="text-body-sm text-on-surface">' + escapeHtml(m.content) + '</div>' +
                   '</div>';
          }
        }).join('');
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }
      
      function switchTab(tab) {
        currentTab = tab;
        if (tab === 'sistem') {
          tabSistem.classList.add('text-primary', 'border-primary');
          tabSistem.classList.remove('text-on-surface-variant', 'border-transparent');
          tabLobi.classList.remove('text-primary', 'border-primary');
          tabLobi.classList.add('text-on-surface-variant', 'border-transparent');
          chatInput.disabled = true;
          chatInput.placeholder = 'Sistem kanalına yazılamaz...';
        } else {
          tabLobi.classList.add('text-primary', 'border-primary');
          tabLobi.classList.remove('text-on-surface-variant', 'border-transparent');
          tabSistem.classList.remove('text-primary', 'border-primary');
          tabSistem.classList.add('text-on-surface-variant', 'border-transparent');
          chatInput.disabled = false;
          chatInput.placeholder = 'Bir mesaj yazın...';
        }
        document.querySelector('#chat-tab-' + tab + ' .chat-badge').classList.add('hidden');
        renderMessages();
      }
      
      tabSistem.addEventListener('click', function() { switchTab('sistem'); });
      tabLobi.addEventListener('click', function() { switchTab('lobi'); });
      
      socket.on('chat:history', function(history) {
        // history[gameId] has messages for this game
        if (history && history[gameId]) {
          messagesByTab.lobi = history[gameId];
        }
        if (history && history.sistem) {
          messagesByTab.sistem = history.sistem;
        }
        renderMessages();
      });
      
      socket.on('chat:message', function(msg) {
        if (!msg) return;
        var tab = msg.channel === 'sistem' ? 'sistem' : 'lobi';
        
        // Ensure we only accept messages for our channel (gameId) or sistem
        if (msg.channel !== 'sistem' && msg.channel !== gameId) return;
        
        messagesByTab[tab].push(msg);
        if (messagesByTab[tab].length > 200) messagesByTab[tab].shift();
        
        if (currentTab === tab) {
          renderMessages();
        } else {
          document.querySelector('#chat-tab-' + tab + ' .chat-badge').classList.remove('hidden');
        }
      });
      
      if (chatForm) {
        chatForm.addEventListener('submit', function(e) {
          e.preventDefault();
          var text = chatInput.value.trim();
          if (!text || currentTab === 'sistem') return;
          socket.emit('chat:message', { channel: gameId, text: text });
          chatInput.value = '';
        });
      }

      // ---- User-Created Rooms Renderer ----
      var tableListContainer = document.getElementById('table-list-container');
      
      function renderRoomsList(rooms) {
        if (!tableListContainer) return;
        if (!rooms || !rooms.length) {
          tableListContainer.innerHTML = 
            '<div class="col-span-full bg-surface-container-low rounded-2xl border-2 border-dashed border-outline-variant/50 p-10 flex flex-col items-center justify-center text-center gap-3">' +
              '<span class="material-symbols-outlined text-5xl text-primary/60">meeting_room</span>' +
              '<h3 class="font-headline-sm text-on-surface">Şu An Açık Masa Bulunmuyor</h3>' +
              '<p class="text-body-sm text-outline max-w-sm">Dilediğiniz bahis ve kurallar ile yeni bir masa oluşturarak hemen oyuna başlayabilirsiniz.</p>' +
              '<button type="button" onclick="openCreateModal()" class="mt-2 px-6 py-3 bg-primary text-white rounded-xl font-label-md hover:bg-primary/90 transition-all shadow-md flex items-center gap-2 cursor-pointer">' +
                '<span class="material-symbols-outlined text-sm">add_circle</span> Masa Oluştur' +
              '</button>' +
            '</div>';
          return;
        }

        tableListContainer.innerHTML = rooms.map(function(room) {
          var isFull = room.seatedCount >= (room.seatCount || 4);
          var stake = Number(room.stake || 500).toLocaleString('tr-TR') + ' LT';

          var avatarsHtml = room.seats.map(function(s) {
            if (!s) {
              return '<span class="w-9 h-9 rounded-full border-2 border-dashed border-outline-variant/60 flex items-center justify-center text-xs text-outline font-semibold">Boş</span>';
            }
            var initial = escapeHtml((s.name || '?').charAt(0).toUpperCase());
            return '<span class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm shadow-sm" title="' + escapeHtml(s.name) + '">' + initial + '</span>';
          }).join('');

          var statusText = isFull ? 'Dolu (4/4)' : room.seatedCount + '/' + (room.seatCount || 4) + ' Oyuncu';
          var statusColor = isFull ? 'text-error font-bold' : 'text-primary font-bold';

          var isPrivate = room.privacy === 'private';
          var titleIcon = isPrivate ? '<span class="material-symbols-outlined text-amber-500 text-base" title="Şifreli Masa">lock</span>' : '<span class="material-symbols-outlined text-primary text-base">table_restaurant</span>';
          
          var actionBtnHtml = isPrivate 
            ? '<button type="button" onclick="openJoinPasswordModal(\'' + escapeHtml(room.id) + '\')" class="px-5 py-2 bg-amber-600 text-white rounded-xl font-label-md text-label-sm hover:bg-amber-700 transition-all shadow-md flex items-center gap-1.5 cursor-pointer">' +
                '<span class="material-symbols-outlined text-sm">lock</span> ' + (isFull ? 'İzle' : 'Otur') +
              '</button>'
            : '<a href="<%= meta.playUrl %>?roomId=' + encodeURIComponent(room.id) + '&autoSit=true" class="px-5 py-2 bg-primary text-white rounded-xl font-label-md text-label-sm hover:bg-primary/90 transition-all shadow-md flex items-center gap-1.5 cursor-pointer">' +
                '<span class="material-symbols-outlined text-sm">login</span> ' + (isFull ? 'İzle' : 'Otur') +
              '</a>';

          var badgesHtml = '<div class="flex gap-1.5 flex-wrap mt-2">';
          if (room.gameMode) {
             var modeLabel = room.gameMode === 'esli' ? 'Eşli' : (room.gameMode === 'solo' || room.gameMode === 'tekli' ? 'Tekli' : room.gameMode);
             var modeIcon = (modeLabel === 'Eşli' || modeLabel === 'esli') ? 'group' : 'person';
             badgesHtml += '<span class="px-2 py-0.5 bg-surface-variant text-on-surface-variant rounded-md text-[10px] font-bold tracking-wider flex items-center gap-1"><span class="material-symbols-outlined text-[12px]">' + modeIcon + '</span> ' + escapeHtml(modeLabel) + '</span>';
          }
          if (room.gameType) {
             var typeLabel = room.gameType === 'katlamali' ? 'Katlamalı' : (room.gameType === 'katlamasiz' ? 'Katlamasız' : room.gameType);
             badgesHtml += '<span class="px-2 py-0.5 bg-surface-variant text-on-surface-variant rounded-md text-[10px] font-bold tracking-wider">' + escapeHtml(typeLabel) + '</span>';
          }
          badgesHtml += '</div>';

          return (
            '<div class="bg-white rounded-2xl border border-outline-variant/30 shadow-md p-5 flex flex-col gap-4 hover:shadow-lg transition-all">' +
              '<div class="flex items-center justify-between">' +
                '<div>' +
                  '<span class="font-headline-md text-primary font-bold text-lg flex items-center gap-2">' + titleIcon + ' ' + escapeHtml(room.title) + '</span>' +
                  badgesHtml +
                '</div>' +
                '<span class="px-3 py-1 bg-amber-500/15 text-amber-700 rounded-full font-label-md text-xs font-extrabold shrink-0">' + stake + '</span>' +
              '</div>' +
              '<div class="flex gap-2 items-center py-2">' + avatarsHtml + '</div>' +
              '<div class="flex items-center justify-between pt-3 border-t border-outline-variant/20">' +
                '<span class="text-label-sm ' + statusColor + '">' + statusText + '</span>' +
                actionBtnHtml +
              '</div>' +
            '</div>'
          );
        }).join('');
      }

      socket.on('rooms:list', renderRoomsList);
      socket.emit('rooms:get', '<%= meta.slug %>');
    });
  </script>

  <!-- ===== Şifreli Masa Giriş Modalı ===== -->
  <div id="join-password-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl border border-outline-variant/30 shadow-2xl max-w-sm w-full p-6 flex flex-col gap-4">
      <div class="flex items-center justify-between border-b border-outline-variant/20 pb-3">
        <h3 class="font-headline-sm text-primary flex items-center gap-2 font-bold">
          <span class="material-symbols-outlined text-amber-500">lock</span> Şifreli Masa Girişi
        </h3>
        <button type="button" onclick="closeJoinPasswordModal()" class="text-outline hover:text-on-surface cursor-pointer">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <p class="text-body-sm text-outline">Bu masa şifrelidir. Masaya oturmak için oda şifresini girin:</p>
      <input type="hidden" id="pass-modal-room-id" />
      <div class="relative">
        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline">key</span>
        <input type="password" id="pass-modal-input" placeholder="Oda Şifresi" class="w-full pl-11 pr-4 py-3 border border-outline-variant/40 rounded-xl outline-none focus:border-primary font-label-md" />
      </div>
      <div id="pass-modal-error" class="hidden text-error text-xs font-bold bg-error/10 p-2.5 rounded-lg border border-error/20"></div>
      <div class="flex gap-3 justify-end mt-2">
        <button type="button" onclick="closeJoinPasswordModal()" class="px-4 py-2.5 bg-surface-container text-on-surface-variant rounded-xl font-label-md hover:bg-surface-container-high cursor-pointer">İptal</button>
        <button type="button" id="pass-modal-submit" class="px-5 py-2.5 bg-primary text-white rounded-xl font-label-md hover:bg-primary/90 flex items-center gap-1.5 shadow-md cursor-pointer">
          <span class="material-symbols-outlined text-sm">login</span> Giriş Yap
        </button>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var tablesView = document.getElementById('tables-view');
      var createView = document.getElementById('create-room-view');
      
      function openCreate() { 
        tablesView.hidden = true; 
        createView.hidden = false; 
        createView.scrollIntoView({ behavior: 'smooth', block: 'start' }); 
      }
      
      function closeCreate() { 
        createView.hidden = true; 
        tablesView.hidden = false; 
      }
      
      window.openCreateModal = openCreate;

      document.getElementById('create-table-btn').addEventListener('click', openCreate);
      var btn2 = document.getElementById('create-table-btn-2');
      if (btn2) btn2.addEventListener('click', openCreate);
      document.getElementById('create-cancel').addEventListener('click', closeCreate);
      
      window.openJoinPasswordModal = function (roomId) {
        document.getElementById('pass-modal-room-id').value = roomId;
        document.getElementById('pass-modal-input').value = '';
        document.getElementById('pass-modal-error').classList.add('hidden');
        document.getElementById('join-password-modal').classList.remove('hidden');
      };

      window.closeJoinPasswordModal = function () {
        document.getElementById('join-password-modal').classList.add('hidden');
      };

      var passSubmitBtn = document.getElementById('pass-modal-submit');
      if (passSubmitBtn) {
        passSubmitBtn.addEventListener('click', async function () {
          var roomId = document.getElementById('pass-modal-room-id').value;
          var password = document.getElementById('pass-modal-input').value;
          var errEl = document.getElementById('pass-modal-error');
          errEl.classList.add('hidden');
          if (!password) {
            errEl.textContent = 'Lütfen masa şifresini girin!';
            errEl.classList.remove('hidden');
            return;
          }
          try {
            passSubmitBtn.disabled = true;
            var res = await fetch('/api/rooms/verify-password', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ roomId: roomId, password: password })
            });
            var data = await res.json();
            if (data.ok && data.playUrl) {
              window.location.href = data.playUrl;
            } else {
              errEl.textContent = data.error || 'Girdiğiniz şifre hatalı!';
              errEl.classList.remove('hidden');
              passSubmitBtn.disabled = false;
            }
          } catch (err) {
            errEl.textContent = 'Sunucu bağlantı hatası!';
            errEl.classList.remove('hidden');
            passSubmitBtn.disabled = false;
          }
        });
      }

      var confirmBtn = document.getElementById('create-confirm-btn');
      if (confirmBtn) {
        confirmBtn.addEventListener('click', async function (e) {
          e.preventDefault();
          var form = document.getElementById('create-room-form');
          var formData = new FormData(form);
          var selectedBet = formData.get('bet') || formData.get('manual_bet') || 500;
          var selectedMode = formData.get('mode') || 'solo';
          var selectedPrivacy = formData.get('privacy') || 'public';
          var selectedPassword = formData.get('password') || '';
          var selectedTitle = formData.get('title') || '';
          var selectedRules = formData.getAll('rules[]');

          try {
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<span class="material-symbols-outlined animate-spin">progress_activity</span> Masa Oluşturuluyor...';

            var response = await fetch('/api/rooms/create', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                game: '<%= meta.slug %>',
                bet: selectedBet,
                mode: selectedMode,
                privacy: selectedPrivacy,
                password: selectedPassword,
                title: selectedTitle,
                rules: selectedRules
              })
            });
            var data = await response.json();
            if (data.ok && data.playUrl) {
              window.location.href = data.playUrl;
            } else {
              alert(data.error || 'Masa oluşturulurken bir hata oluştu.');
              confirmBtn.disabled = false;
              confirmBtn.innerHTML = '<span class="material-symbols-outlined">play_arrow</span> Masayı Oluştur ve Otur';
            }
          } catch (err) {
            console.error('Masa oluşturma hatası:', err);
            alert('Sunucu hatası. Lütfen tekrar deneyin.');
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = '<span class="material-symbols-outlined">play_arrow</span> Masayı Oluştur ve Otur';
          }
        });
      }
    })();
  </script>
</body>
</html>
