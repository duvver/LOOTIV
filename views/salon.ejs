<!DOCTYPE html>
<html class="light" lang="tr">
<head>
  <%- include('partials/theme-head', { pageTitle: meta.name + ' — LOOTIV' }) %>
  <% if (meta.slug) { %>
    <link rel="stylesheet" href="/css/<%= meta.slug %>.css?v=1" />
  <% } %>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col">

  <%- include('partials/theme-nav', { active: 'oyunlar', user: user, unreadCount: typeof unreadCount !== 'undefined' ? unreadCount : 0 }) %>

  <main class="flex-grow max-w-container-max mx-auto w-full px-margin-mobile md:px-margin-desktop py-8 pb-[270px]">
    <a href="/" id="ana-sayfa-link" class="text-primary font-label-md hover:underline flex items-center gap-1 mb-4"><span class="material-symbols-outlined text-sm">arrow_back</span> Ana Sayfa</a>

    <!-- Oyun başlığı hero -->
    <section class="relative rounded-xl overflow-hidden bg-primary text-white mb-8 p-8 flex items-center gap-5" style="background-image: linear-gradient(120deg, #1d3246, <%= meta.accent %>);">
      <span class="w-16 h-16 rounded-xl bg-white/10 flex items-center justify-center text-4xl"><%- meta.icon %></span>
      <div>
        <h1 class="font-headline-lg text-headline-lg"><%= meta.name %></h1>
        <p class="font-body-md text-white/80"><%= meta.desc %></p>
      </div>
      <button type="button" onclick="openCreateModal()" class="ml-auto hidden sm:flex items-center gap-2 bg-secondary-container text-white px-6 py-3 rounded-lg font-headline-md hover:brightness-110 transition-all cursor-pointer border-0">
        <span class="material-symbols-outlined">play_arrow</span> Hemen Oyna
      </button>
    </section>

    <!-- GÖRÜNÜM: MASALAR -->
    <div id="tables-view" class="flex flex-col lg:flex-row gap-6">
      
      <!-- Sol: Masalar -->
      <div class="flex-1">
        <!-- Liste başlığı + masa oluştur -->
        <div class="flex items-center justify-between mb-6 flex-wrap gap-3 border-b border-outline-variant/30 pb-2">
          <div class="flex gap-4 items-end">
            <!-- Lobi Tab -->
            <button id="spa-tab-lobi" onclick="showLobby()" class="font-headline-lg text-headline-lg text-primary border-b-2 border-primary pb-1 px-2 transition-all cursor-pointer">Lobi</button>
            <!-- Masa Tab (Hidden by default) -->
            <button id="spa-tab-masa" onclick="showGame()" class="hidden font-headline-lg text-headline-md text-on-surface-variant hover:text-primary border-b-2 border-transparent hover:border-primary pb-1 px-2 transition-all flex items-center gap-2 cursor-pointer">
              Masa <span id="active-masa-id"></span>
              <span class="material-symbols-outlined text-sm hover:text-error cursor-pointer" onclick="leaveTable(event)">close</span>
            </button>
          </div>
          <button type="button" id="create-table-btn" class="px-5 py-2.5 bg-secondary-container text-white rounded-lg font-label-md text-label-md hover:opacity-90 transition-all flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">add_circle</span> Masa Olustur
          </button>
        </div>

        <!-- Filter Bar -->
        <div id="filter-bar" class="flex flex-wrap items-center gap-3 mb-4 p-3 bg-surface-container-lowest rounded-xl border border-outline-variant/30">
          <!-- Search -->
          <div class="relative flex-1 min-w-[180px]">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-lg">search</span>
            <input type="text" id="filter-search" placeholder="Masa veya kurucu ara..." class="w-full pl-10 pr-3 py-2 bg-surface border border-outline-variant/30 rounded-lg text-body-sm text-on-surface focus:outline-none focus:border-primary transition-colors" />
          </div>
          <!-- Stake Filter -->
          <div class="flex gap-1.5 flex-wrap">
            <button type="button" data-stake="all" class="filter-stake-btn px-3 py-1.5 rounded-full text-label-sm font-bold bg-primary text-white transition-all">Tümü</button>
            <button type="button" data-stake="500" class="filter-stake-btn px-3 py-1.5 rounded-full text-label-sm font-bold bg-surface-container text-on-surface-variant hover:bg-primary/10 transition-all">≤500</button>
            <button type="button" data-stake="2500" class="filter-stake-btn px-3 py-1.5 rounded-full text-label-sm font-bold bg-surface-container text-on-surface-variant hover:bg-primary/10 transition-all">≤2.5K</button>
            <button type="button" data-stake="10000" class="filter-stake-btn px-3 py-1.5 rounded-full text-label-sm font-bold bg-surface-container text-on-surface-variant hover:bg-primary/10 transition-all">≤10K</button>
            <button type="button" data-stake="50000" class="filter-stake-btn px-3 py-1.5 rounded-full text-label-sm font-bold bg-surface-container text-on-surface-variant hover:bg-primary/10 transition-all">>10K</button>
          </div>
          <!-- Mode Filter -->
          <select id="filter-mode" class="px-3 py-2 bg-surface border border-outline-variant/30 rounded-lg text-body-sm text-on-surface focus:outline-none focus:border-primary">
            <option value="all">Mod: Tümü</option>
            <option value="Tek">Tekli</option>
            <option value="Eşli">Eşli</option>
          </select>
          <!-- Available Seats Toggle -->
          <label class="flex items-center gap-2 cursor-pointer px-3 py-2 bg-surface border border-outline-variant/30 rounded-lg hover:border-primary/50 transition-colors">
            <input type="checkbox" id="filter-available" class="accent-primary w-4 h-4" />
            <span class="text-body-sm text-on-surface whitespace-nowrap">Boş Koltuk</span>
          </label>
          <!-- Sort -->
          <select id="filter-sort" class="px-3 py-2 bg-surface border border-outline-variant/30 rounded-lg text-body-sm text-on-surface focus:outline-none focus:border-primary">
            <option value="stake-asc">Bahis ↑</option>
            <option value="stake-desc">Bahis ↓</option>
            <option value="seats-desc">Boş Koltuk ↑</option>
          </select>
        </div>

        <!-- Masa kartları -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4" id="table-list-container">
          <!-- Boş masa durumu -->
          <div class="col-span-full bg-surface-container-low rounded-2xl border-2 border-dashed border-outline-variant/50 p-10 flex flex-col items-center justify-center text-center gap-3">
            <span class="material-symbols-outlined text-5xl text-primary/60">meeting_room</span>
            <h3 class="font-headline-sm text-on-surface">Şu An Açık Masa Bulunmuyor</h3>
            <p class="text-body-sm text-outline max-w-sm">Dilediğiniz bahis ve kurallar ile yeni bir masa oluşturarak hemen oyuna başlayabilirsiniz.</p>
            <button type="button" onclick="openCreateModal()" class="mt-2 px-6 py-3 bg-primary text-white rounded-xl font-label-md hover:bg-primary/90 transition-all shadow-md flex items-center gap-2 cursor-pointer">
              <span class="material-symbols-outlined text-sm">add_circle</span> Masa Oluştur
            </button>
          </div>
        </div>

        <!-- OYUN ALANI (Gizli Başlar) -->
        <div id="game-container" class="hidden w-full h-full min-h-[600px] bg-surface-container-lowest rounded-xl border border-outline-variant/30 relative">
          <% if (meta.slug) { %>
            <%- include(meta.slug) %>
          <% } %>
        </div>
      </div> <!-- /Sol Kısım -->

      <!-- Sağ: Sidebar (Stats, Leaderboard, Recent Games, Aktif Oyuncular) -->
      <aside id="sidebar-section" class="w-full lg:w-72 xl:w-80 shrink-0 flex flex-col gap-4">
        
        <!-- Oyuncu İstatistikleri -->
        <% if (userStats) { %>
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm p-4">
          <h3 class="font-headline-sm text-on-surface mb-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">analytics</span> İstatistiklerim
          </h3>
          <div class="grid grid-cols-2 gap-2">
            <div class="text-center p-2 bg-surface rounded-lg">
              <div class="font-headline-sm text-primary"><%= userStats.kazanilan_oyun %></div>
              <div class="text-[10px] text-outline">Kazanılan</div>
            </div>
            <div class="text-center p-2 bg-surface rounded-lg">
              <div class="font-headline-sm text-error"><%= userStats.kaybedilen_oyun %></div>
              <div class="text-[10px] text-outline">Kaybedilen</div>
            </div>
            <div class="text-center p-2 bg-surface rounded-lg">
              <div class="font-headline-sm text-on-surface"><%= userStats.toplam_oyun %></div>
              <div class="text-[10px] text-outline">Toplam Oyun</div>
            </div>
            <div class="text-center p-2 bg-surface rounded-lg">
              <div class="font-headline-sm text-amber-600"><%= Number(userStats.en_yuksek_kazanc).toLocaleString('tr-TR') %></div>
              <div class="text-[10px] text-outline">En Yüksek</div>
            </div>
          </div>
          <!-- Win rate bar -->
          <div class="mt-3">
            <div class="flex justify-between text-[10px] mb-1">
              <span class="text-outline">Kazanma Oranı</span>
              <span class="text-primary font-bold"><%= userStats.toplam_oyun > 0 ? Math.round((userStats.kazanilan_oyun / userStats.toplam_oyun) * 100) : 0 %>%</span>
            </div>
            <div class="w-full h-1.5 bg-surface-variant rounded-full overflow-hidden">
              <div class="h-full bg-primary rounded-full" style="width: <%= userStats.toplam_oyun > 0 ? (userStats.kazanilan_oyun / userStats.toplam_oyun * 100) : 0 %>%"></div>
            </div>
          </div>
        </div>
        <% } %>

        <!-- Mini Leaderboard -->
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm p-4">
          <h3 class="font-headline-sm text-on-surface mb-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-amber-500">leaderboard</span> Lider Tablosu
          </h3>
          <div id="leaderboard-list" class="space-y-1">
            <div class="text-center text-outline text-xs py-2">Yükleniyor...</div>
          </div>
        </div>

        <!-- Son Oyunlarım -->
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm p-4">
          <h3 class="font-headline-sm text-on-surface mb-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">history</span> Son Oyunlarım
          </h3>
          <div id="recent-games-list" class="space-y-1">
            <div class="text-center text-outline text-xs py-2">Yükleniyor...</div>
          </div>
        </div>

        <!-- Aktif Oyuncular -->
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm overflow-hidden flex flex-col max-h-[400px]">
          <div class="bg-primary text-white p-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-base">group</span>
              <h3 class="font-headline-sm">Lobi</h3>
            </div>
            <span class="bg-secondary px-2 py-0.5 rounded-full text-xs font-bold shadow-sm" id="lobby-online-count">0</span>
          </div>
          <div class="p-3 flex-1 overflow-y-auto">
            <ul id="lobby-online-list" class="flex flex-col gap-2">
              <li class="text-center text-outline text-xs italic py-2">
                Henüz aktif oyuncu yok.
              </li>
            </ul>
          </div>
        </div>

      </aside> <!-- /Sağ Kısım -->

    </div> <!-- /GÖRÜNÜM: MASALAR -->

    <!-- GÖRÜNÜM: ODA OLUŞTURMA (Gizli) -->
    <div id="create-room-view" hidden class="bg-white rounded-xl border border-outline-variant/30 shadow-sm p-6 lg:p-10 mb-6">
      
      <div class="flex items-center justify-between border-b border-outline-variant/30 pb-4 mb-8">
        <h2 class="font-headline-lg text-headline-lg text-primary flex items-center gap-2">
          <span class="material-symbols-outlined text-3xl">add_circle</span>
          Oda Oluştur
        </h2>
        <button type="button" id="create-cancel" class="flex items-center gap-1 text-on-surface-variant hover:text-primary font-label-md px-3 py-1.5 rounded-lg border border-silver-light hover:border-primary/50 transition-colors">
          <span class="material-symbols-outlined text-sm">close</span> Vazgeç
        </button>
      </div>

      <form id="create-room-form" class="flex flex-col lg:flex-row gap-12">
        
        <!-- Sol Kısım: Ayarlar -->
        <div class="flex-1 flex flex-col gap-8">
          
          <!-- Bahis Miktarı -->
          <section>
            <h3 class="font-headline-md text-on-surface mb-4">Bahis Miktarı</h3>
            <% if (meta.bets && meta.bets.length > 0) { %>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <% meta.bets.forEach((bet, idx) => { %>
                  <label class="cursor-pointer">
                    <input type="radio" name="bet" value="<%= bet.value %>" class="peer hidden" <%= idx === 0 ? 'checked' : '' %> />
                    <div class="bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl p-4 text-center peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-all">
                      <div class="font-label-lg text-primary mb-1"><%= bet.amount %></div>
                      <div class="text-label-sm text-outline uppercase tracking-wider"><%= bet.label %></div>
                    </div>
                  </label>
                <% }) %>
              </div>
            <% } else { %>
              <!-- Manual Bet Input -->
              <div class="relative w-full md:w-2/3">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-2xl">payments</span>
                <input type="number" name="manual_bet" min="1" placeholder="Ücreti girin (Örn: 500)" class="w-full pl-14 pr-4 py-4 border-2 border-outline-variant/30 rounded-xl outline-none focus:border-primary focus:bg-primary/5 font-headline-sm transition-all text-on-surface" required />
              </div>
            <% } %>
          </section>

          <!-- Oyun Modu -->
          <section>
            <h3 class="font-headline-md text-on-surface mb-4">Oyun Modu</h3>
            <div class="grid grid-cols-2 gap-3">
              <% if (meta.modes && meta.modes.length > 0) { %>
                <% meta.modes.forEach(mode => { %>
                  <label class="cursor-pointer">
                    <input type="radio" name="mode" value="<%= mode.id %>" class="peer hidden" <%= mode.default ? 'checked' : '' %> />
                    <div class="bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl p-4 flex items-center gap-3 peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-all">
                      <span class="material-symbols-outlined text-primary peer-checked:fill-primary"><%= mode.id === 'esli' ? 'group' : 'person' %></span>
                      <span class="font-label-md text-on-surface"><%= mode.label %></span>
                    </div>
                  </label>
                <% }) %>
              <% } else { %>
                <div class="col-span-2 text-outline text-body-sm italic">Oyun modu seçenekleri bulunamadı.</div>
              <% } %>
            </div>
          </section>

          <!-- Oyun Kuralları -->
          <section>
            <h3 class="font-headline-md text-on-surface mb-4">Oyun Kuralları</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <% if (meta.rules && meta.rules.length > 0) { %>
                <% meta.rules.forEach((rule, i) => { %>
                  <% if (rule.type === 'toggle') { %>
                    <label class="cursor-pointer flex items-center justify-between bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl p-4 hover:border-primary/50 transition-all">
                      <span class="font-label-md text-on-surface"><%= rule.label %></span>
                      <div class="relative inline-block w-12 h-6">
                        <input type="checkbox" name="rules[]" value="<%= rule.id %>" class="peer sr-only" <%= rule.default ? 'checked' : '' %> />
                        <div class="w-full h-full bg-outline-variant/50 peer-checked:bg-primary rounded-full transition-colors duration-300"></div>
                        <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform duration-300 peer-checked:translate-x-6 shadow-sm"></div>
                      </div>
                    </label>
                  <% } else if (rule.type === 'radio') { %>
                    <label class="cursor-pointer">
                      <input type="radio" name="rule_<%= rule.group %>" value="<%= rule.id %>" class="peer hidden" <%= rule.default ? 'checked' : '' %> />
                      <div class="bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl p-3 flex items-center justify-between peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-all">
                        <span class="font-label-md text-on-surface"><%= rule.label %></span>
                        <span class="material-symbols-outlined text-primary opacity-0 peer-checked:opacity-100 transition-opacity">check_circle</span>
                      </div>
                    </label>
                  <% } else { %>
                    <label class="cursor-pointer">
                      <input type="checkbox" name="rules[]" value="<%= rule.id %>" class="peer hidden" <%= rule.default ? 'checked' : '' %> />
                      <div class="bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl p-3 flex items-center justify-between peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-all">
                        <span class="font-label-md text-on-surface"><%= rule.label %></span>
                        <span class="material-symbols-outlined text-primary opacity-0 peer-checked:opacity-100 transition-opacity">check_box</span>
                      </div>
                    </label>
                  <% } %>
                <% }) %>
              <% } else { %>
                <div class="col-span-2 text-outline text-body-sm italic p-2">Kurallar tanımlanmamış.</div>
              <% } %>
            </div>
          </section>

          <!-- Koltuk Sayısı (Poker only) -->
          <% if (meta.seatOptions && meta.seatOptions.length > 1) { %>
          <section>
            <h3 class="font-headline-md text-on-surface mb-4">Koltuk Sayısı</h3>
            <div class="grid grid-cols-3 gap-3">
              <% meta.seatOptions.forEach(function(opt) { %>
                <label class="cursor-pointer">
                  <input type="radio" name="seatCount" value="<%= opt.value %>" class="peer hidden" <%= opt.default ? 'checked' : '' %> />
                  <div class="bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl p-4 text-center peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-all">
                    <span class="material-symbols-outlined text-primary text-2xl block mb-1">groups</span>
                    <div class="font-label-md text-on-surface"><%= opt.label %></div>
                  </div>
                </label>
              <% }); %>
            </div>
          </section>
          <% } %>

          <!-- Süre Ayarı -->
          <% if (meta.timerPresets && meta.timerPresets.length > 0) { %>
          <section>
            <h3 class="font-headline-md text-on-surface mb-4">Süre Ayarı</h3>
            <div class="grid grid-cols-3 gap-3">
              <% meta.timerPresets.forEach(function(tp) { %>
                <label class="cursor-pointer">
                  <input type="radio" name="timerPreset" value="<%= tp.id %>" class="peer hidden" <%= tp.default ? 'checked' : '' %> />
                  <div class="bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl p-4 text-center peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-all">
                    <span class="material-symbols-outlined text-primary text-2xl block mb-1"><%= tp.icon %></span>
                    <div class="font-label-md text-on-surface"><%= tp.label %></div>
                    <div class="text-label-sm text-outline"><%= tp.seconds %>sn</div>
                  </div>
                </label>
              <% }); %>
            </div>
          </section>
          <% } %>

          <!-- El Limiti -->
          <% if (meta.handLimits && meta.handLimits.length > 0) { %>
          <section>
            <h3 class="font-headline-md text-on-surface mb-4">El Limiti</h3>
            <div class="flex flex-wrap gap-2">
              <% meta.handLimits.forEach(function(hl) { %>
                <label class="cursor-pointer">
                  <input type="radio" name="handLimit" value="<%= hl.value %>" class="peer hidden" <%= hl.default ? 'checked' : '' %> />
                  <div class="px-5 py-3 bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl text-center peer-checked:border-primary peer-checked:bg-primary/5 hover:border-primary/50 transition-all">
                    <div class="font-label-md text-on-surface"><%= hl.label %></div>
                  </div>
                </label>
              <% }); %>
            </div>
          </section>
          <% } %>

          <!-- Minimum Bakiye -->
          <section>
            <h3 class="font-headline-md text-on-surface mb-4">Minimum Bakiye</h3>
            <div class="relative w-full md:w-2/3">
              <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-xl">account_balance_wallet</span>
              <input type="number" name="minBalance" min="0" placeholder="Opsiyonel (Örn: 1000)" class="w-full pl-12 pr-16 py-3 border-2 border-outline-variant/30 rounded-xl outline-none focus:border-primary focus:bg-primary/5 font-label-md transition-all text-on-surface" />
              <span class="absolute right-4 top-1/2 -translate-y-1/2 text-outline font-label-md">LT</span>
            </div>
            <p class="text-xs text-outline mt-1.5 flex items-center gap-1">
              <span class="material-symbols-outlined text-xs">info</span> Bu bakiyenin altındaki oyuncular masaya oturamaz. Boş bırakırsanız herkes oturabilir.
            </p>
          </section>

          <!-- Oda Gizliliği -->
          <section>
            <h3 class="font-headline-md text-on-surface mb-4">Oda Gizliliği</h3>
            <div class="bg-surface-container-lowest border-2 border-outline-variant/30 rounded-xl p-5 flex flex-col gap-4">
              <div class="grid grid-cols-2 gap-3">
                <label class="cursor-pointer">
                  <input type="radio" name="privacy" value="public" class="peer hidden" checked onchange="document.getElementById('password-wrapper').classList.add('hidden')" />
                  <div class="border-2 border-transparent rounded-lg p-3 text-center peer-checked:border-primary peer-checked:bg-primary/5 transition-all">
                    <span class="material-symbols-outlined mb-1 block text-primary">public</span>
                    <span class="font-label-sm text-on-surface block">Açık Oda</span>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="privacy" value="private" class="peer hidden" onchange="document.getElementById('password-wrapper').classList.remove('hidden')" />
                  <div class="border-2 border-transparent rounded-lg p-3 text-center peer-checked:border-primary peer-checked:bg-primary/5 transition-all">
                    <span class="material-symbols-outlined mb-1 block text-primary">lock</span>
                    <span class="font-label-sm text-on-surface block">Şifreli Oda</span>
                  </div>
                </label>
              </div>
              <div id="password-wrapper" class="hidden space-y-2 mt-2 pt-4 border-t border-outline-variant/30">
                <label class="block font-label-sm text-on-surface-variant">Oda Şifresi</label>
                <div class="relative">
                  <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">key</span>
                  <input type="text" name="password" placeholder="Şifre belirleyin" class="w-full pl-10 pr-4 py-2.5 border border-silver-light rounded-lg outline-none focus:ring-2 focus:ring-primary" />
                </div>
              </div>
            </div>
          </section>

          <!-- Masa Adı (VIP Özel) -->
          <section>
            <h3 class="font-headline-md text-on-surface mb-4">Masa Adı</h3>
            <% if (user.vip_tier > 0) { %>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-energetic-purple text-xl">workspace_premium</span>
                <input type="text" name="title" placeholder="Özel Masa Adı Girin (Örn: Şampiyonlar Masası)" class="w-full pl-11 pr-4 py-3 bg-energetic-purple/5 border-2 border-energetic-purple/40 rounded-xl outline-none focus:border-energetic-purple font-label-md text-on-surface transition-all" />
              </div>
              <p class="text-xs text-energetic-purple font-semibold mt-1.5 flex items-center gap-1">
                <span>👑</span> VIP üye olduğunuz için özel masa adı belirleyebilirsiniz.
              </p>
            <% } else { %>
              <div class="relative opacity-70">
                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-xl">lock</span>
                <input type="text" disabled placeholder="Masa Adı Otomatik Belirlenir (Örn: Masa #1)" class="w-full pl-11 pr-4 py-3 bg-surface-container border border-outline-variant/30 rounded-xl text-outline font-label-md cursor-not-allowed" />
              </div>
              <p class="text-xs text-outline mt-1.5 flex items-center gap-1">
                <span class="material-symbols-outlined text-xs">info</span> Masa adı sıradaki numaraya göre otomatik verilir. Özel isim için VIP üye olun.
              </p>
            <% } %>
          </section>

          <!-- Oluştur Butonu -->
          <button type="button" id="create-confirm-btn" class="w-full py-4 bg-primary text-white rounded-xl font-headline-md text-title-md hover:bg-primary/90 transition-all shadow-md mt-4 flex items-center justify-center gap-2">
            <span class="material-symbols-outlined">play_arrow</span>
            Masayı Oluştur ve Otur
          </button>

        </div> <!-- /Sol Kısım -->

        <!-- Sağ Kısım: Nasıl Oynanır -->
        <div class="hidden lg:flex flex-col w-1/3">
          <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm overflow-hidden sticky top-24">
            <div class="bg-primary text-white p-4 flex items-center gap-2">
              <span class="material-symbols-outlined text-lg">info</span>
              <h3 class="font-headline-sm">Nasıl Oynanır?</h3>
            </div>
            <div class="p-4">
              <% if (meta.howToPlay && meta.howToPlay.length > 0) { %>
                <ul class="space-y-4">
                  <% meta.howToPlay.forEach((step, i) => { %>
                    <li class="flex gap-3 items-start">
                      <span class="w-6 h-6 shrink-0 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-sm"><%= i+1 %></span>
                      <p class="text-body-sm text-on-surface leading-snug pt-0.5"><%= step %></p>
                    </li>
                  <% }) %>
                </ul>
              <% } else { %>
                <p class="text-body-sm text-outline italic">Nasıl oynanır bilgisi bulunamadı.</p>
              <% } %>
            </div>
          </div>
        </div> <!-- /Sağ Kısım -->

      </form>
    </div> <!-- /GÖRÜNÜM: ODA OLUŞTURMA -->
  </main>
  <!-- ===== Lobby Chat Panel ===== -->
  <aside id="lobby-chatpanel" class="fixed bottom-0 left-0 right-0 mx-auto w-full max-w-container-max h-56 bg-surface flex flex-col shadow-[0_-4px_20px_rgba(0,0,0,0.05)] border-t border-x border-outline-variant/30 z-50 rounded-t-xl overflow-hidden">
    <div class="flex border-b border-outline-variant/30 px-2 bg-surface-container-lowest">
      <button id="chat-tab-sistem" class="relative px-4 py-3 font-label-md text-on-surface-variant border-b-2 border-transparent hover:text-primary transition-colors">
        Sistem Mesajı
      </button>
      <button id="chat-tab-lobi" class="relative px-4 py-3 font-label-md text-primary border-b-2 border-primary transition-colors">
        Lobi Mesajı
      </button>
      <button id="chat-tab-masa" class="hidden relative px-4 py-3 font-label-md text-on-surface-variant border-b-2 border-transparent hover:text-primary transition-colors">
        Masa Sohbeti
        <span class="chat-badge hidden absolute top-3 right-1 w-2 h-2 bg-error rounded-full"></span>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto p-3 bg-surface-container-lowest flex flex-col gap-2" id="chat-messages">
      <!-- Mesajlar JS ile buraya eklenecek -->
    </div>
    <!-- Lobi Chat Form -->
    <form id="chat-form" class="border-t border-outline-variant/30 p-2 flex gap-2 bg-surface">
      <input type="text" id="chat-input" class="flex-1 bg-surface-container-lowest border border-outline-variant/50 rounded-lg px-4 py-2 font-body-sm text-on-surface focus:outline-none focus:border-primary transition-colors" placeholder="Bir lobi mesajı yazın..." autocomplete="off">
      <button type="submit" class="bg-primary text-on-primary px-4 py-2 rounded-lg font-label-md hover:bg-primary/90 transition-colors">Gönder</button>
    </form>
    <!-- Masa Chat Form -->
    <form id="chat-form-masa" class="hidden border-t border-outline-variant/30 p-2 flex gap-2 bg-surface">
      <input type="text" id="chat-input-masa" class="flex-1 bg-surface-container-lowest border border-outline-variant/50 rounded-lg px-4 py-2 font-body-sm text-on-surface focus:outline-none focus:border-primary transition-colors" placeholder="Masa sohbetine yazın..." autocomplete="off">
      <button type="submit" class="bg-primary text-on-primary px-4 py-2 rounded-lg font-label-md hover:bg-primary/90 transition-colors">Gönder</button>
    </form>
  </aside>


  <script>window.LOBBY_GAME_ID = 'salon_' + '<%= meta.slug %>';</script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/lobby.js"></script>
  <% if (meta.slug) { %>
    <script src="/js/<%= meta.slug %>.js"></script>
  <% } %>
  
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (!window.lobbySocket) return;
      
      var gameId = window.LOBBY_GAME_ID || 'lobby';
      var socket = window.lobbySocket;
      
      var chatMessages = document.getElementById('chat-messages');
      var chatForm = document.getElementById('chat-form');
      var chatInput = document.getElementById('chat-input');
      var tabSistem = document.getElementById('chat-tab-sistem');
      var tabLobi = document.getElementById('chat-tab-lobi');
      var tabMasa = document.getElementById('chat-tab-masa');
      
      var currentTab = 'lobi'; // 'lobi' or 'sistem'
      
      var messagesByTab = {
        sistem: [],
        lobi: [],
        masa: []
      };
      
      function formatTime(isoLike) {
        try {
          var d = new Date(String(isoLike).replace(' ', 'T') + 'Z');
          if (isNaN(d.getTime())) return '';
          return d.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
        } catch (e) { return ''; }
      }
      
      function escapeHtml(str) {
        var div = document.createElement('div');
        div.textContent = str == null ? '' : String(str);
        return div.innerHTML;
      }
      
      function renderMessages() {
        if (!chatMessages) return;
        var msgs = messagesByTab[currentTab];
        chatMessages.innerHTML = msgs.map(function(m) {
          if (currentTab === 'sistem') {
            return '<div class="text-on-surface-variant italic text-body-sm bg-surface-container rounded p-2 border border-outline-variant/30">' + escapeHtml(m.content) + '</div>';
          } else {
            return '<div class="flex flex-col mb-1">' +
                     '<div class="flex items-center justify-between">' +
                       '<span class="font-label-sm text-primary">' + escapeHtml(m.username) + '</span>' +
                       '<span class="text-[10px] text-outline">' + formatTime(m.created_at) + '</span>' +
                     '</div>' +
                     '<div class="text-body-sm text-on-surface">' + escapeHtml(m.content) + '</div>' +
                   '</div>';
          }
        }).join('');
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }
      
      function switchTab(tab) {
        currentTab = tab;
        if (tab === 'sistem') {
          tabSistem.classList.add('text-primary', 'border-primary');
          tabSistem.classList.remove('text-on-surface-variant', 'border-transparent');
          tabLobi.classList.remove('text-primary', 'border-primary');
          tabLobi.classList.add('text-on-surface-variant', 'border-transparent');
          if (tabMasa) {
              tabMasa.classList.remove('text-primary', 'border-primary');
              tabMasa.classList.add('text-on-surface-variant', 'border-transparent');
          }
          chatInput.disabled = true;
          chatInput.placeholder = 'Sistem kanalına yazılamaz...';
        } else if (tab === 'masa') {
          if (tabMasa) {
              tabMasa.classList.add('text-primary', 'border-primary');
              tabMasa.classList.remove('text-on-surface-variant', 'border-transparent');
          }
          tabLobi.classList.remove('text-primary', 'border-primary');
          tabLobi.classList.add('text-on-surface-variant', 'border-transparent');
          tabSistem.classList.remove('text-primary', 'border-primary');
          tabSistem.classList.add('text-on-surface-variant', 'border-transparent');
          chatInput.disabled = false;
          chatInput.placeholder = 'Masaya yaz...';
        } else {
          tabLobi.classList.add('text-primary', 'border-primary');
          tabLobi.classList.remove('text-on-surface-variant', 'border-transparent');
          tabSistem.classList.remove('text-primary', 'border-primary');
          tabSistem.classList.add('text-on-surface-variant', 'border-transparent');
          if (tabMasa) {
              tabMasa.classList.remove('text-primary', 'border-primary');
              tabMasa.classList.add('text-on-surface-variant', 'border-transparent');
          }
          chatInput.disabled = false;
          chatInput.placeholder = 'Lobiye yaz...';
        }
        var chatBadge = document.querySelector('#chat-tab-' + tab + ' .chat-badge');
        if (chatBadge) chatBadge.classList.add('hidden');
        renderMessages();
      }
      
      window.addEventListener('switch-chat-tab', function(e) {
          switchTab(e.detail);
      });
      
      tabSistem.addEventListener('click', function() { switchTab('sistem'); });
      tabLobi.addEventListener('click', function() { switchTab('lobi'); });
      if (tabMasa) tabMasa.addEventListener('click', function() { switchTab('masa'); });
      
      socket.on('chat:history', function(history) {
        // history[gameId] has messages for this game
        if (history && history[gameId]) {
          messagesByTab.lobi = history[gameId];
        }
        if (history && history.sistem) {
          messagesByTab.sistem = history.sistem;
        }
        renderMessages();
      });
      
      socket.on('chat:message', function(msg) {
        if (!msg) return;
        var tab = msg.channel === 'sistem' ? 'sistem' : 'lobi';
        
        // Ensure we only accept messages for our channel (gameId) or sistem
        if (msg.channel !== 'sistem' && msg.channel !== gameId) return;
        
        messagesByTab[tab].push(msg);
        if (messagesByTab[tab].length > 200) messagesByTab[tab].shift();
        
        if (currentTab === tab) {
          renderMessages();
        } else {
          var badge = document.querySelector('#chat-tab-' + tab + ' .chat-badge');
          if (badge) badge.classList.remove('hidden');
        }
      });
      
      // Dinamik olarak masa mesajı eklendiğinde çağrılabilir
      window.addEventListener('room:chat-received', function(e) {
        var msg = e.detail;
        messagesByTab.masa.push(msg);
        if (messagesByTab.masa.length > 200) messagesByTab.masa.shift();
        
        if (currentTab === 'masa') {
          renderMessages();
        } else {
          var badge = document.querySelector('#chat-tab-masa .chat-badge');
          if (badge) badge.classList.remove('hidden');
        }
      });
      
      if (chatForm) {
        chatForm.addEventListener('submit', function(e) {
          e.preventDefault();
          var text = chatInput.value.trim();
          if (!text || currentTab === 'sistem') return;
          
          if (currentTab === 'masa') {
            window.dispatchEvent(new CustomEvent('send-room-chat', { detail: text }));
          } else {
            socket.emit('chat:message', { channel: gameId, text: text });
          }
          chatInput.value = '';
        });
      }

      // ---- User-Created Rooms Renderer ----
      var tableListContainer = document.getElementById('table-list-container');
      
      function renderRoomsList(rooms) {
        if (!tableListContainer) return;
        if (!rooms || !rooms.length) {
          tableListContainer.innerHTML = 
            '<div class="col-span-full bg-surface-container-low rounded-2xl border-2 border-dashed border-outline-variant/50 p-10 flex flex-col items-center justify-center text-center gap-3">' +
              '<span class="material-symbols-outlined text-5xl text-primary/60">meeting_room</span>' +
              '<h3 class="font-headline-sm text-on-surface">Şu An Açık Masa Bulunmuyor</h3>' +
              '<p class="text-body-sm text-outline max-w-sm">Dilediğiniz bahis ve kurallar ile yeni bir masa oluşturarak hemen oyuna başlayabilirsiniz.</p>' +
              '<button type="button" onclick="openCreateModal()" class="mt-2 px-6 py-3 bg-primary text-white rounded-xl font-label-md hover:bg-primary/90 transition-all shadow-md flex items-center gap-2 cursor-pointer">' +
                '<span class="material-symbols-outlined text-sm">add_circle</span> Masa Oluştur' +
              '</button>' +
            '</div>';
          return;
        }

        tableListContainer.innerHTML = rooms.map(function(room) {
          var isFull = room.seatedCount >= (room.seatCount || 4);
          var stake = Number(room.stake || 500).toLocaleString('tr-TR') + ' LT';

          var avatarsHtml = room.seats.map(function(s) {
            if (!s) {
              return '<span class="w-9 h-9 rounded-full border-2 border-dashed border-outline-variant/60 flex items-center justify-center text-xs text-outline font-semibold">Boş</span>';
            }
            var initial = escapeHtml((s.name || '?').charAt(0).toUpperCase());
            return '<span class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm shadow-sm" title="' + escapeHtml(s.name) + '">' + initial + '</span>';
          }).join('');

          var isPlaying = room.stage === 'playing';
          var statusText = isPlaying ? 'Oynanıyor' : (isFull ? 'Dolu (4/4)' : room.seatedCount + '/' + (room.seatCount || 4) + ' Oyuncu');
          var statusColor = isPlaying ? 'text-amber-600 font-bold' : (isFull ? 'text-error font-bold' : 'text-primary font-bold');

          var isPrivate = room.privacy === 'private';
          var titleIcon = isPrivate ? '<span class="material-symbols-outlined text-amber-500 text-base" title="Şifreli Masa">lock</span>' : '<span class="material-symbols-outlined text-primary text-base">table_restaurant</span>';
          
          var canSit = !isFull && !isPlaying;
          var btnLabel = isPlaying ? 'İzle' : (isFull ? 'İzle' : 'Otur');
          var actionBtnHtml = isPrivate 
            ? '<button type="button" onclick="openJoinPasswordModal(\'' + escapeHtml(room.id) + '\')" class="px-5 py-2 bg-amber-600 text-white rounded-xl font-label-md text-label-sm hover:bg-amber-700 transition-all shadow-md flex items-center gap-1.5 cursor-pointer">' +
                '<span class="material-symbols-outlined text-sm">lock</span> ' + btnLabel +
              '</button>'
            : '<button type="button" onclick="window.showGame(\'' + escapeHtml(room.id) + '\', \'<%= meta.slug %>\')" class="px-5 py-2 bg-primary text-white rounded-xl font-label-md text-label-sm hover:bg-primary/90 transition-all shadow-md flex items-center gap-1.5 cursor-pointer">' +
                '<span class="material-symbols-outlined text-sm">login</span> ' + btnLabel +
              '</button>';

          var badgesHtml = '<div class="flex gap-1.5 flex-wrap mt-2">';
          if (room.gameMode) {
             var modeLabel = room.gameMode === 'esli' ? 'Eşli' : (room.gameMode === 'solo' || room.gameMode === 'tekli' ? 'Tekli' : room.gameMode);
             var modeIcon = (modeLabel === 'Eşli' || modeLabel === 'esli') ? 'group' : 'person';
             badgesHtml += '<span class="px-2 py-0.5 bg-surface-variant text-on-surface-variant rounded-md text-[10px] font-bold tracking-wider flex items-center gap-1"><span class="material-symbols-outlined text-[12px]">' + modeIcon + '</span> ' + escapeHtml(modeLabel) + '</span>';
          }
          if (room.gameType) {
             var typeLabel = room.gameType === 'katlamali' ? 'Katlamalı' : (room.gameType === 'katlamasiz' ? 'Katlamasız' : room.gameType);
             badgesHtml += '<span class="px-2 py-0.5 bg-surface-variant text-on-surface-variant rounded-md text-[10px] font-bold tracking-wider">' + escapeHtml(typeLabel) + '</span>';
          }
          // Timer preset badge
          var timerIcons = { normal: 'timer', hizli: 'speed', cokhizli: 'bolt' };
          var timerLabels = { normal: 'Normal', hizli: 'Hızlı', cokhizli: 'Çok Hızlı' };
          var timerIcon = timerIcons[room.timerPreset] || 'timer';
          var timerLabel = timerLabels[room.timerPreset] || 'Normal';
          badgesHtml += '<span class="px-2 py-0.5 bg-surface-variant text-on-surface-variant rounded-md text-[10px] font-bold tracking-wider flex items-center gap-1"><span class="material-symbols-outlined text-[12px]">' + timerIcon + '</span> ' + timerLabel + '</span>';
          // Hand limit badge
          if (room.handLimit && room.handLimit > 0) {
            badgesHtml += '<span class="px-2 py-0.5 bg-surface-variant text-on-surface-variant rounded-md text-[10px] font-bold tracking-wider">' + room.handLimit + ' El</span>';
          }
          // Min balance badge
          if (room.minBalance && room.minBalance > 0) {
            badgesHtml += '<span class="px-2 py-0.5 bg-amber-500/10 text-amber-700 rounded-md text-[10px] font-bold tracking-wider flex items-center gap-1"><span class="material-symbols-outlined text-[12px]">account_balance_wallet</span> Min ' + Number(room.minBalance).toLocaleString('tr-TR') + '</span>';
          }
          // Spectator count badge
          if (room.spectatorCount > 0) {
            badgesHtml += '<span class="px-2 py-0.5 bg-blue-500/10 text-blue-700 rounded-md text-[10px] font-bold flex items-center gap-1"><span class="material-symbols-outlined text-[12px]">visibility</span> ' + room.spectatorCount + ' İzleyici</span>';
          }
          badgesHtml += '</div>';

          // Hand progress
          var handProgressHtml = (room.handLimit && room.handLimit > 0)
            ? '<span class="text-[10px] text-outline">El ' + (room.currentHand || 0) + '/' + room.handLimit + '</span>'
            : '';

          // Spectate button
          var spectateBtn = (isPlaying || isFull)
            ? '<button type="button" onclick="window.showGame(\'' + escapeHtml(room.id) + '\', \'' + escapeHtml(room.game || '<%= meta.slug %>') + '\')" class="p-2 bg-surface-container text-on-surface-variant rounded-lg hover:bg-primary/10 transition-all cursor-pointer" title="Seyret"><span class="material-symbols-outlined text-sm">visibility</span></button>'
            : '';

          return (
            '<div class="bg-white rounded-2xl border border-outline-variant/30 shadow-md p-5 flex flex-col gap-4 hover:shadow-lg transition-all">' +
              '<div class="flex items-center justify-between">' +
                '<div>' +
                  '<span class="font-headline-md text-primary font-bold text-lg flex items-center gap-2">' + titleIcon + ' ' + escapeHtml(room.title) + '</span>' +
                  badgesHtml +
                '</div>' +
                '<span class="px-3 py-1 bg-amber-500/15 text-amber-700 rounded-full font-label-md text-xs font-extrabold shrink-0">' + stake + '</span>' +
              '</div>' +
              '<div class="flex gap-2 items-center py-2">' + avatarsHtml + '</div>' +
              '<div class="flex items-center justify-between pt-3 border-t border-outline-variant/20">' +
                '<div class="flex items-center gap-2"><span class="text-label-sm ' + statusColor + '">' + statusText + '</span>' + handProgressHtml + '</div>' +
                '<div class="flex items-center gap-2">' + spectateBtn + actionBtnHtml + '</div>' +
              '</div>' +
            '</div>'
          );
        }).join('');
      }

      var allRooms = [];

      function applyFilters() {
        var search = (document.getElementById('filter-search').value || '').toLowerCase().trim();
        var stakeFilter = document.querySelector('.filter-stake-btn.bg-primary');
        stakeFilter = stakeFilter ? stakeFilter.dataset.stake : 'all';
        var modeFilter = document.getElementById('filter-mode').value;
        var availableOnly = document.getElementById('filter-available').checked;
        var sort = document.getElementById('filter-sort').value;

        var filtered = allRooms.filter(function(room) {
          if (search && !(room.title || '').toLowerCase().includes(search) && !(room.creatorName || '').toLowerCase().includes(search)) return false;
          if (stakeFilter !== 'all') {
            var maxStake = Number(stakeFilter);
            if (stakeFilter === '50000') { if (room.stake <= 10000) return false; }
            else { if (room.stake > maxStake) return false; }
          }
          if (modeFilter !== 'all' && room.gameMode !== modeFilter) return false;
          if (availableOnly && room.seatedCount >= (room.seatCount || 4)) return false;
          return true;
        });

        if (sort === 'stake-asc') filtered.sort(function(a, b) { return a.stake - b.stake; });
        else if (sort === 'stake-desc') filtered.sort(function(a, b) { return b.stake - a.stake; });
        else if (sort === 'seats-desc') filtered.sort(function(a, b) { return ((b.seatCount || 4) - b.seatedCount) - ((a.seatCount || 4) - a.seatedCount); });

        renderRoomsList(filtered);
      }

      socket.on('rooms:list', function(rooms) {
        allRooms = rooms || [];
        applyFilters();

        // 3D: Live Lobby Stats
        var totalPlayers = allRooms.reduce(function(sum, r) { return sum + (r.seatedCount || 0); }, 0);
        var totalSpectators = allRooms.reduce(function(sum, r) { return sum + (r.spectatorCount || 0); }, 0);
        var lobbyCountEl = document.getElementById('lobby-online-count');
        if (lobbyCountEl) {
           // Set to total players + spectators + people in lobby (we can't know people just in lobby easily here, 
           // but the user prompt says to set it to totalPlayers + totalSpectators, or maybe it meant another element).
           // Let's just update lobbyCountEl if the specific ones aren't found.
           // Actually, let's look for online-count and active-tables-count just in case they were added dynamically.
           var onlineCountEl = document.getElementById('online-count');
           if (onlineCountEl) onlineCountEl.textContent = totalPlayers + totalSpectators;
           var activeTablesCountEl = document.getElementById('active-tables-count');
           if (activeTablesCountEl) activeTablesCountEl.textContent = allRooms.length;
        }
      });

      document.getElementById('filter-search').addEventListener('input', applyFilters);
      document.getElementById('filter-mode').addEventListener('change', applyFilters);
      document.getElementById('filter-available').addEventListener('change', applyFilters);
      document.getElementById('filter-sort').addEventListener('change', applyFilters);

      document.querySelectorAll('.filter-stake-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          document.querySelectorAll('.filter-stake-btn').forEach(function(b) {
            b.classList.remove('bg-primary', 'text-white');
            b.classList.add('bg-surface-container', 'text-on-surface-variant');
          });
          btn.classList.remove('bg-surface-container', 'text-on-surface-variant');
          btn.classList.add('bg-primary', 'text-white');
          applyFilters();
        });
      });
      socket.emit('rooms:get', '<%= meta.slug %>');
    });
  </script>

  <!-- ===== Şifreli Masa Giriş Modalı ===== -->
  <div id="join-password-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl border border-outline-variant/30 shadow-2xl max-w-sm w-full p-6 flex flex-col gap-4">
      <div class="flex items-center justify-between border-b border-outline-variant/20 pb-3">
        <h3 class="font-headline-sm text-primary flex items-center gap-2 font-bold">
          <span class="material-symbols-outlined text-amber-500">lock</span> Şifreli Masa Girişi
        </h3>
        <button type="button" onclick="closeJoinPasswordModal()" class="text-outline hover:text-on-surface cursor-pointer">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <p class="text-body-sm text-outline">Bu masa şifrelidir. Masaya oturmak için oda şifresini girin:</p>
      <input type="hidden" id="pass-modal-room-id" />
      <div class="relative">
        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline">key</span>
        <input type="password" id="pass-modal-input" placeholder="Oda Şifresi" class="w-full pl-11 pr-4 py-3 border border-outline-variant/40 rounded-xl outline-none focus:border-primary font-label-md" />
      </div>
      <div id="pass-modal-error" class="hidden text-error text-xs font-bold bg-error/10 p-2.5 rounded-lg border border-error/20"></div>
      <div class="flex gap-3 justify-end mt-2">
        <button type="button" onclick="closeJoinPasswordModal()" class="px-4 py-2.5 bg-surface-container text-on-surface-variant rounded-xl font-label-md hover:bg-surface-container-high cursor-pointer">İptal</button>
        <button type="button" id="pass-modal-submit" class="px-5 py-2.5 bg-primary text-white rounded-xl font-label-md hover:bg-primary/90 flex items-center gap-1.5 shadow-md cursor-pointer">
          <span class="material-symbols-outlined text-sm">login</span> Giriş Yap
        </button>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Fetch Leaderboard
      fetch('/api/leaderboard/<%= meta.slug %>')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var list = document.getElementById('leaderboard-list');
          if (!list) return;
          if (!data.leaderboard || !data.leaderboard.length) {
            list.innerHTML = '<div class="text-center text-outline text-xs py-2">Henüz veri yok</div>';
            return;
          }
          list.innerHTML = data.leaderboard.slice(0, 5).map(function(p, i) {
            var medal = i === 0 ? '🥇' : (i === 1 ? '🥈' : (i === 2 ? '🥉' : (i + 1) + '.'));
            return '<div class="flex items-center gap-2 p-1.5 rounded bg-surface-variant/20 mb-1">' +
              '<span class="text-sm w-6 text-center">' + medal + '</span>' +
              '<div class="flex-1 overflow-hidden"><div class="font-label-sm text-on-surface truncate">' + escapeHtml(p.rumuz) + '</div>' +
              '<div class="text-[9px] text-outline">' + p.kazanilan_oyun + ' galibiyet</div></div>' +
              '<span class="text-[10px] text-primary font-bold">' + Number(p.toplam_kazanc).toLocaleString('tr-TR') + '</span>' +
            '</div>';
          }).join('');
        }).catch(function(e) { console.error('Leaderboard error:', e); });

      // Fetch Recent Games
      fetch('/api/my/recent-games')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var list = document.getElementById('recent-games-list');
          if (!list) return;
          if (!data.games || !data.games.length) {
            list.innerHTML = '<div class="text-center text-outline text-xs py-2">Oyun geçmişi yok</div>';
            return;
          }
          list.innerHTML = data.games.map(function(g) {
            var isWin = Number(g.kazanc) > 0;
            var winColor = isWin ? 'text-primary' : 'text-error';
            return '<div class="flex flex-col gap-0.5 p-1.5 rounded bg-surface-variant/20 mb-1 text-[10px]">' +
              '<div class="flex justify-between text-on-surface font-bold"><span>' + escapeHtml(g.game_slug) + '</span><span class="' + winColor + '">' + Number(g.kazanc || 0).toLocaleString('tr-TR') + '</span></div>' +
              '<div class="text-outline">' + new Date(g.created_at).toLocaleString('tr-TR') + '</div>' +
            '</div>';
          }).join('');
        }).catch(function(e) { console.error('Recent games error:', e); });
        
      function escapeHtml(str) {
        var div = document.createElement('div');
        div.textContent = str == null ? '' : String(str);
        return div.innerHTML;
      }
    });
  </script>

  <script>
    (function () {
      var tablesView = document.getElementById('tables-view');
      var createView = document.getElementById('create-room-view');
      
      function openCreate() { 
        tablesView.hidden = true; 
        createView.hidden = false; 
        createView.scrollIntoView({ behavior: 'smooth', block: 'start' }); 
      }
      
      function closeCreate() { 
        createView.hidden = true; 
        tablesView.hidden = false; 
      }
      
      window.openCreateModal = openCreate;

      document.getElementById('create-table-btn').addEventListener('click', openCreate);
      var btn2 = document.getElementById('create-table-btn-2');
      if (btn2) btn2.addEventListener('click', openCreate);
      document.getElementById('create-cancel').addEventListener('click', closeCreate);
      
      window.openJoinPasswordModal = function (roomId) {
        document.getElementById('pass-modal-room-id').value = roomId;
        document.getElementById('pass-modal-input').value = '';
        document.getElementById('pass-modal-error').classList.add('hidden');
        document.getElementById('join-password-modal').classList.remove('hidden');
      };

      window.closeJoinPasswordModal = function () {
        document.getElementById('join-password-modal').classList.add('hidden');
      };

      var passSubmitBtn = document.getElementById('pass-modal-submit');
      if (passSubmitBtn) {
        passSubmitBtn.addEventListener('click', async function () {
          var roomId = document.getElementById('pass-modal-room-id').value;
          var password = document.getElementById('pass-modal-input').value;
          var errEl = document.getElementById('pass-modal-error');
          errEl.classList.add('hidden');
          if (!password) {
            errEl.textContent = 'Lütfen masa şifresini girin!';
            errEl.classList.remove('hidden');
            return;
          }
          try {
            passSubmitBtn.disabled = true;
            var res = await fetch('/api/rooms/verify-password', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ roomId: roomId, password: password })
            });
            var data = await res.json();
            if (data.ok && data.playUrl) {
              window.showGame(data.roomId || data.playUrl.split('roomId=')[1].split('&')[0], '<%= meta.slug %>');
            } else {
              errEl.textContent = data.error || 'Girdiğiniz şifre hatalı!';
              errEl.classList.remove('hidden');
              passSubmitBtn.disabled = false;
            }
          } catch (err) {
            errEl.textContent = 'Sunucu bağlantı hatası!';
            errEl.classList.remove('hidden');
            passSubmitBtn.disabled = false;
          }
        });
      }

      var confirmBtn = document.getElementById('create-confirm-btn');
      if (confirmBtn) {
        confirmBtn.addEventListener('click', async function (e) {
          e.preventDefault();
          var form = document.getElementById('create-room-form');
          var formData = new FormData(form);
          var selectedBet = formData.get('bet') || formData.get('manual_bet') || 500;
          var selectedMode = formData.get('mode') || 'solo';
          var selectedPrivacy = formData.get('privacy') || 'public';
          var selectedPassword = formData.get('password') || '';
          var selectedTitle = formData.get('title') || '';
          var selectedRules = formData.getAll('rules[]');

          try {
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<span class="material-symbols-outlined animate-spin">progress_activity</span> Masa Oluşturuluyor...';

            var response = await fetch('/api/rooms/create', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                game: '<%= meta.slug %>',
                bet: selectedBet,
                mode: selectedMode,
                privacy: selectedPrivacy,
                password: selectedPassword,
                title: selectedTitle,
                rules: selectedRules,
                seatCount: formData.get('seatCount') || '',
                timerPreset: formData.get('timerPreset') || 'normal',
                handLimit: formData.get('handLimit') || '0',
                minBalance: formData.get('minBalance') || ''
              })
            });
            var data = await response.json();
            if (data.ok && data.roomId) {
              window.showGame(data.roomId, '<%= meta.slug %>');
            } else {
              alert(data.error || 'Masa oluşturulurken bir hata oluştu.');
              confirmBtn.disabled = false;
              confirmBtn.innerHTML = '<span class="material-symbols-outlined">play_arrow</span> Masayı Oluştur ve Otur';
            }
          } catch (err) {
            console.error('Masa oluşturma hatası:', err);
            alert('Sunucu hatası. Lütfen tekrar deneyin.');
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = '<span class="material-symbols-outlined">play_arrow</span> Masayı Oluştur ve Otur';
          }
        });
      }

      // SPA Navigation functions
      window.showGame = function(roomId, gameSlug) {
         // --- OYUN GÖRÜNÜMÜNE GEÇİŞ ---
         // Scroll'a izin ver ve chat panelinin üstüne çıkmaması için alttan boşluk bırak
         document.body.classList.remove('overflow-hidden', 'h-screen');
         
         const main = document.querySelector('main');
         if (main) {
             main.classList.add('flex', 'flex-col');
             main.classList.remove('overflow-hidden', 'h-full', 'pb-4');
             // Alt chat paneli için paddingi koruyalım ki oyunun altı kesilmesin
             main.classList.add('py-8', 'pb-[220px]');
         }
         
         const anaSayfaLink = document.getElementById('ana-sayfa-link');
         if (anaSayfaLink) anaSayfaLink.classList.add('hidden');
         
         const hero = document.querySelector('section.relative.bg-primary');
         if (hero) hero.classList.add('hidden'); // Başlığı gizle, yer açılsın
         
         document.getElementById('create-room-view').hidden = true;
         
         const filterBar = document.getElementById('filter-bar');
         if (filterBar) filterBar.classList.add('hidden');
         
         const sidebar = document.getElementById('sidebar-section');
         if (sidebar) sidebar.classList.add('hidden');
         
         const tableList = document.getElementById('table-list-container');
         if (tableList) tableList.classList.add('hidden');
         
         // tables-view ayarları
         const tablesView = document.getElementById('tables-view');
         tablesView.classList.add('flex-1', 'overflow-hidden');
         
         const tablesViewLeft = tablesView.querySelector('.flex-1');
         tablesViewLeft.classList.add('flex', 'flex-col', 'h-full', 'overflow-hidden');
         
         // game-container ayarları
         const gc = document.getElementById('game-container');
         gc.classList.remove('hidden', 'min-h-[600px]');
         gc.classList.add('flex-1', 'flex', 'items-center', 'justify-center', 'overflow-hidden');

         // Update tabs UI
         const tabLobi = document.getElementById('spa-tab-lobi');
         if (tabLobi) {
             tabLobi.classList.remove('text-headline-lg', 'text-primary', 'border-primary');
             tabLobi.classList.add('text-headline-md', 'text-on-surface-variant', 'border-transparent', 'hover:text-primary', 'hover:border-primary');
         }
         
         const tabMasa = document.getElementById('spa-tab-masa');
         if (tabMasa) {
             tabMasa.classList.remove('hidden', 'text-headline-md', 'text-on-surface-variant', 'border-transparent', 'hover:text-primary', 'hover:border-primary');
             tabMasa.classList.add('text-headline-lg', 'text-primary', 'border-primary', 'flex');
             
             const masaTitle = document.getElementById('active-masa-id');
             if (masaTitle && roomId) masaTitle.textContent = '#' + roomId.split('_').pop();
         }

         const createBtn = document.getElementById('create-table-btn');
         if (createBtn) createBtn.classList.add('hidden');

         // Show Masa Sohbeti tab
         const chatTabMasa = document.getElementById('chat-tab-masa');
         if (chatTabMasa) {
           chatTabMasa.classList.remove('hidden');
           window.dispatchEvent(new CustomEvent('switch-chat-tab', {detail: ('masa')}));
         }

         // Emit dynamic join
         if (window.lobbySocket && roomId) {
             window.lobbySocket.emit('game:join', { game: gameSlug || '<%= meta.slug %>', roomId: roomId });
         }
         
         // Trigger resize
         setTimeout(resizeGameContainer, 100);
      };

      window.leaveTable = function(event) {
         if (event) {
             event.stopPropagation();
         }
         
         // Emit leave event to the game socket if available
         if (window.okey101Socket && typeof window.okey101Socket.emit === 'function') {
             window.okey101Socket.emit('okey101:leave_table');
         }
         
         // Hide Masa tab
         const tabMasa = document.getElementById('spa-tab-masa');
         if (tabMasa) {
             tabMasa.classList.add('hidden');
         }
         
         // Show Lobby
         if (typeof window.showLobby === 'function') {
             window.showLobby();
         }
      };
      
      window.showLobby = function() {
         // --- LOBİ GÖRÜNÜMÜNE DÖNÜŞ ---
         document.body.classList.remove('overflow-hidden', 'h-screen');
         
         const main = document.querySelector('main');
         if (main) {
             main.classList.remove('flex', 'flex-col', 'overflow-hidden');
             main.classList.add('py-8', 'pb-[220px]');
         }
         
         const anaSayfaLink = document.getElementById('ana-sayfa-link');
         if (anaSayfaLink) anaSayfaLink.classList.remove('hidden');
         
         const hero = document.querySelector('section.relative.bg-primary');
         if (hero) hero.classList.remove('hidden');
         
         document.getElementById('create-room-view').hidden = true;
         
         const filterBar = document.getElementById('filter-bar');
         if (filterBar) filterBar.classList.remove('hidden');
         
         const sidebar = document.getElementById('sidebar-section');
         if (sidebar) sidebar.classList.remove('hidden');
         
         const tableList = document.getElementById('table-list-container');
         if (tableList) tableList.classList.remove('hidden');
         
         const tablesView = document.getElementById('tables-view');
         tablesView.classList.remove('flex-1', 'overflow-hidden');
         
         const tablesViewLeft = tablesView.querySelector('.flex-1');
         tablesViewLeft.classList.remove('flex', 'flex-col', 'h-full', 'overflow-hidden');
         
         const gc = document.getElementById('game-container');
         gc.classList.add('hidden', 'min-h-[600px]');
         gc.classList.remove('flex-1', 'flex', 'items-center', 'justify-center', 'overflow-hidden');

         // Update tabs UI
         const tabLobi = document.getElementById('spa-tab-lobi');
         if (tabLobi) {
             tabLobi.classList.remove('text-headline-md', 'text-on-surface-variant', 'border-transparent', 'hover:text-primary', 'hover:border-primary');
             tabLobi.classList.add('text-headline-lg', 'text-primary', 'border-primary');
         }
         
         const tabMasa = document.getElementById('spa-tab-masa');
         if (tabMasa) {
             tabMasa.classList.remove('text-headline-lg', 'text-primary', 'border-primary');
             tabMasa.classList.add('text-headline-md', 'text-on-surface-variant', 'border-transparent', 'hover:text-primary', 'hover:border-primary');
         }

         const createBtn = document.getElementById('create-table-btn');
         if (createBtn) createBtn.classList.remove('hidden');
         
         const chatTabMasa = document.getElementById('chat-tab-masa');
         if (chatTabMasa) chatTabMasa.classList.add('hidden');
         window.dispatchEvent(new CustomEvent('switch-chat-tab', {detail: ('lobi')}));
      };

      // Auto-scale Okey101 game board to perfectly fill the container
      function resizeGameContainer() {
        const gc = document.getElementById('game-container');
        const gameScaler = document.querySelector('.game-scaler');
        const okey101 = document.querySelector('.okey101');
        
        if (gc && gameScaler && okey101 && !gc.classList.contains('hidden')) {
           const availableWidth = gc.clientWidth;
           let availableHeight = gc.clientHeight;
           
           // If scrolling is allowed, clientHeight might collapse or not account for full screen properly.
           // We ensure it takes a good chunk of the viewport minus the chat panel.
           if (availableHeight < 500) {
               availableHeight = Math.max(500, window.innerHeight - 320); 
           }
           
           const originalWidth = 1100;
           const originalHeight = 750;
           
           let scaleW = availableWidth / originalWidth;
           let scaleH = availableHeight / originalHeight;
           
           // Orantıyı bozmadan sığması için en küçük ölçeği seç
           let scale = Math.min(scaleW, scaleH);
           
           if (scale > 1.35) scale = 1.35;
           
           gameScaler.style.transform = 'scale(' + scale + ')';
           gameScaler.style.transformOrigin = 'center center';
           
           gameScaler.style.width = originalWidth + 'px';
           gameScaler.style.height = originalHeight + 'px';
           
           okey101.style.width = '100%';
           okey101.style.height = '100%';
           okey101.style.setProperty('--scale', scale);
           
           const game = okey101.querySelector('.game');
           if (game) {
               game.style.width = '100%';
               game.style.height = '100%';
           }
        }
      }
      
      window.addEventListener('resize', resizeGameContainer);
      
      window.addEventListener('resize', resizeGameContainer);
      // Trigger resize after a small delay when game starts
      const originalShowGame = window.showGame;
      window.showGame = function(roomId, gameSlug) {
        originalShowGame(roomId, gameSlug);
        setTimeout(resizeGameContainer, 10);
      };

    })();
  </script>
</body>
</html>
